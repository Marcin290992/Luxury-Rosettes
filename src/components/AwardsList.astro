---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AWARDS_LIST as S } from '../scripts/settings';

/**
 * The list of the awards, one at a time (see scripts/awards-list.ts): a pinned screen. It begins with the photo that the spiral before it
 * has grown to the whole screen (the same picture: the hand-over shows no seam); that photo settles into a large frame, a huge counter
 * stands at the left with the words of the award, and the names of the awards stand in a list at the right. Then every next award is one
 * large photo that is opened over the last one from the bottom edge (a mask), while the counter, the words and the list move on.
 * Without the script, with reduced motion, it is a grid of the photos and the awards written out one under the other.
 */
interface Props {
  items: { img: ImageMetadata; alt: string; title: string; meta: string; text: string }[];
}
const { items } = Astro.props;
const total = String(items.length).padStart(2, '0');
---

<section class="al" aria-label="The awards" style={`--al-length:${S.length}`}>
  <div class="al-pin">
    <p class="al-index" aria-hidden="true"><span class="al-mask"><span class="al-roll"><span class="al-num">01</span><span class="al-total">/{total}</span></span></span></p>

    <div class="al-slot" aria-hidden="true"></div>
    <div class="al-images">
      {
        items.map((item, i) => (
          <figure class="al-img">
            {i === 0 ? (
              <Image src={item.img} alt={item.alt} widths={[1000, 1400, 2000]} sizes="(min-width: 1000px) 100vw, 100vw" loading="eager" draggable="false" />
            ) : (
              <Image src={item.img} alt={item.alt} widths={[600, 1000, 1400]} sizes="(min-width: 1000px) 46vw, 90vw" loading={i < 3 ? 'eager' : 'lazy'} draggable="false" />
            )}
          </figure>
        ))
      }
    </div>

    <ol class="al-names" aria-hidden="true">
      {items.map((item) => <li><span class="al-name">{item.title}</span></li>)}
    </ol>

    <div class="al-details">
      {
        items.map((item) => (
          <article class="al-detail">
            <p class="al-meta">{item.meta}</p>
            <h3>{item.title}</h3>
            <p class="al-text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initAwardsList } from '../scripts/awards-list';

  mount(() => {
    const root = document.querySelector<HTMLElement>('.al');
    return root ? initAwardsList(root) : undefined;
  });
</script>

<style>
  .al {
    position: relative;
    background: var(--ink-warm);
    color: var(--cream);
  }

  /* ---- without the script: the photos in a grid, the awards written out under them ---- */
  .al-pin {
    padding: var(--space) 1.5rem;
  }
  .al-index,
  .al-names {
    display: none;
  }
  .al-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    max-width: 64rem;
    margin: 0 auto 4rem;
  }
  .al-img {
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
  }
  .al-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }
  .al-details {
    display: grid;
    gap: 2.5rem;
    max-width: 40rem;
    margin: 0 auto;
  }
  .al-meta {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 0.8rem;
  }
  .al-detail h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.8rem, 2.4vw, 2.8rem);
    line-height: 1.05;
    margin: 0 0 0.9rem;
  }
  .al-text {
    font-size: clamp(0.95rem, 1.05vw, 1.1rem);
    line-height: 1.7;
    margin: 0;
    opacity: 0.75;
  }

  /* ---- with the script: one pinned screen in a tall track ---- */
  .al[data-live] {
    height: calc((1 + var(--al-length)) * 100svh);
    /* where the photo's frame stands (a laptop: to the right of the words; a phone or a tablet: under the counter, above the words) */
    --fx: 32vw;
    --fy: 14svh;
    --fw: 46vw;
    --fh: 74svh;
  }
  /* The list is pulled up by one screen over the end of the spiral's pin, so it reaches the top of the screen exactly when the pin ends. Its
     first picture is the one the spiral has grown to the whole screen: while the list slides up, the picture is held still on the screen (the
     script), so it is the spiral's own photo, not a copy that moves. */
  :global(.sp[data-live]) ~ .al[data-live] {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }
  .al[data-live] .al-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: 0;
    overflow: hidden;
  }
  /* the frame's place (only measured by the script) */
  .al-slot {
    display: none;
  }
  .al[data-live] .al-slot {
    display: block;
    position: absolute;
    left: var(--fx);
    top: var(--fy);
    width: var(--fw);
    height: var(--fh);
    pointer-events: none;
    visibility: hidden;
  }
  .al[data-live] .al-index {
    display: block;
    position: absolute;
    top: 2rem;
    left: 2rem;
    z-index: 3;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 6.2vw, 8.5rem);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    will-change: transform;
  }
  .al[data-live] .al-total {
    opacity: 0.35;
  }
  /* the counter and the names rise out of masks when the section comes up */
  .al[data-live] .al-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .al[data-live] .al-roll {
    display: block;
  }
  .al[data-live] .al-names li {
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .al[data-live] .al-name {
    display: block;
  }
  /* the frame: it begins as the whole screen (the photo of the spiral) and settles into its place; every award is one photo in it, opened over
     the one before from the bottom edge */
  .al[data-live] .al-images {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    max-width: none;
    margin: 0;
    padding: 0;
    display: block;
    overflow: hidden;
    border-radius: 0;
    will-change: left, top, width, height, transform;
  }
  .al[data-live] .al-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    aspect-ratio: auto;
    border-radius: 0;
  }
  .al[data-live] .al-img :global(img) {
    will-change: transform;
  }
  .al[data-live] .al-names {
    display: flex;
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    z-index: 3;
    flex-direction: column;
    align-items: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .al[data-live] .al-names li {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.75vw, 1.8rem);
    line-height: 1.25;
    color: rgba(239, 233, 220, 0.3);
    transition: color 0.3s ease;
    will-change: transform;
  }
  .al[data-live] .al-names li.is-current {
    color: var(--gold);
  }
  /* the words of the current award: on the left, level with the middle of the frame */
  .al[data-live] .al-details {
    position: absolute;
    left: 2rem;
    top: 50%;
    z-index: 3;
    width: min(22rem, calc(30vw - 3rem));
    max-width: none;
    margin: 0;
    gap: 0;
    translate: 0 -50%;
  }
  .al[data-live] .al-detail {
    grid-area: 1 / 1;
    will-change: transform, opacity;
  }
  .al[data-live] .al-detail h3 {
    font-size: clamp(2rem, 3vw, 3.4rem);
  }

  /* ---- a tablet and a phone (upright): the same pinned screen in one column. The counter is at the top, the photo's frame is under it,
     and the words of its award stand under the frame. The names are left out. ---- */
  @media (max-width: 1000px) {
    .al[data-live] {
      --fx: 1.5rem;
      --fw: calc(100% - 3rem);
      --fy: max(9rem, 17svh);
      --fh: 42svh;
    }
    .al[data-live] .al-index {
      top: 5.4rem;
      left: 1.5rem;
      font-size: clamp(2.6rem, 11vw, 4.6rem);
    }
    .al[data-live] .al-names {
      display: none;
    }
    .al[data-live] .al-details {
      left: 1.5rem;
      right: 1.5rem;
      top: calc(var(--fy) + var(--fh) + 1.4rem);
      width: auto;
      translate: none;
    }
    .al[data-live] .al-detail h3 {
      font-size: clamp(1.7rem, 6.6vw, 2.6rem);
    }
    .al[data-live] .al-text {
      font-size: clamp(0.92rem, 3.7vw, 1.05rem);
      max-width: 34rem;
    }
  }
  @media (min-width: 600px) and (max-width: 1000px) {
    .al[data-live] {
      --fx: 2.5rem;
      --fw: calc(100% - 5rem);
    }
    .al[data-live] .al-index {
      left: 2.5rem;
    }
    .al[data-live] .al-details {
      left: 2.5rem;
      right: 2.5rem;
    }
  }
</style>
