---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Full-screen cat cards that stack while scrolling: the "Our Camps" stack of the white-desert capture (lib/fx/stack.js), in the style of this site.
 * Each card is pinned to the top while the next one slides up over it; the card underneath shrinks into a rounded frame and darkens (its words stay). The words of a card rise out of their windows when it arrives, like every other text of the site.
 * On a laptop (a mouse, a wide screen) it is the capture's mechanism: a ScrollTrigger pin with pinSpacing off and a scrub that follows the scroll
 * with no lag. On a phone and a tablet the cards are CSS sticky instead (a pin switches to position:fixed on the main thread and jitters under a
 * finger). Without the script (or with reduced motion) the cards are simply stacked one under another.
 */
interface Card {
  name: string;
  role: string; // Queen, Stud...
  line: string;
  image: ImageMetadata;
  position?: string; // object-position of the photo
}
interface Props {
  cards: Card[];
  // For a stack that follows a section which is held still (sticky): `pull` (negative) pulls the stack up over its end, so the first card sits on the
  // screen from the moment the stripes have covered it; `lead` is the scrolling that first card is given to unfold, from the right to the left, in place
  // (it does not come up from below), before the next card slides over it. Both are lengths, e.g. "-160svh" and "60svh".
  pull?: string;
  lead?: string;
}
const { cards, pull, lead } = Astro.props;
---

<section class="cs" data-cat-stack data-pulled={pull ? "" : undefined} data-lead={lead ? "" : undefined} style={`${pull ? `--cs-pull:${pull};` : ""}${lead ? `--cs-lead:${lead};` : ""}` || undefined}>
  {
    cards.map((c) => (
      <div class="cs-item" data-cs-item>
        <div class="cs-reveal" data-cs-reveal>
        <div class="cs-card" data-cs-card>
          <Image src={c.image} alt={c.name} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" decoding="async" style={`object-position:${c.position ?? '50% 35%'}`} />
          <span class="cs-shade" aria-hidden="true"></span>
          <span class="cs-dim" aria-hidden="true" data-cs-dim></span>
          <div class="cs-content">
            <p class="cs-role">{c.role}</p>
            <h2 class="cs-name">{c.name}</h2>
            <p class="cs-line">{c.line}</p>
          </div>
        </div>
        </div>
      </div>
    ))
  }
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { mount } from '../scripts/lifecycle';
  import { WORD_HIDDEN } from '../scripts/settings';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  mount(() => {
    const mm = gsap.matchMedia();
    const splits: SplitText[] = [];

    // the scrolling the first card is given to unfold in place (0 if it just comes up like the others)
    const leadOf = (items: HTMLElement[]) => {
      if (!items[0].closest('[data-cat-stack]')?.hasAttribute('data-lead')) return 0;
      // pinned by script: the first card is taller than the screen; sticky: the space in front of the second card
      const gap = items[1] ? parseFloat(getComputedStyle(items[1]).marginTop) || 0 : 0;
      // (the first card's height beyond a normal card's: the screen's own height is not used, it differs from the card's on a phone)
      return Math.max(0, items[0].offsetHeight - (items[1]?.offsetHeight ?? window.innerHeight)) + Math.max(0, gap);
    };

    // Where card `i` sits in the page when it is not stuck: the sum of the heights and gaps of the cards before it. On a phone the cards are CSS sticky, and ScrollTrigger
    // measures a trigger where it IS at the moment it measures (on a phone that happens at any scroll position: the address bar, the images, a rotation): a card that
    // is stuck at that moment would be measured at the top of the screen and its scrubs would start far too early. So on a phone the triggers are the (not
    // sticky) stack itself, with the card's natural offset worked out from its siblings.
    const natural = (items: HTMLElement[], i: number) => {
      let y = 0;
      for (let j = 0; j <= i; j += 1) {
        y += parseFloat(getComputedStyle(items[j]).marginTop) || 0;
        if (j < i) y += items[j].offsetHeight;
      }
      return y;
    };
    const mark = (sticky: boolean, items: HTMLElement[], i: number, where: string) => (sticky ? `top+=${Math.round(natural(items, i))} ${where}` : `top ${where}`);

    // what both versions share: the words rise out of their windows when a card arrives; returns each card's words (for the way out)
    const prepare = (root: HTMLElement, items: HTMLElement[], sticky = false) =>
      items.map((item, i) => {
        const role = SplitText.create(item.querySelector('.cs-role')!, { type: 'words', mask: 'words' });
        const name = SplitText.create(item.querySelector('.cs-name')!, { type: 'words', mask: 'words' });
        const line = SplitText.create(item.querySelector('.cs-line')!, { type: 'words', mask: 'words' });
        splits.push(role, name, line);
        const words = [...role.words, ...name.words, ...line.words];
        gsap.from(words, {
          yPercent: WORD_HIDDEN,
          duration: 1.1,
          stagger: 0.05,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: sticky ? root : item,
            start: i === 0 && leadOf(items) ? () => mark(sticky, items, i, `top-=${Math.round(leadOf(items) * 0.7)}`) : () => mark(sticky, items, i, i === 0 ? '75%' : '55%'),
            toggleActions: 'play none none reverse',
          },
        });
        return words;
      });

    // the card that is covered shrinks into a rounded frame and darkens (the values of the capture's stack.js); its words stay
    const cover = (item: HTMLElement, words: Element[], scrollTrigger: ScrollTrigger.Vars) => {
      const card = item.querySelector<HTMLElement>('[data-cs-card]')!;
      const dim = item.querySelector<HTMLElement>('[data-cs-dim]')!;
      gsap.set(card, { clipPath: 'inset(0rem round 0rem)' });
      const tl = gsap.timeline({ scrollTrigger });
      tl.to(card, { clipPath: 'inset(2.5rem round 0.625rem)', scale: 0.96, ease: 'none' }, 0);
      tl.to(dim, { opacity: 0.65, ease: 'none' }, 0);
      // (the words stay where they are: they do not leave while the next card covers this one)
    };

    // the first card unfolds from the right to the left, in place, while the section under it stands still (it does not come up from below)
    const unfold = (items: HTMLElement[], root: HTMLElement, sticky = false) => {
      const reveal = items[0].querySelector<HTMLElement>('[data-cs-reveal]');
      if (!reveal || !leadOf(items)) return;
      gsap.fromTo(
        reveal,
        { clipPath: 'inset(0% 0% 0% 100%)' },
        { clipPath: 'inset(0% 0% 0% 0%)', ease: 'power1.inOut', onComplete: () => gsap.set(reveal, { clearProps: 'clipPath' }), scrollTrigger: { trigger: sticky ? root : items[0], start: 'top top', end: () => `+=${leadOf(items)}`, scrub: true, invalidateOnRefresh: true } },
      );
    };

    // ---- a laptop: the capture's mechanism, a pin on each card (all but the last) with pinSpacing off, and a scrub that follows the scroll ----
    mm.add('(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
      const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-stack]'));
      roots.forEach((root) => {
      root.dataset.live = 'pin';
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-cs-item]'));
      const words = prepare(root, items);
      unfold(items, root);
      items.forEach((item, i) => {
        if (i === items.length - 1) return;
        // every card stays pinned until the LAST card has reached the top: the covered cards stay where they are, one under the other (a card that let go
        // as soon as the next had covered it would scroll away upwards and show through the gap round the card in front)
        const last = items[items.length - 1];
        const end = () => `+=${last.offsetTop - item.offsetTop}`;
        ScrollTrigger.create({ trigger: item, start: 'top top', end, pin: true, pinSpacing: false });
        // a card is covered while the next one slides up over it: from the moment that one's top enters the screen to the moment it reaches the top
        // (the same for every card, the first one included, whatever it was given to unfold in before)
        cover(item, words[i], { trigger: items[i + 1], start: 'top bottom', end: 'top top', scrub: true, invalidateOnRefresh: true });
      });
      });
      return () => {
        roots.forEach((root) => delete root.dataset.live);
        splits.splice(0).forEach((s) => s.revert());
      };
    });

    // ---- a phone, a tablet, a touch screen: CSS sticky, and the covered card is scrubbed while the next one rises over it ----
    mm.add('(max-width: 1023px), (pointer: coarse)', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-stack]'));
      roots.forEach((root) => {
      root.dataset.live = 'sticky';
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-cs-item]'));
      const words = prepare(root, items, true);
      unfold(items, root, true);
      items.forEach((item, i) => {
        const next = items[i + 1];
        if (!next) return;
        cover(item, words[i], {
          trigger: root,
          start: () => mark(true, items, i + 1, 'bottom'),
          end: () => mark(true, items, i + 1, 'top'),
          scrub: true,
          invalidateOnRefresh: true,
        });
      });
      });
      return () => {
        roots.forEach((root) => delete root.dataset.live);
        splits.splice(0).forEach((s) => s.revert());
      };
    });

    return () => mm.revert();
  }, '[data-cat-stack]');
</script>

<style>
  .cs {
    position: relative;
    z-index: 2; /* above a section that is held still under it */
    background: #0c0907;
    color: #f4ede0;
  }
  /* the cards: one screen each. Pinned by the script on a laptop, CSS sticky on a phone and a tablet. */
  .cs-item {
    position: relative;
    height: 100vh;
    height: 100svh;
  }
  .cs[data-live='pin'] .cs-item {
    z-index: 2;
  }
  .cs[data-live='sticky'] .cs-item {
    position: sticky;
    top: 0;
    /* a phone, a tablet: the page scrolls in a box as tall as the LARGEST viewport (see Layout.astro and the hero), the browser's bars sit over it. A card of
       100svh would be a bar shorter than the box and the edge of the next card would show under it, so the cards are as tall as the box. */
    height: 100vh;
    height: 100lvh;
  }
  /* with a section held under the stack: the stack is pulled up under it, and its first card is given the length to unfold in */
  .cs[data-live][data-pulled] {
    margin-top: var(--cs-pull);
  }
  /* no colour of its own: until the first card has unfolded, what is under the stack (the held screen) shows beside it */
  .cs[data-live][data-lead] {
    background: transparent;
  }
  .cs[data-live='pin'][data-lead] .cs-item:first-child {
    height: calc(100vh + var(--cs-lead));
    height: calc(100svh + var(--cs-lead));
  }
  .cs-reveal {
    position: absolute;
    inset: 0;
  }
  .cs[data-live='pin'][data-lead] .cs-item:first-child .cs-reveal {
    bottom: auto;
    height: 100vh;
    height: 100svh;
  }
  /* a phone, a tablet: every card, the first one too, is one screen high and sticky until the end of the stack. The scrolling the first card is given
     to unfold in is the space in front of the second card (a sticky box taller than the screen would let go of its card too early). */
  .cs[data-live='sticky'][data-lead] .cs-item:nth-child(2) {
    margin-top: var(--cs-lead);
  }
  .cs-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0c0907;
    will-change: clip-path, transform;
    transform: translateZ(0);
    backface-visibility: hidden;
    contain: paint;
  }
  .cs-dim {
    will-change: opacity;
  }
  .cs-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cs-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 7, 6, 0.65), rgba(8, 7, 6, 0.15) 55%, rgba(8, 7, 6, 0.4));
    pointer-events: none;
  }
  .cs-dim {
    position: absolute;
    inset: 0;
    background: #080706;
    opacity: 0;
    pointer-events: none;
  }
  /* as in the capture: the content is in the middle of the card, centred: a small line above, the big name, a short text under it */
  .cs-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 6vw;
    text-align: center;
  }
  .cs-role {
    margin: 0 0 1.25rem;
    font-family: var(--font-body, sans-serif);
    font-size: clamp(0.8rem, 1.1vw, 1.1rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold, #d4af37);
  }
  .cs-name {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading, serif);
    font-weight: 300;
    font-size: clamp(3.4rem, 11vw, 9.5rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .cs-line {
    margin: 0 auto;
    max-width: 28rem;
    font-family: var(--font-heading, serif);
    font-weight: 300;
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    line-height: 1.15;
  }
</style>
