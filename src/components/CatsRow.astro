---
import { Image } from 'astro:assets';
import draco from '../assets/img/cats/draco.webp';
import kita from '../assets/img/cats/kita.webp';
import candy from '../assets/img/cats/candy.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';
import cosmo from '../assets/img/cats/cosmo.webp';

// Placeholder copy — names come from the old site, the detail lines are to be replaced
const cats = [
  { name: 'Draco', line: 'Details coming soon', image: draco },
  { name: 'Kita', line: 'Details coming soon', image: kita },
  { name: 'Candy', line: 'Details coming soon', image: candy },
  { name: 'Charlie', line: 'Details coming soon', image: charlie },
  { name: 'Chester', line: 'Details coming soon', image: chester },
  { name: 'Cosmo', line: 'Details coming soon', image: cosmo },
];
---

<!--
  Chapter 4. Desktop: pinned; scrolling slides the row of cats sideways (photos drift against the cards for depth).
  Mobile / reduced motion: a plain swipeable row.
  The wrapper starts one screen early so this chapter slides over the end of the expanding photo before it.
-->
<div class="cats-cover">
  <section class="cats" id="cats">
    <div class="cats-sheet">
    <div class="cats-track">
      <div class="cats-intro">
        <p class="eyebrow">The family</p>
        <h2>Meet the cats behind every litter</h2>
        <p class="lead">
          Placeholder text. A few calm sentences about the parents and the kittens you are about to meet.
        </p>
        <p class="cue" aria-hidden="true">Keep scrolling →</p>
      </div>
      {
        cats.map((c) => (
          <article class="cat">
            <div class="cat-photo">
              <Image src={c.image} alt={c.name} widths={[500, 800, 1100]} sizes="(min-width:1024px) 28vw, 80vw" />
            </div>
            <h3>{c.name}</h3>
            <p>{c.line}</p>
          </article>
        ))
      }
      <div class="cal">
        <div class="cal-head">
          <p class="eyebrow">Breeding calendar</p>
          <h2>Plan your kitten</h2>
          <p class="lead">
            Placeholder text. How litters are planned through the year, and how to join the waiting list for the
            next one.
          </p>
        </div>
        <ol class="cal-months" data-months>
          {
            Array.from({ length: 6 }).map(() => (
              <li class="cal-month">
                <span class="cal-line" />
                <span class="cal-name" />
                <span class="cal-year" />
                <span class="cal-slot">Litter details soon</span>
                <span class="cal-slot cal-slot--ghost">Placeholder</span>
              </li>
            ))
          }
        </ol>
        <div class="cal-foot">
          <ul class="cal-legend">
            <li><i class="dot dot--pair"></i>Pairing</li>
            <li><i class="dot dot--exp"></i>Expected litter</li>
            <li><i class="dot dot--ready"></i>Kittens ready</li>
          </ul>
          <a class="cta" href="#">Join the waiting list</a>
        </div>
      </div>
      <div class="cats-end" aria-hidden="true"></div>
    </div>
    <div class="cats-progress" aria-hidden="true"><div class="cats-fill"></div></div>
    <span class="cats-count" aria-hidden="true"></span>
    </div>
  </section>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { fillMonths } from '../scripts/cats/months';
  import { initDesktop } from '../scripts/cats/desktop';
  import { initMobile } from '../scripts/cats/mobile';

  gsap.registerPlugin(ScrollTrigger);

  fillMonths();
  initDesktop();
  initMobile();
</script>

<style>
  .cats-cover {
    position: relative;
    z-index: 3; /* above the expanding photo before it */
    font-family: var(--font-heading);
  }
  .cats {
    position: relative;
  }
  .cats-sheet {
    position: relative;
    padding: clamp(4rem, 10vh, 7rem) 0;
    background: var(--paper);
  }

  /* Mobile / reduced motion: a swipeable row */
  .cats-track {
    display: flex;
    gap: 1.25rem;
    padding: 0 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .cats-track::-webkit-scrollbar {
    display: none;
  }
  .cats-intro {
    flex: 0 0 85%;
    scroll-snap-align: start;
    align-self: center;
  }
  .cat {
    flex: 0 0 75%;
    scroll-snap-align: start;
  }
  .cats-end,
  .cats-progress,
  .cue {
    display: none;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
    opacity: 0.65;
  }
  h2 {
    font-size: clamp(2.1rem, 8vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }
  .lead {
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0;
  }
  .cat-photo {
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 3 / 4;
    background: #e9e4d9;
  }
  .cat-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat h3 {
    font-size: 1.75rem;
    font-weight: 400;
    margin: 1rem 0 0.25rem;
  }
  .cat p {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    margin: 0;
    opacity: 0.6;
  }

  /* Breeding calendar panel (last stop of the row) */
  .cal {
    flex: 0 0 88%;
    scroll-snap-align: start;
    align-self: center;
    display: grid;
    gap: 2rem;
  }
  .cal-months {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .cal-month {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: var(--dash-faint);
    padding-top: 1rem;
  }
  /* dark dashes over the light ones; revealed left to right during the hold (desktop) */
  .cal-line {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: var(--dash-strong);
  }
  .cal-name {
    font-size: 1.75rem;
    line-height: 1;
  }
  .cal-year {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  .cal-slot {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.7rem 0.85rem;
    background: rgba(26, 26, 26, 0.05);
    border-radius: 4px;
  }
  .cal-slot--ghost {
    opacity: 0.55;
    background: rgba(26, 26, 26, 0.03);
  }
  .cal-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cal-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .cal-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    display: inline-block;
  }
  .dot--pair {
    background: var(--ink);
  }
  .dot--exp {
    background: #b88a4a;
  }
  .dot--ready {
    border: 1.5px solid var(--ink);
  }
  .cal .cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(26, 26, 26, 0.45);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.3s, color 0.3s;
  }
  .cal .cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* ---- Desktop pinned layout (script sets data-pinned) ---- */
  .cats[data-pinned] {
    height: 100vh;
    overflow: hidden; /* clips the sheet while it waits below the screen */
  }
  .cats[data-pinned] .cats-sheet {
    height: 100%;
    padding: 0;
    display: flex;
    align-items: center;
  }
  .cats[data-pinned] .cats-track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    gap: 4vw;
    padding: 0 0 0 6vw; /* no padding on the right: the calendar page ends exactly at the screen edge */
    align-items: center;
    will-change: transform;
  }
  .cats[data-pinned] .cats-intro {
    flex: 0 0 30vw;
    padding-right: 2vw;
  }
  .cats[data-pinned] h2 {
    font-size: clamp(2.4rem, 4vw, 4.6rem);
  }
  .cats[data-pinned] .cue {
    display: block;
    margin: 2.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .cats[data-pinned] .cat {
    flex: 0 0 26vw;
  }
  .cats[data-pinned] .cat-photo {
    height: 62vh;
    aspect-ratio: auto;
  }
  /* photos are wider than their frame so they can drift sideways inside it */
  .cats[data-pinned] .cat-photo :global(img) {
    width: 125%;
    max-width: none;
    margin-left: -12.5%;
    will-change: transform;
  }
  /* the calendar is a full page: exactly one screen wide, so when the row ends nothing of the cats is beside it */
  .cats[data-pinned] .cal {
    box-sizing: border-box;
    flex: 0 0 100vw;
    height: 62vh;
    grid-template-rows: auto 1fr auto;
    gap: 3vh;
    padding: 0 6vw;
  }
  .cats[data-pinned] .cal-head {
    max-width: 44rem;
  }
  .cats[data-pinned] .cal h2 {
    font-size: clamp(2.2rem, 3.6vw, 4rem);
  }
  .cats[data-pinned] .cal-months {
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25vw;
    align-self: start;
  }
  .cats[data-pinned] .cats-end {
    display: none; /* no trailing space: the calendar must stop fully in view */
  }
  .cats[data-pinned] .cats-progress {
    display: block;
    position: absolute;
    left: 6vw;
    right: 6vw;
    bottom: 6vh;
    height: 0;
    border-top: var(--dash-track);
  }
  .cats[data-pinned] .cats-fill {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: var(--dash-strong);
    clip-path: inset(0% 100% 0% 0%);
  }

  /* Desktop: starts two screens early. The expanding photo (held 1 screen longer, see holdDistance in index)
     stays stuck under this sheet until it has fully arrived, so no gap can open between them. */
  .cats-cover[data-pinned] {
    margin-top: -200vh;
  }

  /* ---- Phones and tablets: pinned row, one cat per screen (script sets data-mobile) ---- */
  .cats-cover[data-mobile] {
    --nav: 104px;
    --bar: calc(100vh - 100svh);
    --bar: calc(100lvh - 100svh);
  }
  .cats[data-mobile] .cats-sheet {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    padding: 0;
    overflow: hidden;
  }
  .cats[data-mobile] .cats-track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    gap: 0;
    padding: 0;
    align-items: stretch;
    will-change: transform;
  }
  .cats[data-mobile] .cats-intro,
  .cats[data-mobile] .cat {
    flex: 0 0 100vw;
    width: 100vw;
    box-sizing: border-box;
    height: 100vh;
    height: 100lvh;
    scroll-snap-align: none;
  }
  .cats[data-mobile] .cats-intro {
    align-self: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--nav) 8vw calc(var(--bar) + 10svh);
  }
  .cats[data-mobile] .cats-intro h2 {
    font-size: clamp(2.2rem, 8.4vw, 3.8rem);
  }
  .cats[data-mobile] .cat {
    display: flex;
    flex-direction: column;
    padding: calc(var(--nav) + 1rem) 8vw calc(var(--bar) + 12svh);
  }
  .cats[data-mobile] .cat-photo {
    flex: 1 1 auto;
    min-height: 0;
    aspect-ratio: auto;
    border-radius: 6px;
  }
  .cats[data-mobile] .cat h3 {
    margin: 1.1rem 0 0.25rem;
    font-size: clamp(1.8rem, 6.4vw, 2.6rem);
  }
  .cats[data-mobile] .cats-end,
  .cats[data-mobile] .cue {
    display: none;
  }
  .cats[data-mobile] .cats-progress {
    display: block;
    position: absolute;
    left: 8vw;
    width: 52vw;
    bottom: calc(var(--bar) + 5svh);
    height: 0;
    border-top: var(--dash-track);
  }
  .cats[data-mobile] .cats-fill {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: var(--dash-strong);
    clip-path: inset(0% 100% 0% 0%);
  }
  .cats[data-mobile] .cats-count {
    display: block;
    position: absolute;
    right: 8vw;
    bottom: calc(var(--bar) + 5svh - 0.45rem);
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  /* the calendar is a normal block after the row */
  .cats-cover[data-mobile] > .cal {
    flex: none;
    display: grid;
    box-sizing: border-box;
    max-width: 46rem;
    margin: 0 auto;
    padding: 5rem 6vw 6rem;
    background: var(--paper);
  }
  .cats-count {
    display: none;
  }
</style>
