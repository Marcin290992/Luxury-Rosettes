---
import { Image } from 'astro:assets';
import draco from '../assets/img/cats/draco.webp';
import kita from '../assets/img/cats/kita.webp';
import candy from '../assets/img/cats/candy.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';
import cosmo from '../assets/img/cats/cosmo.webp';

// Placeholder copy — names come from the old site, the detail lines are to be replaced
const cats = [
  { name: 'Draco', line: 'Details coming soon', image: draco },
  { name: 'Kita', line: 'Details coming soon', image: kita },
  { name: 'Candy', line: 'Details coming soon', image: candy },
  { name: 'Charlie', line: 'Details coming soon', image: charlie },
  { name: 'Chester', line: 'Details coming soon', image: chester },
  { name: 'Cosmo', line: 'Details coming soon', image: cosmo },
];
---

<!--
  Chapter 4. Desktop: pinned; scrolling slides the row of cats sideways (photos drift against the cards for depth).
  Mobile / reduced motion: a plain swipeable row.
  The wrapper starts one screen early so this chapter slides over the end of the expanding photo before it.
-->
<div class="cats-cover">
  <section class="cats" id="cats">
    <div class="cats-sheet">
    <div class="cats-track">
      <div class="cats-intro">
        <p class="eyebrow">The family</p>
        <h2>Meet the cats behind every litter</h2>
        <p class="lead">
          Placeholder text. A few calm sentences about the parents and the kittens you are about to meet.
        </p>
        <p class="cue" aria-hidden="true">Keep scrolling →</p>
      </div>
      {
        cats.map((c) => (
          <article class="cat">
            <div class="cat-photo">
              <Image src={c.image} alt={c.name} widths={[500, 800, 1100]} sizes="(min-width:1024px) 28vw, 80vw" />
            </div>
            <h3>{c.name}</h3>
            <p>{c.line}</p>
          </article>
        ))
      }
      <div class="cal">
        <div class="cal-head">
          <p class="eyebrow">Breeding calendar</p>
          <h2>Plan your kitten</h2>
          <p class="lead">
            Placeholder text. How litters are planned through the year, and how to join the waiting list for the
            next one.
          </p>
        </div>
        <ol class="cal-months" data-months>
          {
            Array.from({ length: 6 }).map(() => (
              <li class="cal-month">
                <span class="cal-line" />
                <span class="cal-name" />
                <span class="cal-year" />
                <span class="cal-slot">Litter details soon</span>
                <span class="cal-slot cal-slot--ghost">Placeholder</span>
              </li>
            ))
          }
        </ol>
        <div class="cal-foot">
          <ul class="cal-legend">
            <li><i class="dot dot--pair"></i>Pairing</li>
            <li><i class="dot dot--exp"></i>Expected litter</li>
            <li><i class="dot dot--ready"></i>Kittens ready</li>
          </ul>
          <a class="cta" href="#">Join the waiting list</a>
        </div>
      </div>
      <div class="cats-end" aria-hidden="true"></div>
    </div>
    <div class="cats-progress" aria-hidden="true"><div class="cats-fill"></div></div>
    <span class="cats-count" aria-hidden="true"></span>
    </div>
  </section>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // The next six months, counted from today — so the calendar never goes stale
  const monthName = new Intl.DateTimeFormat('en-GB', { month: 'long' });
  document.querySelectorAll<HTMLElement>('[data-months] .cal-month').forEach((li, i) => {
    const d = new Date(new Date().getFullYear(), new Date().getMonth() + i, 1);
    li.querySelector('.cal-name')!.textContent = monthName.format(d);
    li.querySelector('.cal-year')!.textContent = String(d.getFullYear());
  });

  const mm = gsap.matchMedia();
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const cover = document.querySelector<HTMLElement>('.cats-cover')!;
    const section = document.getElementById('cats')!;
    const sheet = section.querySelector<HTMLElement>('.cats-sheet')!; // animated; the section only gets pinned
    const track = section.querySelector<HTMLElement>('.cats-track')!;
    const cards = gsap.utils.toArray<HTMLElement>('.cat', section);
    const photos = gsap.utils.toArray<HTMLElement>('.cat-photo img', section);
    const intro = gsap.utils.toArray<HTMLElement>('.cats-intro > *', section);
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth); // sideways travel
    const arrival = () => window.innerHeight; // scroll spent sliding the sheet in
    const hold = () => window.innerHeight * 0.5; // scroll spent resting on the calendar, so it can't be skimmed past
    const SMOOTH = 1.2; // same "cinematic lag" feel as the stage before it
    let ctx: gsap.Context | undefined;
    let cancelled = false;

    section.dataset.pinned = '';
    cover.dataset.pinned = '';

    // After fonts, so widths are final; registered after the stage's own build (same event, later listener)
    document.fonts.ready.then(() => {
      if (cancelled) return;
      ctx = gsap.context(() => {
        // One pin holds the chapter for the whole time. Nothing here moves with the raw scroll position:
        // the sheet's arrival and the sideways travel are both scrubbed, like everything before them.
        const pin = ScrollTrigger.create({
          trigger: section,
          start: 'top top',
          end: () => `+=${arrival() + distance() + hold()}`,
          pin: true,
          invalidateOnRefresh: true,
        });
        const at = (offset = 0) => () => pin.start + offset;

        // 1. Arrival: the sheet rises over the expanding photo (photo drifts up and dims)
        const before = cover.previousElementSibling as HTMLElement | null;
        const stage = before?.querySelector<HTMLElement>('.se-stage');
        const dim = before?.querySelector<HTMLElement>('.se-dim');
        // Held below the screen until the arrival begins (otherwise it would sit in its natural spot, then jump)
        gsap.set(sheet, { yPercent: 100 });
        const arrive = gsap.timeline({
          defaults: { immediateRender: false },
          scrollTrigger: { trigger: section, start: at(), end: () => pin.start + arrival(), scrub: SMOOTH, invalidateOnRefresh: true },
        });
        arrive.fromTo(sheet, { yPercent: 100 }, { yPercent: 0, ease: 'power2.inOut' }, 0);
        if (stage && dim) {
          arrive
            .fromTo(stage, { y: 0 }, { y: () => -window.innerHeight * 0.18, ease: 'power2.inOut' }, 0)
            .fromTo(dim, { opacity: 0 }, { opacity: 0.7, ease: 'power2.inOut' }, 0);
        }

        // 2. Sideways travel (this tween is also the "scroller" the cards react to)
        const range = { trigger: section, start: at(arrival()), end: () => pin.end - hold(), scrub: SMOOTH, invalidateOnRefresh: true };
        const move = gsap.to(track, { x: () => -distance(), ease: 'none', scrollTrigger: range });
        gsap.fromTo(photos, { xPercent: 7 }, { xPercent: -7, ease: 'none', scrollTrigger: range });
        gsap.fromTo(
          '.cats-fill',
          { clipPath: 'inset(0% 100% 0% 0%)' },
          { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none', scrollTrigger: range },
        );

        // 3. Each photo is revealed like in the story chapter: a mask opens while the image settles from a slow zoom
        const hide = (card: HTMLElement) => {
          gsap.set(card.querySelector('.cat-photo'), { clipPath: 'inset(0% 100% 0% 0%)' });
          gsap.set(card.querySelector('img'), { scale: 1.3 });
          gsap.set(card.querySelectorAll('h3, p'), { autoAlpha: 0, y: 16 });
        };
        const reveal = (card: HTMLElement) =>
          gsap
            .timeline({ paused: true, defaults: { ease: 'power3.out' } })
            .to(card.querySelector('.cat-photo'), { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.3 }, 0)
            .to(card.querySelector('img'), { scale: 1, duration: 2, ease: 'power2.out' }, 0)
            .to(card.querySelectorAll('h3, p'), { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1 }, 0.5);

        // the calendar panel: heading, then the month columns draw in one by one, then the legend and button
        const panel = section.querySelector<HTMLElement>('.cal')!;
        const calHead = gsap.utils.toArray<HTMLElement>('.cal-head > *', panel);
        const calMonths = gsap.utils.toArray<HTMLElement>('.cal-month', panel);
        const calFoot = gsap.utils.toArray<HTMLElement>('.cal-foot > *', panel);
        gsap.set(calHead, { autoAlpha: 0, y: 24 });
        gsap.set(calMonths, { autoAlpha: 0, y: 28 });
        gsap.set(calFoot, { autoAlpha: 0, y: 16 });
        const calReveal = gsap
          .timeline({ paused: true, defaults: { ease: 'power3.out' } })
          .to(calHead, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.12 }, 0)
          .to(calMonths, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.1 }, 0.3)
          .to(calFoot, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.12 }, 0.9);
        // while the pin holds on the calendar, a line draws across the months — the page is "doing" something,
        // and the scroll that remains is clearly part of this screen rather than dead space
        const lines = gsap.utils.toArray<HTMLElement>('.cal-line', panel);
        gsap.set(lines, { clipPath: 'inset(0% 100% 0% 0%)' });
        const draw = gsap.timeline({
          defaults: { ease: 'none', immediateRender: false },
          scrollTrigger: { trigger: section, start: () => pin.end - hold(), end: () => pin.end, scrub: SMOOTH, invalidateOnRefresh: true },
        });
        lines.forEach((l, i) =>
          draw.fromTo(l, { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.5 }, i * 0.5),
        ); // one after another

        ScrollTrigger.create({
          trigger: panel,
          containerAnimation: move,
          start: 'left 80%',
          animation: calReveal,
          toggleActions: 'play none none reverse',
        });

        gsap.set(intro, { autoAlpha: 0, y: 24 });
        const visibleAtStart = cards.filter((c) => c.getBoundingClientRect().left < window.innerWidth * 0.98);
        const later = cards.filter((c) => !visibleAtStart.includes(c));
        cards.forEach(hide);

        // the ones already on screen when the row starts moving play together once the sheet is mostly in
        const first = gsap.timeline({ paused: true });
        first.to(intro, { autoAlpha: 1, y: 0, duration: 0.9, stagger: 0.12, ease: 'power3.out' }, 0);
        visibleAtStart.forEach((c, i) => first.add(reveal(c).play(0), 0.25 + i * 0.22));
        ScrollTrigger.create({
          trigger: section,
          start: () => pin.start + arrival() * 0.55,
          animation: first,
          toggleActions: 'play none none reverse',
        });

        // the rest play as they slide into view from the right
        later.forEach((c) => {
          ScrollTrigger.create({
            trigger: c,
            containerAnimation: move,
            start: 'left 92%',
            animation: reveal(c),
            toggleActions: 'play none none reverse',
          });
        });
      }, section);
    });

    return () => {
      cancelled = true;
      ctx?.revert();
      delete section.dataset.pinned;
      delete cover.dataset.pinned;
    };
  });

  // ---- phones and tablets (< 1024px) ----------------------------------------------------------------------------------
  // The row is pinned (CSS sticky, so the compositor does it: no jitter) and swiping up slides it sideways, one cat per
  // screen. The photo of each cat opens with a mask as it arrives, drifts against its card, and the scroll settles on
  // the nearest cat. The breeding calendar is a normal vertical block after the row (six columns do not fit on a phone).
  const small = gsap.matchMedia();
  small.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    const cover = document.querySelector<HTMLElement>('.cats-cover')!;
    const section = document.getElementById('cats')!;
    const sheet = section.querySelector<HTMLElement>('.cats-sheet')!;
    const track = section.querySelector<HTMLElement>('.cats-track')!;
    const cal = section.querySelector<HTMLElement>('.cal')!;
    const fill = section.querySelector<HTMLElement>('.cats-fill')!;
    const count = section.querySelector<HTMLElement>('.cats-count')!;
    const items = gsap.utils.toArray<HTMLElement>(':scope > .cats-intro, :scope > .cat', track);
    const cats = items.slice(1);
    const n = items.length;
    const PER = 0.75; // screens of swiping per cat
    const pad = (i: number) => String(i).padStart(2, '0');

    cover.dataset.mobile = '';
    section.dataset.mobile = '';

    // the calendar leaves the row and follows it as a normal block
    cover.appendChild(cal);

    // the sheet sits in a tall box and sticks with CSS
    const box = document.createElement('div');
    box.dataset.stick = '';
    box.style.cssText = `position:relative;height:calc(100lvh * ${1 + PER * (n - 1)})`;
    sheet.parentNode!.insertBefore(box, sheet);
    box.appendChild(sheet);

    const ctx = gsap.context(() => {
      const imgs = cats.map((c) => c.querySelector<HTMLElement>('img')!);
      // the photos are simply there (no mask, no zoom): while the row slides the photo must not also be "appearing"
      gsap.set(imgs, { scale: 1.12 });
      gsap.set(fill, { clipPath: 'inset(0% 100% 0% 0%)' });

      const tl = gsap.timeline({
        defaults: { immediateRender: false },
        scrollTrigger: {
          trigger: box,
          start: 'top top',
          end: () => `+=${box.offsetHeight - sheet.offsetHeight}`,
          invalidateOnRefresh: true,
          scrub: 0.6,
          snap: { snapTo: 1 / (n - 1), duration: { min: 0.15, max: 0.45 }, delay: 0.12, ease: 'power2.inOut' },
          onUpdate: (self) => {
            const i = Math.round(self.progress * (n - 1));
            count.textContent = i ? `${pad(i)} / ${pad(n - 1)}` : '';
          },
        },
      });
      // one unit of time = one screen: item i is centred at time i
      tl.fromTo(track, { x: 0 }, { x: () => -(n - 1) * window.innerWidth, ease: 'none', duration: n - 1 }, 0);
      tl.fromTo(fill, { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none', duration: n - 1 }, 0);
      cats.forEach((_, j) => {
        const t = j + 1; // its item index
        const end = n - 1; // nothing may run past the last screen, or the whole row would be stretched
        // the only effect left: the photo drifts against its card (depth). Names and captions are simply there.
        tl.fromTo(imgs[j], { xPercent: 5 }, { xPercent: -5, duration: Math.min(2, end - (t - 1)), ease: 'none' }, t - 1);
      });
      tl.set({}, {}, n - 1);

      // the calendar, now a vertical block: months draw in as it is reached
      const months = gsap.utils.toArray<HTMLElement>('.cal-month', cal);
      const lines = gsap.utils.toArray<HTMLElement>('.cal-line', cal);
      const head = gsap.utils.toArray<HTMLElement>('.cal-head > *', cal);
      const foot = gsap.utils.toArray<HTMLElement>('.cal-foot > *', cal);
      gsap.set([head, months, foot].flat(), { autoAlpha: 0, y: 24 });
      gsap.set(lines, { clipPath: 'inset(0% 100% 0% 0%)' });
      gsap
        .timeline({ scrollTrigger: { trigger: cal, start: 'top 80%', toggleActions: 'play none none reverse' }, defaults: { ease: 'power3.out' } })
        .to(head, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1 }, 0)
        .to(months, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.08 }, 0.25)
        .to(lines, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.2, stagger: 0.08, ease: 'power3.inOut' }, 0.4)
        .to(foot, { autoAlpha: 1, y: 0, duration: 0.7, stagger: 0.1 }, 0.9);
    }, cover);

    document.fonts.ready.then(() => ScrollTrigger.refresh());

    return () => {
      ctx.revert();
      sheet.style.cssText = '';
      box.parentNode?.insertBefore(sheet, box);
      box.remove();
      track.appendChild(cal);
      track.insertBefore(cal, track.querySelector('.cats-end'));
      gsap.set([track, ...items], { clearProps: 'all' });
      delete cover.dataset.mobile;
      delete section.dataset.mobile;
    };
  });
</script>

<style>
  .cats-cover {
    position: relative;
    z-index: 3; /* above the expanding photo before it */
    font-family: var(--font-heading);
  }
  .cats {
    position: relative;
  }
  .cats-sheet {
    position: relative;
    padding: clamp(4rem, 10vh, 7rem) 0;
    background: #faf8f3;
  }

  /* Mobile / reduced motion: a swipeable row */
  .cats-track {
    display: flex;
    gap: 1.25rem;
    padding: 0 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .cats-track::-webkit-scrollbar {
    display: none;
  }
  .cats-intro {
    flex: 0 0 85%;
    scroll-snap-align: start;
    align-self: center;
  }
  .cat {
    flex: 0 0 75%;
    scroll-snap-align: start;
  }
  .cats-end,
  .cats-progress,
  .cue {
    display: none;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
    opacity: 0.65;
  }
  h2 {
    font-size: clamp(2.1rem, 8vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }
  .lead {
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0;
  }
  .cat-photo {
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 3 / 4;
    background: #e9e4d9;
  }
  .cat-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat h3 {
    font-size: 1.75rem;
    font-weight: 400;
    margin: 1rem 0 0.25rem;
  }
  .cat p {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    margin: 0;
    opacity: 0.6;
  }

  /* Breeding calendar panel (last stop of the row) */
  .cal {
    flex: 0 0 88%;
    scroll-snap-align: start;
    align-self: center;
    display: grid;
    gap: 2rem;
  }
  .cal-months {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .cal-month {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px dashed rgba(26, 26, 26, 0.22);
    padding-top: 1rem;
  }
  /* dark dashes over the light ones; revealed left to right during the hold (desktop) */
  .cal-line {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: 1px dashed #1a1a1a;
  }
  .cal-name {
    font-size: 1.75rem;
    line-height: 1;
  }
  .cal-year {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  .cal-slot {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.7rem 0.85rem;
    background: rgba(26, 26, 26, 0.05);
    border-radius: 4px;
  }
  .cal-slot--ghost {
    opacity: 0.55;
    background: rgba(26, 26, 26, 0.03);
  }
  .cal-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cal-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .cal-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    display: inline-block;
  }
  .dot--pair {
    background: #1a1a1a;
  }
  .dot--exp {
    background: #b88a4a;
  }
  .dot--ready {
    border: 1.5px solid #1a1a1a;
  }
  .cal .cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(26, 26, 26, 0.45);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.3s, color 0.3s;
  }
  .cal .cta:hover {
    background: #1a1a1a;
    color: #faf8f3;
  }

  /* ---- Desktop pinned layout (script sets data-pinned) ---- */
  .cats[data-pinned] {
    height: 100vh;
    overflow: hidden; /* clips the sheet while it waits below the screen */
  }
  .cats[data-pinned] .cats-sheet {
    height: 100%;
    padding: 0;
    display: flex;
    align-items: center;
  }
  .cats[data-pinned] .cats-track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    gap: 4vw;
    padding: 0 0 0 6vw; /* no padding on the right: the calendar page ends exactly at the screen edge */
    align-items: center;
    will-change: transform;
  }
  .cats[data-pinned] .cats-intro {
    flex: 0 0 30vw;
    padding-right: 2vw;
  }
  .cats[data-pinned] h2 {
    font-size: clamp(2.4rem, 4vw, 4.6rem);
  }
  .cats[data-pinned] .cue {
    display: block;
    margin: 2.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .cats[data-pinned] .cat {
    flex: 0 0 26vw;
  }
  .cats[data-pinned] .cat-photo {
    height: 62vh;
    aspect-ratio: auto;
  }
  /* photos are wider than their frame so they can drift sideways inside it */
  .cats[data-pinned] .cat-photo :global(img) {
    width: 125%;
    max-width: none;
    margin-left: -12.5%;
    will-change: transform;
  }
  /* the calendar is a full page: exactly one screen wide, so when the row ends nothing of the cats is beside it */
  .cats[data-pinned] .cal {
    box-sizing: border-box;
    flex: 0 0 100vw;
    height: 62vh;
    grid-template-rows: auto 1fr auto;
    gap: 3vh;
    padding: 0 6vw;
  }
  .cats[data-pinned] .cal-head {
    max-width: 44rem;
  }
  .cats[data-pinned] .cal h2 {
    font-size: clamp(2.2rem, 3.6vw, 4rem);
  }
  .cats[data-pinned] .cal-months {
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25vw;
    align-self: start;
  }
  .cats[data-pinned] .cats-end {
    display: none; /* no trailing space: the calendar must stop fully in view */
  }
  .cats[data-pinned] .cats-progress {
    display: block;
    position: absolute;
    left: 6vw;
    right: 6vw;
    bottom: 6vh;
    height: 0;
    border-top: 1px dashed rgba(26, 26, 26, 0.28);
  }
  .cats[data-pinned] .cats-fill {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: 1px dashed #1a1a1a;
    clip-path: inset(0% 100% 0% 0%);
