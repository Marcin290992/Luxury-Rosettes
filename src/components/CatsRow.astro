---
import Photo from './Photo.astro';
import LetterButton from './LetterButton.astro';
import kita1 from '../assets/img/Hera Draco/Kita 1.webp';
import draco1 from '../assets/img/Hera Draco/Draco 1.webp';
import kita2 from '../assets/img/Hera Draco/Kita 2.webp';
import draco2 from '../assets/img/Hera Draco/Draco 2.webp';
import '../styles/cats/base.css';
import '../styles/cats/desktop.css';
import '../styles/cats/mobile.css';

// The two parents, in turn: Kita, Draco, Kita, Draco (the studio portraits of the breeder). Only the photos for now: the names, tags and descriptions are removed (to be written later; the titles belong on the Awards page). The name stays as the photo's alt text.
const cats = [
  { name: 'Kita', image: kita1 },
  { name: 'Draco', image: draco2 },
  { name: 'Kita', image: kita2, still: true, focus: '44% 22%' }, // a wide close-up: no drift, and the crop is shifted a little to the left so the left ear is not cut
  { name: 'Draco', image: draco1, still: true }, // still: the ear is at the very edge of this photo, so it is shown whole (no drift, no side crop)
];

// Last stop of the row. Wording taken from the story section; to be replaced with the final copy
const pillars = [
  { title: 'Champion bloodlines', text: 'TICA registered parents with proven show records. Their titles are on our Awards page.' },
  { title: 'Raised at home', text: 'Born in our family home and well socialised from the first days. Every kitten grows up among people.' },
  { title: 'Cared for, for life', text: 'Health guarantees and lifetime breeder support. We stay close long after they leave.' },
];
---

<!--
  Chapter 4. Desktop: pinned; scrolling slides the row of cats sideways (photos drift against the cards for depth).
  Mobile / reduced motion: a plain swipeable row.
  The wrapper starts one screen early so this chapter slides over the end of the expanding photo before it.
-->
<div class="cats-cover">
  <section class="cats" id="cats">
    <div class="cats-sheet">
    <div class="cats-track">
      <div class="cats-intro">
        <h2>Where they come from</h2>
        <p class="lead">
          Every litter begins with the two of them. Kita and Draco are part of our family, and everything we hope for in a Bengal. Every litter is planned with care.
        </p>
      </div>
      {
        cats.map((c) => (
          <article class="cat">
            <div class="cat-photo">
              <Photo src={c.image} alt={c.name} widths={[500, 800, 1100]} sizes="(min-width:1024px) 28vw, 80vw" data-still={c.still ? "" : undefined} style={c.focus ? `object-position:${c.focus}` : undefined} />
            </div>
          </article>
        ))
      }
      <div class="fin">
        <div class="fin-head">
          <p class="eyebrow">The promise</p>
          <h2>What comes with every kitten</h2>
        </div>
        <ul class="fin-pillars">
          {
            pillars.map((p) => (
              <li class="fin-pillar">
                <span class="fin-line" />
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
        <div class="fin-foot">
          <LetterButton label="Available kittens" href="/available-kittens" light />
        </div>
      </div>
      <div class="cats-end" aria-hidden="true"></div>
    </div>
    <div class="cats-progress" aria-hidden="true"><div class="cats-fill"></div></div>
    <span class="cats-count" aria-hidden="true"></span>
    </div>
  </section>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initDesktop } from '../scripts/cats/desktop';
  import { initMobile } from '../scripts/cats/mobile';
  import { mount } from '../scripts/lifecycle';

  gsap.registerPlugin(ScrollTrigger);

  mount(() => {
    const stopDesktop = initDesktop();
    const stopMobile = initMobile();
    return () => {
      stopDesktop();
      stopMobile();
    };
  }, '#cats');
</script>
