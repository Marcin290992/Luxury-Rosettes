---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A heading whose words start far apart and slide together as you scroll, while a picture (a square with rounded corners) opens between the
 * two lines below it (after the 71three "Close to the work"; see scripts/close-to.ts). The words wrap to two lines on a tablet and a phone.
 * Without the script, or with reduced motion, it is simply the finished picture: words together, picture open.
 */
interface Props {
  words: string[];
  above: string;
  below: string;
  image: ImageMetadata;
  alt?: string;
}
const { words, above, below, image, alt = '' } = Astro.props;
const half = Math.ceil(words.length / 2);
---

<section class="ct" data-close-to>
  <div class="ct-in">
    <h2 class="ct-words">
      {
        [words.slice(0, half), words.slice(half)].map((row) => (
          <span class="ct-row">
            {row.map((w) => <span>{w}</span>)}
          </span>
        ))
      }
    </h2>
    <div class="ct-lines">
      <h3>{above}</h3>
      <div class="ct-media"><Image src={image} alt={alt} widths={[600, 1000, 1400]} sizes="(min-width:1025px) 26vw, 62vw" loading="lazy" /></div>
      <h3>{below}</h3>
    </div>
  </div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initCloseTo } from '../scripts/close-to';

  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-close-to]');
    return root ? initCloseTo(root) : undefined;
  }, '[data-close-to]');
</script>

<style>
  .ct {
    position: relative;
    min-height: 120vh;
    min-height: 120svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1rem;
    overflow-x: clip; /* while the words are far apart they reach past the edges */
    background: var(--paper);
    color: var(--ink);
  }
  .ct-in { width: 100%; }

  /* the END state: the words together, the picture open (the script plays the way to it from far apart / closed) */
  .ct-words {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    column-gap: 2vw;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 1.15;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ct-words span { will-change: transform; }
  /* on a desktop the rows melt away (one line of words); on a tablet and a phone they are two lines that never wrap, so the height does not jump while the words are far apart */
  .ct-row { display: contents; }

  .ct-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 62rem;
    margin: 2.5rem auto 0;
  }
  .ct-lines h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.6vw, 3.2rem);
    line-height: 1.2;
    text-align: center;
  }
  .ct-media {
    width: 26vw;
    height: 26vw;
    margin: 1.25rem 0 1.5rem;
    border-radius: 2rem;
    overflow: hidden;
    background: var(--placeholder);
    will-change: width, height;
  }
  .ct-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* tablet: two lines of words, a bigger picture */
  @media (max-width: 1024px) {
    .ct-words { flex-direction: column; row-gap: 0.4rem; font-size: clamp(2.4rem, 7.4vw, 4rem); }
    .ct-row { display: flex; justify-content: center; column-gap: inherit; }
    .ct-media { width: 44vw; height: 44vw; border-radius: 1.75rem; }
  }
  /* phone */
  @media (max-width: 768px) {
    .ct { min-height: 100vh; min-height: 100svh; padding: 5rem 1rem; }
    .ct-words { font-size: clamp(1.7rem, 8.4vw, 3rem); column-gap: 10px; letter-spacing: 0.03em; }
    .ct-lines { margin-top: 1.75rem; }
    .ct-lines h3 { padding: 0 0.25rem; }
    .ct-media { width: 62vw; height: 62vw; border-radius: 1.5rem; }
  }
</style>
