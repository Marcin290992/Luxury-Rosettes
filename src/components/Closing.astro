---
import { Image } from 'astro:assets';
import LetterButton from './LetterButton.astro';
import defaultPhoto from '../assets/img/our_cats.webp'; // placeholder: swap for the real closing photo
import type { ImageMetadata } from 'astro';

// Every page that ends with the footer uses this block; only the photo and the words change.
interface Props {
  photo?: ImageMetadata;
  eyebrow?: string;
  heading?: string[]; // one entry per line
  cta?: { label: string; href: string };
}
const {
  photo = defaultPhoto,
  eyebrow = 'Your Bengal awaits',
  heading = ['Ready to meet', 'your kitten?'],
  cta = { label: 'View available kittens', href: '/available-kittens' },
} = Astro.props;
---

<!-- Full-screen photo with the closing line. When the footer rises, the photo is clipped inward and the footer scales in (scripts/footer-zoom.ts). -->
<section class="end" id="enquire" data-footer-clip>
  <div class="bg" aria-hidden="true">
    <Image class="photo" src={photo} alt="" widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" draggable="false" data-footer-photo />
    <i class="shade"></i>
  </div>
  <div class="inner">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h2 data-reveal>{heading.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h2>
    <div class="ctas" data-reveal>
      <LetterButton label={cta.label} href={cta.href} solid />
      <LetterButton label="Get in touch" contact />
    </div>
  </div>
</section>

<style>
  .end {
    position: relative;
    overflow: hidden;
    background: #0d0b09;
    color: var(--cream);
    text-align: center;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: clamp(5.5rem, 14vh, 9rem) 1.5rem clamp(3rem, 8vh, 6rem); /* the top clears the nav pill */
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  /* taller than its frame so the parallax has room to move */
  .photo {
    position: absolute;
    left: 0;
    top: -15%;
    width: 100%;
    height: 130%;
    object-fit: cover;
    will-change: transform;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13, 11, 9, 0.55), rgba(13, 11, 9, 0.35) 45%, rgba(13, 11, 9, 0.7));
  }
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 5.5rem);
    line-height: 1.02;
    margin: 0 0 2rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
