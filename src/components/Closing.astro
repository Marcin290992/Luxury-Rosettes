---
import LetterButton from './LetterButton.astro';
---

<section class="end" id="enquire">
  <p class="eyebrow" data-reveal>Your Bengal awaits</p>
  <h2 data-reveal>Ready to meet<br />your kitten?</h2>
  <div class="ctas" data-reveal>
    <LetterButton label="View available kittens" href="/available-kittens" solid />
    <LetterButton label="Get in touch" contact />
  </div>
</section>

<style>
  .end {
    background: #0d0b09;
    color: var(--cream);
    text-align: center;
    min-height: 0; /* grows to fill the last screen (see .ending in index.astro) */
    display: grid;
    align-content: center;
    justify-items: center;
    padding: clamp(5.5rem, 14vh, 9rem) 1.5rem clamp(3rem, 8vh, 6rem); /* the top clears the nav pill */
  }
  /* the same type as the "Meet your Bengal" finale */
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 3.5rem);
    line-height: 1.02;
    margin: 0 0 2rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
