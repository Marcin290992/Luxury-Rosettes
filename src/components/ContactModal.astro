---
import { Image } from 'astro:assets';
import kita from '../assets/img/cats/kita.webp'; // placeholder: swap for the real portrait
import logo from '../assets/logo/logo-emblem.svg'; // the emblem of the footer
import { CONTACT_FORM } from '../scripts/settings';

/**
 * The contact screen every "Inquire" / "Get in touch" / "Contact" opens (anything with data-contact-trigger, and the `open-contact-modal` event of the
 * menu). It is the site's own language, not a dialog box: five dark stripes rise from the bottom one after another and cover the page (the
 * transition of the awards and the home page), then a portrait opens from its middle and the words come up out of their lines. The ways to reach us are pill tabs (see `tabs`): Email is the message form, the others open WhatsApp or Facebook.
 * Closes with Escape, the Close word, or the stripes' own screen. It is in the layout, so every page has it.
 */
// The three ways to reach the breeder, as pill tabs. `form` is the message form; the others open their own app or page.
const tabs = [
  { id: 'email', label: 'Email', form: true },
  { id: 'whatsapp', label: 'WhatsApp', note: '+44 7514 951289', blurb: 'Message us directly and we will answer as soon as we can.', cta: 'Open WhatsApp', href: 'https://wa.me/447514951289' },
  { id: 'facebook', label: 'Facebook', note: 'Luxuryrosettes Bengal cattery', blurb: 'Find us on Facebook and send a message there.', cta: 'Open Facebook', href: 'https://www.facebook.com/people/Luxuryrosettes-Bengal-cattery/100091469460702/' },
];
const STRIPES = 5;
---

<div class="contact" hidden role="dialog" aria-modal="true" aria-labelledby="contact-title">
  <div class="contact-stripes" aria-hidden="true">
    {Array.from({ length: STRIPES }, (_, i) => <i style={`--i:${i}`}></i>)}
  </div>

  <div class="contact-stage">
    <header class="contact-head">
      <div class="contact-brand">
        <Image src={logo} alt="" height={112} loading="eager" />
        <div class="contact-brand-text">
          <p class="contact-title-brand">Luxury Rosettes</p>
          <p class="contact-sub">Bengal Cattery</p>
        </div>
      </div>
      <button type="button" class="contact-close" aria-label="Close" data-contact-close>
        <span class="contact-close-word" aria-hidden="true">
          {[...'Close'].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}
        </span>
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg>
      </button>
    </header>

    <div class="contact-body">
      <figure class="contact-photo" aria-hidden="true">
        <div class="contact-frame">
          <Image src={kita} alt="" widths={[500, 800, 1100]} sizes="(min-width:769px) 34vw, 100vw" loading="lazy" draggable="false" />
        </div>
      </figure>

      <div class="contact-main">
        <h2 id="contact-title" class="contact-title rv"><span>Tell us about <em>your Bengal</em></span></h2>
        <div class="tabs" role="tablist" aria-label="How to reach us">
          {
            tabs.map((t, i) => (
              <>
                {i > 0 && <i class="tab-line" aria-hidden="true" />}
                <button type="button" class="tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>
                  <span class="word" aria-hidden="true">{[...t.label].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}</span>
                  <span class="visually-hidden">{t.label}</span>
                </button>
              </>
            ))
          }
        </div>

        <div class="panel" role="tabpanel" id="panel-email" aria-labelledby="tab-email" data-panel="email">
          <form class="contact-form" novalidate>
            <div class="field">
              <label for="cf-name">Your name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" autocapitalize="words" enterkeyhint="next" required />
            </div>
            <div class="field">
              <label for="cf-email">Your email</label>
              <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" enterkeyhint="next" required />
            </div>
            <div class="field">
              <label for="cf-message">Your message</label>
              <textarea id="cf-message" name="message" rows="2" required></textarea>
            </div>
            <input class="cf-trap" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="contact-send">
              <button type="submit" class="send">
                <span class="word" aria-hidden="true">{[...'Send message'].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}</span>
                <span class="visually-hidden">Send message</span>
                <svg width="30" height="12" viewBox="0 0 30 12" fill="none" aria-hidden="true"><path d="M0 6H29M24 1L29 6L24 11" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
              <p class="contact-status" role="status" aria-live="polite"></p>
            </div>
          </form>
          <div class="contact-copy">
            <span class="contact-copy-label">Or copy our address</span>
            <button type="button" class="copy" data-copy={CONTACT_FORM.to} aria-label={`Copy ${CONTACT_FORM.to}`}>
              <span class="copy-address">{CONTACT_FORM.to}</span>
              <span class="copy-action" aria-hidden="true">Copy</span>
            </button>
            <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
          </div>
        </div>

        {
          tabs.filter((t) => !t.form).map((t) => (
            <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-panel={t.id} hidden>
              <p class="way-note">{t.note}</p>
              <p class="way-blurb">{t.blurb}</p>
              <a class="send" href={t.href} target="_blank" rel="noopener noreferrer">
                <span class="word" aria-hidden="true">{[...(t.cta ?? "")].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}</span>
                <span class="visually-hidden">{t.cta}</span>
                <svg width="30" height="12" viewBox="0 0 30 12" fill="none" aria-hidden="true"><path d="M0 6H29M24 1L29 6L24 11" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { mount } from '../scripts/lifecycle';
  import { getLenis } from '../scripts/lenis';
  import { CONTACT_FORM } from '../scripts/settings';

  mount(() => {
    const root = document.querySelector<HTMLElement>('.contact');
    if (!root) return;
    const closeBtn = root.querySelector<HTMLButtonElement>('.contact-close')!;
    const tabButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const form = root.querySelector<HTMLFormElement>('.contact-form')!;
    const status = root.querySelector<HTMLElement>('.contact-status')!;
    let opener: HTMLElement | null = null;
    let lenisStopped = false;
    let hideTimer = 0;

    const open = (from?: HTMLElement | null) => {
      if (!root.hidden && root.classList.contains('is-open')) return;
      window.clearTimeout(hideTimer);
      opener = from ?? (document.activeElement as HTMLElement | null);
      root.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-open')));
      document.documentElement.classList.add('contact-open');
      getLenis()?.stop();
      lenisStopped = true;
      closeBtn.focus({ preventScroll: true });
    };
    // the pill tabs: Email (the form), WhatsApp, Facebook; the panel of the chosen one takes the place of the others
    const select = (name: string, focusTab = false) => {
      tabButtons.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focusTab) t.focus({ preventScroll: true });
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === name;
        p.hidden = !on;
        if (on) {
          p.classList.remove('enter');
          void p.offsetWidth;
          p.classList.add('enter');
        }
      });
      status.textContent = '';
      status.dataset.state = '';
    };

    // copies the address (the clipboard where the browser allows it, the old way where it does not) and says so for a moment
    let copiedTimer = 0;
    const copyAddress = async (btn: HTMLElement) => {
      const text = btn.dataset.copy ?? '';
      let done = false;
      try {
        await navigator.clipboard.writeText(text);
        done = true;
      } catch {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
        document.body.appendChild(area);
        area.select();
        try {
          done = document.execCommand('copy');
        } catch {
          done = false;
        }
        area.remove();
      }
      const action = btn.querySelector<HTMLElement>('.copy-action')!;
      const live = root.querySelector<HTMLElement>('[data-copy-status]')!;
      action.textContent = done ? 'Copied' : 'Select and copy';
      live.textContent = done ? 'Address copied' : '';
      btn.dataset.state = done ? 'ok' : 'error';
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(() => {
        action.textContent = 'Copy';
        btn.dataset.state = '';
        live.textContent = '';
      }, 2200);
    };

    const say = (text: string, state: 'info' | 'ok' | 'error') => {
      status.textContent = text;
      status.dataset.state = state;
    };
    const onSubmit = async (e: SubmitEvent) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      if (data.get('company')) return; // the hidden field a person never fills: a robot did
      const name = String(data.get('name')).trim();
      const email = String(data.get('email')).trim();
      const message = String(data.get('message')).trim();
      if (!CONTACT_FORM.endpoint) {
        // not connected to a service yet: the visitor's own mail app opens with the message written in it (nothing is sent from here)
        const body = `${message}\n\n${name}\n${email}`;
        window.location.href = `mailto:${CONTACT_FORM.to}?subject=${encodeURIComponent(CONTACT_FORM.subject)}&body=${encodeURIComponent(body)}`;
        say('Your mail app is opening with the message written.', 'info');
        return;
      }
      say('Sending…', 'info');
      try {
        const res = await fetch(CONTACT_FORM.endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('Thank you. Your message is on its way.', 'ok');
      } catch {
        say(`It did not go through. Please write to ${CONTACT_FORM.to}.`, 'error');
      }
    };

    const close = () => {
      if (root.hidden || !root.classList.contains('is-open')) return;
      root.classList.remove('is-open');
      document.documentElement.classList.remove('contact-open');
      if (lenisStopped) getLenis()?.start();
      lenisStopped = false;
      hideTimer = window.setTimeout(() => {
        root.hidden = true;
        select('email'); // it opens on the Email tab next time
      }, 1500); // after the stripes have gone down
      opener?.focus?.({ preventScroll: true });
    };

    // any trigger on the page (the menu's Inquire, "Get in touch", the footer's Contact), and the event the menu sends
    const onClick = (e: MouseEvent) => {
      const target = e.target as Element;
      const trigger = target.closest<HTMLElement>('[data-contact-trigger]');
      if (trigger) {
        open(trigger);
        return;
      }
      const copy = target.closest<HTMLElement>('[data-copy]');
      if (copy) {
        void copyAddress(copy);
        return;
      }
      const tab = target.closest<HTMLElement>('[data-tab]');
      if (tab) select(tab.dataset.tab ?? 'email');
      else if (target.closest('[data-contact-close]')) close();
    };
    const onEvent = () => open();
    const onKey = (e: KeyboardEvent) => {
      if (root.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if ((e.key === 'ArrowRight' || e.key === 'ArrowLeft') && document.activeElement?.hasAttribute('data-tab')) {
        // the arrow keys go through the tabs
        e.preventDefault();
        const at = tabButtons.indexOf(document.activeElement as HTMLElement);
        const next = tabButtons[(at + (e.key === 'ArrowRight' ? 1 : -1) + tabButtons.length) % tabButtons.length];
        select(next.dataset.tab ?? 'email', true);
      } else if (e.key === 'Tab') {
        // the focus stays inside the screen
        const items = Array.from(root.querySelectorAll<HTMLElement>('a[href], button, input:not(.cf-trap), textarea')).filter((n) => n.offsetParent !== null);
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    // The on-screen keyboard (phone, tablet) is drawn OVER the page: the layout does not shrink (iOS Safari, and Chrome Android since v108),
    // so the lower fields and the Send button sat behind it. The screen follows the visual viewport (the part that is really visible) while
    // the keyboard is up, and the field being written in is kept in view inside it.
    const vv = window.visualViewport;
    const field = () => {
      const a = document.activeElement as HTMLElement | null;
      return a && form.contains(a) && a.matches('input, textarea') ? a : null;
    };
    const keepInView = () => field()?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    const followViewport = () => {
      if (!vv) return;
      const up = !root.hidden && window.innerHeight - vv.height > 120;
      root.classList.toggle('kb', up);
      if (up) {
        root.style.setProperty('--vv-h', `${vv.height}px`);
        root.style.setProperty('--vv-top', `${vv.offsetTop}px`);
        keepInView();
      } else {
        root.style.removeProperty('--vv-h');
        root.style.removeProperty('--vv-top');
      }
    };
    const onFocusIn = () => {
      window.setTimeout(keepInView, 350); // after the keyboard has come up and the screen has been resized
    };
    vv?.addEventListener('resize', followViewport);
    vv?.addEventListener('scroll', followViewport);
    form.addEventListener('focusin', onFocusIn);

    document.addEventListener('click', onClick);
    form.addEventListener('submit', onSubmit);
    document.addEventListener('open-contact-modal', onEvent);
    document.addEventListener('keydown', onKey);
    return () => {
      vv?.removeEventListener('resize', followViewport);
      vv?.removeEventListener('scroll', followViewport);
      form.removeEventListener('focusin', onFocusIn);
      document.removeEventListener('click', onClick);
      form.removeEventListener('submit', onSubmit);
      document.removeEventListener('open-contact-modal', onEvent);
      document.removeEventListener('keydown', onKey);
      window.clearTimeout(hideTimer);
      window.clearTimeout(copiedTimer);
      if (lenisStopped) getLenis()?.start();
      document.documentElement.classList.remove('contact-open');
    };
  }, '.contact');
</script>

<style>
  /* the site's one curve (HOUSE_EASE in settings.ts): slow start, hard pick-up, long settle */
  .contact {
    --ease: cubic-bezier(0.625, 0.05, 0, 1);
    position: fixed;
    inset: 0;
    z-index: 4000;
    color: var(--cream);
    font-family: var(--font-body);
  }
  .contact[hidden] {
    display: none;
  }
  /* the on-screen keyboard is up: the screen is only the part of the page that is really visible (set from visualViewport, see the script) */
  .contact.kb {
    inset: auto 0 auto 0;
    top: var(--vv-top, 0px);
    height: var(--vv-h, 100%);
  }

  /* the five dark stripes (the colour of the closing screen and the footer): the lowest rises first, the top one last; they sink top first */
  .contact-stripes {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .contact-stripes i {
    flex: 1;
    margin-top: -1px;
    background: #0d0b09;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease) calc(var(--i) * 0.07s);
  }
  .contact.is-open .contact-stripes i {
    transform: scaleY(1);
    transition: transform 0.95s var(--ease) calc((4 - var(--i)) * 0.09s);
  }

  .contact-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    isolation: isolate; /* the phone's backdrop photo (z-index -1) stays inside the screen, over the stripes */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3.4vw, 2.5rem);
    padding-bottom: calc(clamp(1.25rem, 3.4vw, 2.5rem) + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .contact.is-open .contact-stage {
    opacity: 1;
    transition: opacity 0.7s ease 1.1s;
  }

  .contact-head {
    flex: none;
    display: grid;
    /* the same two columns as the body: the name sits over the middle of the photo, the Close word at the right edge */
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .contact-head .contact-close {
    grid-column: 2;
    justify-self: end;
  }
  /* the emblem and the name, in the middle of the top (the name as in the menu's overlay) */
  .contact-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 1.6vw, 1.2rem);
    grid-column: 1;
    justify-self: center;
  }
  .contact-brand :global(img) {
    display: block;
    height: clamp(3.2rem, 5vw, 4.2rem);
    width: auto;
  }
  .contact-brand-text {
    text-align: left;
  }
  .contact-title-brand {
    margin: 0;
    font-family: var(--font-logo, 'Cinzel Decorative', serif);
    font-size: clamp(1.05rem, 2vw, 1.6rem);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.2;
    white-space: nowrap;
    color: #ba8e47; /* the gold of the logo */
  }
  .contact-sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(0.62rem, 1vw, 0.8rem);
    font-weight: 300;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    color: #fff;
  }
  .contact-close {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0 0.7rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .contact-close:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 4px;
  }

  /* letters that slide up to a gold copy (the menu's and the buttons' hover) */
  .contact-close-word,
  .word {
    display: block;
    overflow: hidden;
    white-space: pre;
    line-height: 1.5;
  }
  .lc {
    display: inline-block;
    position: relative;
    transition: transform var(--hover-time, 0.32s) cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--n) * var(--hover-stagger, 0.012s));
  }
  .lc::after {
    content: attr(data-ch);
    position: absolute;
    top: 100%;
    left: 0;
    color: var(--gold);
  }
  @media (hover: hover) {
    .contact-close:hover .lc,
    .contact-close:focus-visible .lc,
    .tab:hover .lc,
    .tab:focus-visible .lc,
    .send:hover .lc,
    .send:focus-visible .lc {
      transform: translateY(-100%);
    }
  }

  .contact-body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-top: clamp(0.5rem, 2vh, 2rem);
  }

  /* the portrait opens from its middle and settles from a zoom, like the photos of the pages */
  .contact-photo {
    margin: 0;
    max-height: 100%;
    justify-self: center;
    width: min(100%, 30rem);
  }
  .contact-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 68vh;
    max-height: 68svh;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 2px;
    clip-path: inset(50% 50% 50% 50%);
    transition: clip-path 0.4s ease;
  }
  .contact-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.3;
    transition: scale 0.4s ease;
  }
  .contact-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--photo-dim, rgba(8, 7, 6, 0.3));
    pointer-events: none;
  }
  .contact.is-open .contact-frame {
    clip-path: inset(0% 0% 0% 0%);
    transition: clip-path 1.5s var(--ease) 1.3s;
  }
  .contact.is-open .contact-frame :global(img) {
    scale: 1;
    transition: scale 2s var(--ease) 1.3s;
  }

  /* the words come up out of their lines */
  .rv {
    display: block;
    overflow: hidden;
  }
  .rv > span {
    display: block;
    transform: translateY(115%);
    transition: transform 0.3s ease;
  }
  .contact.is-open .rv > span {
    transform: none;
    transition: transform 1.1s var(--ease) 1.4s;
  }
  .contact-title {
    margin: 0 0 clamp(1.4rem, 3.2vh, 2.2rem);
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--cream);
  }
  .contact-title :global(em) {
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }

  /* the pill tabs, joined by a thin line (Email, WhatsApp, Facebook) */
  .tabs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: clamp(1.2rem, 2.8vh, 2rem);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .contact.is-open .tabs {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s ease 1.55s, transform 1.1s var(--ease) 1.55s;
  }
  .tab {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    padding: 0.85rem 1.6rem;
    border: 1px solid rgba(239, 233, 220, 0.22);
    border-radius: 999px;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.55);
    transition: border-color var(--hover-time, 0.32s) cubic-bezier(0.65, 0, 0.35, 1), background-color var(--hover-time, 0.32s) ease;
