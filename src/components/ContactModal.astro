---
import { Image } from 'astro:assets';
import kita from '../assets/img/cats/kita.webp'; // placeholder: swap for the real portrait

/**
 * The contact screen every "Inquire" / "Get in touch" / "Contact" opens (anything with data-contact-trigger, and the `open-contact-modal` event of the
 * menu). It is the site's own language, not a dialog box: five dark stripes rise from the bottom one after another and cover the page (the
 * transition of the awards and the home page), then a portrait opens from its middle and the words come up out of their lines. The ways to reach the
 * breeder are large serif names that slide to gold, letter by letter, like the menu and every button. A form can be added as one more row (see `ways`).
 * Closes with Escape, the Close word, or the stripes' own screen. It is in the layout, so every page has it.
 */
// `href` is what the row opens; `note` is the small line beside the name. PLACEHOLDER: a form would be one more row.
const ways = [
  { name: 'WhatsApp', note: '+44 7514 951289', href: 'https://wa.me/447514951289', external: true },
  { name: 'Email', note: 'luxuryrosettes@yahoo.com', href: 'mailto:luxuryrosettes@yahoo.com', external: false },
  { name: 'Facebook', note: 'Luxuryrosettes Bengal cattery', href: 'https://www.facebook.com/people/Luxuryrosettes-Bengal-cattery/100091469460702/', external: true },
];
const STRIPES = 5;
---

<div class="contact" hidden role="dialog" aria-modal="true" aria-labelledby="contact-title">
  <div class="contact-stripes" aria-hidden="true">
    {Array.from({ length: STRIPES }, (_, i) => <i style={`--i:${i}`}></i>)}
  </div>

  <div class="contact-stage">
    <header class="contact-head">
      <p class="contact-brand">Luxury Rosettes</p>
      <button type="button" class="contact-close" aria-label="Close" data-contact-close>
        <span class="contact-close-word" aria-hidden="true">
          {[...'Close'].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}
        </span>
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg>
      </button>
    </header>

    <div class="contact-body">
      <figure class="contact-photo" aria-hidden="true">
        <div class="contact-frame">
          <Image src={kita} alt="" widths={[500, 800, 1100]} sizes="(min-width:769px) 34vw, 100vw" loading="lazy" draggable="false" />
        </div>
        <figcaption class="contact-cap">Bengal cattery</figcaption>
      </figure>

      <div class="contact-main">
        <p class="contact-eyebrow rv"><span>Get in touch</span></p>
        <h2 id="contact-title" class="contact-title rv"><span>Tell us about <em>your Bengal</em></span></h2>
        <ul class="contact-list">
          {
            ways.map((w, i) => (
              <li style={`--i:${i}`}>
                <a href={w.href} target={w.external ? '_blank' : undefined} rel={w.external ? 'noopener noreferrer' : undefined}>
                  <span class="contact-no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="contact-name" aria-hidden="true">
                    {[...w.name].map((ch, n) => <span class="lc" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}
                  </span>
                  <span class="visually-hidden">{w.name}</span>
                  <span class="contact-note">{w.note}</span>
                  <svg class="contact-arrow" width="30" height="12" viewBox="0 0 30 12" fill="none" aria-hidden="true"><path d="M0 6H29M24 1L29 6L24 11" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  import { mount } from '../scripts/lifecycle';
  import { getLenis } from '../scripts/lenis';

  mount(() => {
    const root = document.querySelector<HTMLElement>('.contact');
    if (!root) return;
    const closeBtn = root.querySelector<HTMLButtonElement>('.contact-close')!;
    let opener: HTMLElement | null = null;
    let lenisStopped = false;
    let hideTimer = 0;

    const open = (from?: HTMLElement | null) => {
      if (!root.hidden && root.classList.contains('is-open')) return;
      window.clearTimeout(hideTimer);
      opener = from ?? (document.activeElement as HTMLElement | null);
      root.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('is-open')));
      document.documentElement.classList.add('contact-open');
      getLenis()?.stop();
      lenisStopped = true;
      closeBtn.focus({ preventScroll: true });
    };
    const close = () => {
      if (root.hidden || !root.classList.contains('is-open')) return;
      root.classList.remove('is-open');
      document.documentElement.classList.remove('contact-open');
      if (lenisStopped) getLenis()?.start();
      lenisStopped = false;
      hideTimer = window.setTimeout(() => (root.hidden = true), 1500); // after the stripes have gone down
      opener?.focus?.({ preventScroll: true });
    };

    // any trigger on the page (the menu's Inquire, "Get in touch", the footer's Contact), and the event the menu sends
    const onClick = (e: MouseEvent) => {
      const target = e.target as Element;
      const trigger = target.closest<HTMLElement>('[data-contact-trigger]');
      if (trigger) {
        open(trigger);
        return;
      }
      if (target.closest('[data-contact-close]')) close();
    };
    const onEvent = () => open();
    const onKey = (e: KeyboardEvent) => {
      if (root.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'Tab') {
        // the focus stays inside the screen
        const items = Array.from(root.querySelectorAll<HTMLElement>('a[href], button')).filter((n) => n.offsetParent !== null);
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    document.addEventListener('click', onClick);
    document.addEventListener('open-contact-modal', onEvent);
    document.addEventListener('keydown', onKey);
    return () => {
      document.removeEventListener('click', onClick);
      document.removeEventListener('open-contact-modal', onEvent);
      document.removeEventListener('keydown', onKey);
      window.clearTimeout(hideTimer);
      if (lenisStopped) getLenis()?.start();
      document.documentElement.classList.remove('contact-open');
    };
  }, '.contact');
</script>

<style>
  /* the site's one curve (HOUSE_EASE in settings.ts): slow start, hard pick-up, long settle */
  .contact {
    --ease: cubic-bezier(0.625, 0.05, 0, 1);
    position: fixed;
    inset: 0;
    z-index: 4000;
    color: var(--cream);
    font-family: var(--font-body);
  }
  .contact[hidden] {
    display: none;
  }

  /* the five dark stripes (the colour of the closing screen and the footer): the lowest rises first, the top one last; they sink top first */
  .contact-stripes {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .contact-stripes i {
    flex: 1;
    margin-top: -1px;
    background: #0d0b09;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease) calc(var(--i) * 0.07s);
  }
  .contact.is-open .contact-stripes i {
    transform: scaleY(1);
    transition: transform 0.95s var(--ease) calc((4 - var(--i)) * 0.09s);
  }

  .contact-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    isolation: isolate; /* the phone's backdrop photo (z-index -1) stays inside the screen, over the stripes */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3.4vw, 2.5rem);
    padding-bottom: calc(clamp(1.25rem, 3.4vw, 2.5rem) + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .contact.is-open .contact-stage {
    opacity: 1;
    transition: opacity 0.01s linear 1.15s;
  }

  .contact-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .contact-brand {
    margin: 0;
    font-family: var(--font-logo, 'Cinzel Decorative', serif);
    font-size: clamp(0.9rem, 1.8vw, 1.15rem);
    letter-spacing: 0.06em;
    color: #ba8e47; /* the gold of the logo */
  }
  .contact-close {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0 0.7rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .contact-close:focus-visible,
  .contact-list a:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 4px;
  }

  /* letters that slide up to a gold copy (the menu's and the buttons' hover) */
  .contact-close-word,
  .contact-name {
    display: block;
    overflow: hidden;
    white-space: pre;
  }
  .lc {
    display: inline-block;
    position: relative;
    transition: transform var(--hover-time, 0.32s) cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--n) * var(--hover-stagger, 0.012s));
  }
  .lc::after {
    content: attr(data-ch);
    position: absolute;
    top: 100%;
    left: 0;
    color: var(--gold);
  }
  @media (hover: hover) {
    .contact-close:hover .lc,
    .contact-close:focus-visible .lc,
    .contact-list a:hover .lc,
    .contact-list a:focus-visible .lc {
      transform: translateY(-100%);
    }
  }

  .contact-body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-top: clamp(1.5rem, 4vh, 3rem);
  }

  /* the portrait opens from its middle and settles from a zoom, like the photos of the pages */
  .contact-photo {
    margin: 0;
    max-height: 100%;
    justify-self: center;
    width: min(100%, 30rem);
  }
  .contact-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 68vh;
    max-height: 68svh;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 2px;
    clip-path: inset(50% 50% 50% 50%);
    transition: clip-path 0.4s ease;
  }
  .contact-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.3;
    transition: scale 0.4s ease;
  }
  .contact-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--photo-dim, rgba(8, 7, 6, 0.3));
    pointer-events: none;
  }
  .contact.is-open .contact-frame {
    clip-path: inset(0% 0% 0% 0%);
    transition: clip-path 1.5s var(--ease) 1.3s;
  }
  .contact.is-open .contact-frame :global(img) {
    scale: 1;
    transition: scale 2s var(--ease) 1.3s;
  }
  .contact-cap {
    margin-top: 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .contact.is-open .contact-cap {
    opacity: 0.85;
    transition: opacity 1s ease 1.95s;
  }

  /* the words come up out of their lines */
  .rv {
    display: block;
    overflow: hidden;
  }
  .rv > span {
    display: block;
    transform: translateY(115%);
    transition: transform 0.3s ease;
  }
  .contact.is-open .rv > span {
    transform: none;
    transition: transform 1.1s var(--ease) 1.4s;
  }
  .contact-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .contact-eyebrow::before {
    content: '';
    width: 2.5rem;
    border-top: 1px solid var(--gold);
  }
  .contact-title {
    margin: 0 0 clamp(1.6rem, 4.5vh, 3rem);
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--cream);
  }
  .contact-title :global(em) {
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }
  /* the eyebrow holds a rule and a word: the mask wraps the word only */
  .contact-eyebrow.rv {
    overflow: visible;
  }
  .contact-eyebrow.rv > span {
    overflow: hidden;
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px dashed rgba(239, 233, 220, 0.28);
  }
  .contact-list li {
    border-bottom: 1px dashed rgba(239, 233, 220, 0.28);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .contact.is-open .contact-list li {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s ease calc(1.55s + var(--i) * 0.08s), transform 1.1s var(--ease) calc(1.55s + var(--i) * 0.08s);
  }
  .contact-list a {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto auto;
    align-items: center;
    column-gap: 1.2rem;
    padding: clamp(0.9rem, 2.2vh, 1.4rem) 0;
    color: inherit;
    text-decoration: none;
  }
  .contact-no {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    opacity: 0.85;
  }
  .contact-name {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.8vw, 3.2rem);
    line-height: 1.15;
    color: var(--cream);
  }
  .contact-note {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    opacity: 0.6;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .contact-arrow {
    color: var(--cream);
    transition: transform 0.5s var(--ease), color 0.35s ease;
  }
  @media (hover: hover) {
    .contact-list a:hover .contact-arrow,
    .contact-list a:focus-visible .contact-arrow {
      color: var(--gold);
      transform: translateX(8px);
    }
    .contact-list a:hover .contact-note {
      opacity: 0.9;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* the page does not scroll behind the screen */
  :global(html.contact-open),
  :global(html.contact-open body) {
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .contact-body {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0;
    }
    /* a tablet or a phone: the portrait is a dim backdrop behind the words, not a column */
    .contact-photo {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      justify-self: stretch;
      max-height: none;
    }
    .contact-frame {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      max-height: none;
      opacity: 0.3;
    }
    .contact-cap {
      display: none;
    }
    .contact-title {
      font-size: clamp(2.4rem, 11vw, 3.4rem);
    }
    .contact-list a {
      grid-template-columns: 1.8rem 1fr auto;
      grid-template-areas: 'no name arrow' '. note arrow';
      row-gap: 0.15rem;
    }
    .contact-no {
      grid-area: no;
    }
    .contact-name {
      grid-area: name;
      font-size: clamp(1.9rem, 8.5vw, 2.6rem);
    }
    .contact-note {
      grid-area: note;
      text-align: left;
      font-size: 0.74rem;
    }
    .contact-arrow {
      grid-area: arrow;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-stripes i,
    .contact-stage,
    .contact-frame,
    .contact-frame :global(img),
    .contact-cap,
    .rv > span,
    .contact-list li {
      transition: none !important;
    }
  }
</style>
