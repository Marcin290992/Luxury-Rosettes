---
import { Image } from 'astro:assets';
import about from '../assets/img/story/about.webp';
import parent from '../assets/img/story/champion-parent.webp';
import standards from '../assets/img/story/our-standards.webp';
import care from '../assets/img/story/premium-care.webp';
import kittens from '../assets/img/story/our-kittens.webp';
import plaque from '../assets/img/story/awards.webp';
import bis from '../assets/img/story/award4.webp';
import award1 from '../assets/img/story/award1.webp';
import award2 from '../assets/img/story/award2.webp';
import award6 from '../assets/img/story/award6.webp';
import finale from '../assets/img/kittens.webp';

// Copy taken from the previous site — to be updated
const items = [
  { img: about, eyebrow: 'Our story', title: 'Fifteen years of Bengals', text: 'It began with a gift from my husband and became a lifelong passion. We do not just breed Bengals. We live with them, love them and admire them every day.' },
  { img: parent, eyebrow: 'Bloodlines', title: 'Champion parents', text: 'Carefully selected champions with exceptional pedigrees. TICA registered, with proven show records.' },
  { img: standards, eyebrow: 'Standards', title: 'Exceptional standards', text: 'Spectacular rosettes, muscular builds and a captivating wild appearance, true to the breed standard.' },
  { img: care, eyebrow: 'Care', title: 'Premium care & health', text: 'Comprehensive veterinary care, premium nutrition and early socialisation. Health guarantees and lifetime breeder support.' },
  { img: kittens, eyebrow: 'Kittens', title: 'Raised with love', text: 'Born in our family home, well socialised and ready to become a cherished member of your family.' },
  { img: plaque, eyebrow: 'Bengal Cat Association', title: 'Official recognition', text: 'Brown (Black) Spotted Male Adult — one of many awards from the Bengal Cat Association.' },
  { img: bis, eyebrow: 'Show ring', title: 'Overall Best in Show Bengal 2024', text: 'First Place in multiple classes, Best of Breed and Best in Show Adult.' },
  { img: award1, eyebrow: 'Show ring', title: 'Best of Breed', text: 'Rosettes and ribbons earned in front of international judges.' },
  { img: award2, eyebrow: 'Show ring', title: 'Proven excellence', text: 'Recognised in the show hall and respected within the wider Bengal community.' },
  { img: award6, eyebrow: 'Show ring', title: 'A cat of proven quality', text: 'Every family welcomes a Bengal of outstanding quality and proven excellence.' },
];
---

<section class="cor" id="corridor" aria-label="Our story and awards">
  <div class="cor-track">
    <div class="cor-stage">
      <div class="cor-intro">
        <p class="cor-eyebrow">Our story &amp; awards</p>
        <h2>A passion<br />worth showing</h2>
      </div>

      {
        items.map((it) => (
          <figure class="cor-item">
            <div class="cor-frame">
              <Image src={it.img} alt={it.title} widths={[500, 800, 1100]} sizes="(min-width:1024px) 30vw, 90vw" loading="lazy" draggable="false" />
            </div>
            <figcaption class="cor-cap">
              <p class="cor-eyebrow">{it.eyebrow}</p>
              <h3>{it.title}</h3>
              <p class="cor-text">{it.text}</p>
            </figcaption>
          </figure>
        ))
      }

      <div class="cor-finale">
        <Image class="cor-finale-img" src={finale} alt="Bengal kittens" widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" />
        <div class="cor-finale-scrim"></div>
        <div class="cor-finale-copy">
          <p class="cor-eyebrow">Your Bengal awaits</p>
          <h2>Meet your Bengal</h2>
          <p class="cor-finale-text">Placeholder text. A calm sentence or two about the next litter and how to reserve a kitten.</p>
          <div class="cor-ctas">
            <a class="cor-cta cor-cta--solid" href="#">View available kittens</a>
            <a class="cor-cta" href="#">Join the waiting list</a>
          </div>
        </div>
      </div>

      <div class="cor-progress" aria-hidden="true">
        <div class="cor-line"><div class="cor-fill"></div></div>
        <span class="cor-count">01</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { createDolly, type Dolly } from '../scripts/dolly-gallery';
  import { clamp, smoothstep as smooth } from '../scripts/math';
  import { CORRIDOR_PHONE_KEEP, CORRIDOR_SPACING, CORRIDOR_LEAD, CORRIDOR_PX_PER_STEP, CORRIDOR as C } from '../scripts/settings';


  const section = document.getElementById('corridor')!;
  const stage = section.querySelector<HTMLElement>('.cor-stage')!;
  const allTiles = Array.from(section.querySelectorAll<HTMLElement>('.cor-item'));
  const intro = section.querySelector<HTMLElement>('.cor-intro')!;
  const fill = section.querySelector<HTMLElement>('.cor-fill')!;
  const progress = section.querySelector<HTMLElement>('.cor-progress')!;
  const count = section.querySelector<HTMLElement>('.cor-count')!;
  const fin = section.querySelector<HTMLElement>('.cor-finale')!;
  const finImg = section.querySelector<HTMLElement>('.cor-finale-img')!;
  const finScrim = section.querySelector<HTMLElement>('.cor-finale-scrim')!;
  const finCopy = section.querySelector<HTMLElement>('.cor-finale-copy')!;
  const finCtas = section.querySelector<HTMLElement>('.cor-ctas')!;

  const PHONE_KEEP = CORRIDOR_PHONE_KEEP; // the others are hidden while the corridor runs on a phone
  const SPACING = CORRIDOR_SPACING;
  const LEAD = CORRIDOR_LEAD;
  const { ink: INK, paper: PAPER, white: WHITE, black: BLACK } = C.colors;

  let dolly: Dolly | undefined;
  let onScroll: (() => void) | undefined;

  // Plain sticky pin: the section is taller than the screen and the stage sticks while the page scrolls past.
  // The scroll position only sets the camera target; the dolly eases towards it.
  const start = (phone: boolean) => {
    const tiles = phone ? PHONE_KEEP.map((k) => allTiles[k]) : allTiles;
    allTiles.forEach((t) => { if (!tiles.includes(t)) t.hidden = true; });
    const items = tiles.length;
    const PX_PER_STEP = phone ? CORRIDOR_PX_PER_STEP.phone : CORRIDOR_PX_PER_STEP.laptop;
    // Finale, in steps from the first photo (the last photo is in place at items - 1): first the words arrive on the
    // paper, then they turn white as the kittens photo fades in and everything goes dark.
    const TEXT_IN = C.textIn.map((v) => items + v);
    const DARKEN = C.darken.map((v) => items + v);
    const END_AT = items + C.endAfter;
    const dollyLook = phone ? C.dolly.phone : C.dolly.laptop;
    const MIN = -LEAD * SPACING;
    const MAX = END_AT * SPACING;

    const travel = (END_AT + LEAD) * PX_PER_STEP;
    section.style.setProperty('--cor-travel', `${travel}px`);
    section.dataset.pinned = '';
    if (phone) section.dataset.phone = '';

    dolly = createDolly(stage, tiles, {
      // phones: the photo is as wide as the screen allows and no taller than ~half of what is visible
      itemWidth: 'width' in dollyLook
        ? Math.min(window.innerWidth * dollyLook.width, window.innerHeight * dollyLook.height)
        : Math.min(dollyLook.maxWidth, window.innerHeight * dollyLook.height),
      ...('aspectRatio' in dollyLook ? { aspectRatio: dollyLook.aspectRatio, perspective: dollyLook.perspective } : {}), // (undefined would overwrite the engine's defaults)
      spacing: SPACING,
      spread: dollyLook.spread,
      scatter: dollyLook.scatter,
      revealRange: dollyLook.revealRange, // phones: the upcoming photo is nearly solid, not a ghost
      passRange: dollyLook.passRange, // phones: the photo that has passed the camera is gone quickly ...
      passHold: dollyLook.passHold,
      lead: LEAD,
      tail: END_AT - (items - 1),
      grayscale: 0,
      // the title leaves first; only then do the photos fade in, so the two never overlap
      gate: (offset) => smooth(C.gate[0], C.gate[1], offset / SPACING),
      onIndexChange: (i) => {
        count.textContent = String(Math.min(i, items - 1) + 1).padStart(2, '0');
      },
      onFrame: (offset) => {
        const e = offset / SPACING;
        intro.style.opacity = (1 - smooth(-LEAD + C.intro.fadeStart, C.intro.fadeEnd, e)).toFixed(3);
        intro.style.transform = `scale(${(1 + clamp((e + LEAD) / C.intro.grow, 0, 1) * C.intro.scale).toFixed(3)})`;
        fill.style.clipPath = `inset(0% ${((1 - clamp((offset - MIN) / (MAX - MIN), 0, 1)) * 100).toFixed(2)}% 0% 0%)`;
        const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(',');
        const at = offset / SPACING;
        const textIn = smooth(TEXT_IN[0], TEXT_IN[1], at);
        const dark = smooth(DARKEN[0], DARKEN[1], at);
        // the words first, in ink on the paper...
        fin.style.visibility = textIn > 0 ? 'visible' : 'hidden';
        finCopy.style.opacity = textIn.toFixed(3);
        finCopy.style.transform = `translate3d(0, ${((1 - textIn) * C.rise.copy).toFixed(1)}px, 0)`;
        finCopy.style.pointerEvents = textIn > C.interactiveAt ? 'auto' : 'none';
        // ...then they turn white while the photo fades in and the lights go down
        finCopy.style.setProperty('--fg', `rgb(${mix(INK, WHITE, dark)})`);
        finCopy.style.setProperty('--inv', `rgb(${mix(WHITE, INK, dark)})`);
        // the buttons only arrive once the photo is there
        const ctaIn = smooth(DARKEN[0] + C.ctaFrom * (DARKEN[1] - DARKEN[0]), DARKEN[1] + C.ctaPad, at);
        finCtas.style.opacity = ctaIn.toFixed(3);
        finCtas.style.transform = `translate3d(0, ${((1 - ctaIn) * C.rise.ctas).toFixed(1)}px, 0)`;
        finCtas.style.pointerEvents = ctaIn > C.interactiveAt ? 'auto' : 'none';
        finImg.style.opacity = dark.toFixed(3);
        finImg.style.transform = `scale(${(1 + C.finale.zoom * (1 - dark)).toFixed(4)})`;
        finScrim.style.opacity = (C.finale.scrim * dark).toFixed(3);
        stage.style.backgroundColor = `rgb(${mix(PAPER, BLACK, dark)})`;
        progress.style.opacity = (1 - smooth(TEXT_IN[0], TEXT_IN[1], at)).toFixed(3);
      },
    });

    onScroll = () => {
      const d = dolly!;
      const rect = section.getBoundingClientRect();
      const p = clamp(-rect.top / travel, 0, 1);
      d.setTarget(d.min + p * (d.max - d.min));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  };

  const stop = () => {
    if (onScroll) {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }
    dolly?.destroy();
    dolly = undefined;
    onScroll = undefined;
    delete section.dataset.pinned;
    delete section.dataset.phone;
    allTiles.forEach((t) => (t.hidden = false));
    section.style.removeProperty('--cor-travel');
    [stage, intro, fill, progress, fin, finImg, finScrim, finCopy, finCtas].forEach((el) => el.removeAttribute('style'));
  };

  // The corridor runs whenever motion is allowed: the full version on laptops, a portrait version on phones and tablets.
  // With reduced motion the photos simply stack.
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const wide = window.matchMedia('(min-width: 1024px)');
  let mode: 'wide' | 'phone' | null = null;
  const sync = () => {
    const next = motion.matches ? (wide.matches ? 'wide' : 'phone') : null;
    if (next === mode) return;
    stop();
    mode = next;
    if (mode) start(mode === 'phone');
  };
  motion.addEventListener('change', sync);
  wide.addEventListener('change', sync);
  sync();
</script>

<style>
  .cor {
    background: var(--paper);
    font-family: var(--font-heading);
    color: var(--ink);
    position: relative;
    z-index: 4;
  }
  .cor-stage {
    padding: clamp(4rem, 10vh, 7rem) 1.5rem 3rem;
    display: grid;
    gap: 3rem;
  }
  .cor-intro {
    text-align: center;
  }
  .cor-intro h2 {
    font-size: clamp(2.4rem, 9vw, 3.5rem);
    font-weight: 400;
    line-height: 1.02;
    margin: 0;
  }
  .cor-eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1rem;
    opacity: 0.6;
  }
  .cor-item {
    margin: 0;
  }
  .cor-frame {
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 4 / 5;
    background: var(--placeholder);
  }
  .cor-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cor-cap {
    padding-top: 1rem;
  }
  .cor-cap h3 {
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }
  .cor-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.75;
  }
  .cor-progress {
    display: none;
  }

  /* finale: the kittens photo with the call to action (stacked on mobile, full-screen on desktop) */
  .cor-finale {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 4 / 5;
    color: #fff;
  }
  .cor-finale :global(.cor-finale-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cor-finale-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.55));
    opacity: 0.8;
  }
  .cor-finale-copy {
    --fg: #fff;
    --inv: var(--ink);
    color: var(--fg);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8%;
  }
  .cor-finale-copy h2 {
    font-size: clamp(2.4rem, 8vw, 3.5rem);
    font-weight: 400;
    line-height: 1.02;
    margin: 0 0 1rem;
  }
  .cor-finale-text {
    max-width: 34rem;
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0 0 2rem;
  }
  .cor-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .cor-cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--fg) 60%, transparent);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.3s, color 0.3s;
  }
  .cor-cta:hover {
    background: var(--fg);
    color: var(--inv);
  }
  .cor-cta--solid {
    background: var(--fg);
    color: var(--inv);
  }
  .cor-cta--solid:hover {
    background: transparent;
    color: var(--fg);
  }
  .cor-finale-copy .cor-eyebrow {
    color: var(--fg);
  }

  /* ---- Desktop: sticky corridor (script sets data-pinned) ---- */
  .cor[data-pinned] {
    --bar: calc(100vh - 100svh);
    --bar: calc(100lvh - 100svh);
  }
  .cor[data-pinned] .cor-track {
    height: calc(100vh + var(--cor-travel));
    height: calc(100lvh + var(--cor-travel)); /* lvh: constant when the mobile address bar slides away */
  }
  .cor[data-pinned] .cor-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    padding: 0;
    overflow: hidden;
    display: block;
    perspective: 1000px;
    touch-action: pan-y;
  }
  .cor[data-pinned] .cor-intro {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100svh; /* centred on what is visible while the address bar is up */
    display: grid;
    place-content: center;
    will-change: transform, opacity;
  }
  .cor[data-pinned] .cor-intro h2 {
    font-size: clamp(2.8rem, 6vw, 6rem);
  }
  .cor[data-pinned] .cor-item {
    position: absolute;
    left: 50%;
    top: 43vh;
    top: 43svh;
    will-change: transform, opacity;
    visibility: hidden;
    backface-visibility: hidden;
  }
  .cor[data-pinned] .cor-frame {
    height: 100%;
    aspect-ratio: auto;
  }
  .cor[data-pinned] .cor-cap {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    /* captions only read when their photo is near the camera */
    opacity: calc(var(--a, 0) * var(--a, 0));
  }
  .cor[data-pinned] .cor-cap h3 {
    font-size: clamp(1.4rem, 2vw, 2.2rem);
  }
  .cor[data-pinned] .cor-progress {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    position: absolute;
    left: 4.5vw;
    bottom: calc(5vh + var(--bar, 0px));
    z-index: 200;
    font-family: var(--font-body);
    font-size: 0.75rem;
  }
  .cor[data-pinned] .cor-finale {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    z-index: 20000;
    visibility: hidden;
    pointer-events: none;
  }
  .cor[data-pinned] .cor-finale :global(.cor-finale-img) {
    opacity: 0;
    will-change: transform, opacity;
  }
  .cor[data-pinned] .cor-finale-scrim {
    opacity: 0;
  }
  .cor[data-pinned] .cor-ctas {
    opacity: 0;
    pointer-events: none;
  }
  .cor[data-pinned] .cor-finale-copy {
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100svh;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .cor[data-pinned] .cor-finale-copy h2 {
    font-size: clamp(2.8rem, 6vw, 6rem);
  }
  /* ---- Phones and tablets (script adds data-phone) ---- */
  .cor[data-phone] .cor-progress {
    left: 8vw;
    gap: 1rem;
  }
  .cor[data-phone] .cor-line {
    width: min(14rem, 52vw);
  }
  .cor[data-phone] .cor-cap {
    padding: 0 0.25rem;
    /* ... and the caption of the photo coming up is readable early (desktop: opacity = a squared) */
    opacity: min(1, calc(var(--a, 0) * 1.7));
  }
  .cor[data-phone] .cor-cap h3 {
    font-size: clamp(1.35rem, 5.4vw, 2rem);
    margin-bottom: 0.3rem;
  }
  /* one line of detail under each photo; the long copy stays in the markup for screen readers */
  .cor[data-phone] .cor-text {
    font-size: 0.8rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cor[data-phone] .cor-cap .cor-eyebrow {
    margin-bottom: 0.4rem;
    font-size: 0.65rem;
  }
  .cor[data-phone] .cor-finale-copy {
    padding: 0 8vw;
  }
  .cor[data-phone] .cor-finale-copy h2 {
    font-size: clamp(2.3rem, 10vw, 3.6rem);
  }
  .cor-line {
    position: relative;
    width: 18rem;
    height: 0;
    border-top: var(--dash-track);
  }
  .cor-fill {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: var(--dash-strong);
    clip-path: inset(0% 100% 0% 0%);
  }
</style>
