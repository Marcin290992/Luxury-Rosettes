---
// Hard-coded for now; later this comes from the CMS
import { faqs } from '../data/faqs';
import LetterButton from './LetterButton.astro';

// each sentence is its own line of the answer, so the answer writes itself in line by line
const lines = (text: string) => text.split(/(?<=[.!?])\s+/);
---

<section class="faq" id="faq">
  <div class="faq-head">
    <p class="eyebrow" data-reveal>Before you decide</p>
    <h2 data-reveal>Questions, answered</h2>
  </div>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <div class="faq-item">
          <div class="faq-row faq-question-slot">
            <div class="faq-question faq-message">
              <div class="typing-indicator" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="faq-content">
                <p>{f.q}</p>
              </div>
            </div>
          </div>
          <div class="faq-row faq-answer-slot">
            <div class="faq-answer faq-message">
              <div class="typing-indicator" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="faq-content">
                {lines(f.a).map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
    <!-- the last message of the chat: from us, with the ways to ask a question directly -->
    <div class="faq-item">
      <div class="faq-row faq-answer-slot">
        <div class="faq-answer faq-message">
          <div class="typing-indicator" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="faq-content">
            <p>Still have a question? Ask us directly, we answer personally.</p>
            <p class="faq-actions">
              <LetterButton label="Get in touch" contact solid />
              <LetterButton label="WhatsApp" href="https://wa.me/447514951289" />
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initFaqChat } from '../scripts/faq-chat';

  mount(() => {
    const root = document.getElementById('faq')!;
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    let destroy: (() => void) | undefined;

    // runs whenever motion is allowed (and follows the setting if it changes while the page is open)
    const sync = () => {
      destroy?.();
      destroy = undefined;
      delete root.dataset.live;
      if (motion.matches) {
        root.dataset.live = '';
        destroy = initFaqChat(root);
      }
    };
    motion.addEventListener('change', sync);
    sync();

    return () => {
      motion.removeEventListener('change', sync);
      destroy?.();
      delete root.dataset.live;
    };
  }, '#faq');
</script>

<style>
  .faq {
    background: var(--paper);
    color: var(--ink);
    padding: var(--space) 1.5rem;
    max-width: 56rem;
    margin: 0 auto;
  }
  .faq-head {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  /* the same type as the "Meet your Bengal" finale */
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 3.5rem);
    line-height: 1.02;
    margin: 0;
  }

  /* the conversation: questions from the left, answers from the right */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-row {
    display: flex;
    align-items: flex-start;
    /* the bubble grows inside a row that already holds its full height: its layout does not reach the rest of the page */
    contain: layout;
  }
  .faq-answer-slot {
    justify-content: flex-end;
  }
  .faq-message {
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    max-width: 82%;
    padding: 1.25rem 1.75rem;
    border-radius: 1.5rem;
  }
  .faq-question {
    background: var(--cream);
    border: 1px solid rgba(26, 26, 26, 0.12);
    border-bottom-left-radius: 0.35rem;
  }
  .faq-answer {
    background: var(--ink-warm);
    color: var(--cream);
    border: 1px solid rgba(212, 175, 55, 0.45);
    border-bottom-right-radius: 0.35rem;
  }
  .faq-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: max-content;
    max-width: 100%;
  }
  .faq-content p {
    margin: 0;
    text-align: left;
  }
  .faq-question p {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.25;
  }
  .faq-answer p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.75;
    opacity: 0.88;
  }

  /* the buttons under the last message (a paragraph, so the script fades them in with the text) */
  .faq-answer p.faq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
    opacity: 1;
  }

  /* only while the script runs: the bubble starts as a dot with typing dots */
  .typing-indicator {
    display: none;
  }
  .faq[data-live] .typing-indicator {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    pointer-events: none;
  }
  .typing-indicator span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ink);
    animation: typing-pulse 1s infinite ease-in-out;
  }
  .faq-answer .typing-indicator span {
    background: var(--gold);
  }
  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes typing-pulse {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.25rem);
    }
  }

  @media (max-width: 768px) {
    .faq-message {
      max-width: 92%;
      padding: 1.1rem 1.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typing-indicator span {
      animation: none;
    }
  }
</style>
