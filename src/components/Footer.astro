---
import emblem from '../assets/logo/logo-emblem.svg';
---

<footer class="foot" data-footer>
  <div class="foot-in" data-footer-content>
    <div class="mid">
      <img class="emblem" src={emblem.src} alt="" width="120" height="120" loading="lazy" />
      <a class="mail" href="mailto:luxuryrosettes@yahoo.com">luxuryrosettes@yahoo.com</a>
      <div class="social">
        <a href="https://www.facebook.com/people/Luxuryrosettes-Bengal-cattery/100091469460702/" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://www.instagram.com/luxuryrosettes" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://wa.me/447514951289" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
    <div class="bottom">
      <nav aria-label="Footer navigation">
        <a href="/#why-bengals">About</a>
        <a href="/available-kittens">Kittens</a>
        <a href="/gallery">Gallery</a>
        <button type="button" data-contact-trigger>Contact</button>
      </nav>
      <p class="copy">© 2025 Luxury Rosettes · TICA registered Bengal cattery</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    color: var(--cream);
    font-family: var(--font-body);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    padding: 0 1.5rem;
  }
  .foot-in {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30svh 0 2.5rem; /* the top part sits over the photo's lower edge while it is still visible */
  }
  .mid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .emblem {
    width: clamp(5.5rem, 14vw, 9rem);
    height: auto;
    opacity: 0.9;
    margin-bottom: 2.25rem;
  }
  .mail {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 6.4vw, 4.5rem);
    line-height: 1.05;
    color: var(--cream);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--hover-time, 0.3s);
  }
  .mail:hover,
  .mail:focus-visible {
    color: var(--gold);
  }
  .social,
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }
  .social {
    justify-content: center;
    margin-top: 2.25rem;
  }
  .social a,
  nav a,
  nav button {
    all: unset;
    cursor: pointer;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: rgba(239, 233, 220, 0.65);
    transition: color var(--hover-time, 0.3s);
  }
  .social a:hover,
  nav a:hover,
  nav button:hover,
  .social a:focus-visible,
  nav a:focus-visible,
  nav button:focus-visible {
    color: var(--gold);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed rgba(239, 233, 220, 0.25);
    margin-top: 3rem;
  }
  /* the smallest phones (iPhone SE, 320-380px): the address must fit on one line */
  @media (max-width: 380px) {
    .mail {
      font-size: 1.45rem;
    }
    .bottom {
      justify-content: center;
      text-align: center;
    }
  }
  .copy {
    font-size: 0.7rem;
    opacity: 0.45;
    margin: 0;
  }
</style>
