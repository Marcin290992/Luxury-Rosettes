---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The gallery's opening: one screen with a lot going on (it stands still, sticky, for the screens in which the page's stripes rise over it):
 *  - the photo behind drifts slowly all the time,
 *  - the title's letters rise one after another out of a mask,
 *  - small framed photos come up and then float (each at its own pace),
 *  - a big outlined word runs slowly along the bottom,
 *  - on a desktop the layers follow the pointer a little (script below).
 * With reduced motion everything simply stands at rest.
 */
interface Props {
  title: string;
  image: ImageMetadata;
  alt?: string;
  eyebrow?: string;
  marquee?: string;
  photos?: { src: ImageMetadata; alt: string }[];
}
const { title, image, alt = '', eyebrow = 'Luxury Rosettes', marquee = 'Bengal · Rosettes · Gold · Wild at heart', photos = [] } = Astro.props;
const letters = Array.from(title);
const floaters = photos.slice(0, 4);
---

<section class="gh" data-gallery-hero>
<div class="gh-stage">
  <div class="gh-layer gh-bg" data-depth="12">
    <div class="gh-media">
      <Image src={image} alt={alt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" draggable="false" />
    </div>
  </div>
  <div class="gh-scrim" aria-hidden="true"></div>

  <div class="gh-floats" aria-hidden="true">
    {
      floaters.map((p, i) => (
        <div class={`gh-layer gh-float gh-f${i + 1}`} data-depth={i % 2 ? -26 : 34}>
          <figure style={`--i:${i}`}>
            <Image src={p.src} alt="" widths={[500, 800, 1200]} sizes="(min-width:769px) 20vw, 48vw" loading="eager" draggable="false" />
          </figure>
        </div>
      ))
    }
  </div>

  <div class="gh-text">
    <p class="gh-eyebrow"><i></i>{eyebrow}<i></i></p>
    <h1 class="gh-title" aria-label={title}>
      {
        letters.map((c, i) => (
          <span class="gh-mask" aria-hidden="true">
            <span class="gh-letter" style={`--i:${i}`}>{c}</span>
          </span>
        ))
      }
    </h1>
  </div>

  <div class="gh-marquee" aria-hidden="true">
    <div class="gh-run">
      <span>{marquee}&nbsp;·&nbsp;{marquee}&nbsp;·&nbsp;</span><span>{marquee}&nbsp;·&nbsp;{marquee}&nbsp;·&nbsp;</span>
    </div>
  </div>
  <div class="gh-cue" aria-hidden="true"><span></span></div>
</div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';

  // desktop only: the layers follow the pointer a little (each by its own depth). Transform only, and only while the pointer is over the screen.
  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-gallery-hero]');
    if (!root || !matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;
    const layers = Array.from(root.querySelectorAll<HTMLElement>('.gh-layer'));
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;
    const frame = () => {
      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      for (const el of layers) {
        const d = Number(el.dataset.depth) || 0;
        el.style.translate = `${(x * d).toFixed(2)}px ${(y * d).toFixed(2)}px`;
      }
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.002 ? requestAnimationFrame(frame) : 0;
    };
    const move = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
      if (!raf) raf = requestAnimationFrame(frame);
    };
    const leave = () => {
      tx = ty = 0;
      if (!raf) raf = requestAnimationFrame(frame);
    };
    root.addEventListener('pointermove', move);
    root.addEventListener('pointerleave', leave);
    return () => {
      cancelAnimationFrame(raf);
      root.removeEventListener('pointermove', move);
      root.removeEventListener('pointerleave', leave);
    };
  }, '[data-gallery-hero]');
</script>

<style>
  /* the section is longer than the screen: its last screens are where the page's stripes rise over the opening, which stands still (sticky) */
  .gh {
    position: relative;
    width: 100%;
    height: calc(4 * 100vh);
    height: calc(4 * 100svh);
    background: var(--ink, #0d0b09);
    color: var(--cream, #efe9dc);
  }
  .gh-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .gh-layer {
    will-change: translate;
  }
  .gh-bg {
    position: absolute;
    inset: -3%; /* a little more than the screen, so the layer can move without showing an edge */
  }
  .gh-media {
    position: absolute;
    inset: 0;
    animation:
      gh-settle 2.8s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      gh-drift 22s 2.8s ease-in-out infinite alternate;
  }
  .gh-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .gh-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, rgba(13, 11, 9, 0.1), rgba(13, 11, 9, 0.5) 85%),
      linear-gradient(to top, rgba(13, 11, 9, 0.55), transparent 45%);
  }

  /* the small photos */
  .gh-floats {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .gh-float {
    position: absolute;
    width: clamp(7.5rem, 17vw, 17rem);
  }
  .gh-float figure {
    margin: 0;
    padding: 0.35rem;
    background: var(--cream, #efe9dc);
    border-radius: 6px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
    opacity: 0;
    animation:
      gh-in 1.3s calc(1.1s + var(--i) * 0.22s) cubic-bezier(0.2, 0.7, 0.2, 1) forwards,
      gh-bob calc(5.5s + var(--i) * 1.1s) calc(2.6s + var(--i) * 0.22s) ease-in-out infinite alternate;
  }
  .gh-float :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }
  .gh-f1 { left: 7%; top: 16%; }
  .gh-f2 { right: 8%; top: 12%; width: clamp(6.5rem, 14vw, 14rem); }
  .gh-f3 { left: 15%; bottom: 20%; width: clamp(6rem, 12vw, 12rem); }
  .gh-f4 { right: 14%; bottom: 17%; }
  .gh-f1 figure { --r: -5deg; }
  .gh-f2 figure { --r: 4deg; }
  .gh-f3 figure { --r: 3deg; }
  .gh-f4 figure { --r: -3deg; }

  /* the title */
  .gh-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
    padding: 0 1.5rem;
    text-align: center;
    pointer-events: none;
  }
  .gh-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.9);
    animation: gh-rise 1.1s 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .gh-eyebrow i {
    display: block;
    width: 2.6rem;
    height: 1px;
    background: var(--gold, #d4af37);
    transform-origin: left;
    animation: gh-line 1.2s 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  .gh-eyebrow i:last-child {
    transform-origin: right;
  }
  .gh-title {
    display: flex;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(3.6rem, 13vw, 11rem);
    line-height: 1.12;
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.35);
  }
  .gh-mask {
    display: block;
    overflow: hidden;
    padding: 0 0.01em 0.12em;
  }
  .gh-letter {
    display: block;
    animation: gh-letter 1.3s calc(0.6s + var(--i) * 0.09s) cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* the big word along the bottom */
  .gh-marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(1.4rem + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    pointer-events: none;
    animation: gh-fade 1.2s 1.4s both;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
  }
  .gh-run {
    display: flex;
    width: max-content;
    animation: gh-run 40s linear infinite;
  }
  .gh-run span {
    flex: none;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6.5vw, 5.5rem);
    line-height: 1.1;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(239, 233, 220, 0.55);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .gh-cue {
    position: absolute;
    right: 1.6rem;
    bottom: calc(7.5rem + env(safe-area-inset-bottom, 0px));
    width: 1px;
    height: 3.2rem;
    overflow: hidden;
    background: rgba(239, 233, 220, 0.25);
    pointer-events: none;
    animation: gh-fade 1s 1.8s both;
  }
  .gh-cue span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--cream, #efe9dc);
    animation: gh-draw 2.2s 2s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }

  @keyframes gh-settle { from { transform: scale(1.2); } to { transform: scale(1.05); } }
  @keyframes gh-drift { from { transform: scale(1.05) translate3d(-1%, 0, 0); } to { transform: scale(1.12) translate3d(1.2%, -1%, 0); } }
  @keyframes gh-rise { from { opacity: 0; transform: translateY(0.8rem); } to { opacity: 1; transform: none; } }
  @keyframes gh-line { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes gh-letter { from { transform: translateY(110%) rotate(6deg); } to { transform: none; } }
  @keyframes gh-in { from { opacity: 0; transform: translateY(5rem) rotate(var(--r, -4deg)) scale(0.92); } to { opacity: 1; transform: rotate(var(--r, -4deg)); } }
  @keyframes gh-bob { from { translate: 0 -0.7rem; rotate: -1.2deg; } to { translate: 0 0.9rem; rotate: 1.4deg; } }
  @keyframes gh-run { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes gh-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes gh-draw { from { transform: translateY(-100%); } 60%, to { transform: translateY(100%); } }

  /* phone: fewer, smaller photos kept to the edges */
  @media (max-width: 768px) {
    .gh-f3, .gh-f4 { display: none; }
    .gh-f1 { left: 5%; top: 15%; width: 48vw; }
    .gh-f2 { right: 5%; top: auto; bottom: 22%; width: 46vw; }
    .gh-cue { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-media, .gh-eyebrow, .gh-eyebrow i, .gh-letter, .gh-marquee, .gh-run, .gh-cue, .gh-cue span { animation: none; }
    .gh-float figure { animation: none; opacity: 1; transform: rotate(var(--r, -4deg)); }
  }
</style>
