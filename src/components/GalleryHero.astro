---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The gallery's opening, kept simple: one full-screen photo that settles slowly (a gentle zoom-out), a dark veil, a small line above the
 * title and the title itself rising into place, a thin line that draws down as a cue to scroll. Pure CSS: no script, nothing sticky,
 * no clip-path and nothing that overlaps the next section, so the page transition has only an ordinary screen to take a picture of.
 */
interface Props {
  title: string;
  image: ImageMetadata;
  alt?: string;
  eyebrow?: string;
}
const { title, image, alt = '', eyebrow = 'Luxury Rosettes' } = Astro.props;
---

<section class="gh" data-gallery-hero>
  <div class="gh-media">
    <Image src={image} alt={alt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" draggable="false" />
  </div>
  <div class="gh-scrim" aria-hidden="true"></div>
  <div class="gh-text">
    <p class="gh-eyebrow">{eyebrow}</p>
    <h1 class="gh-title"><span>{title}</span></h1>
  </div>
  <div class="gh-cue" aria-hidden="true"><span></span></div>
</section>

<style>
  .gh {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--ink, #0d0b09);
    color: var(--cream, #efe9dc);
  }
  .gh-media {
    position: absolute;
    inset: 0;
    animation: gh-settle 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .gh-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .gh-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(13, 11, 9, 0.6), rgba(13, 11, 9, 0.15) 55%, rgba(13, 11, 9, 0.4));
  }
  .gh-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    padding: 0 1.5rem;
    text-align: center;
    pointer-events: none;
  }
  .gh-eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.85);
    animation: gh-rise 1.1s 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .gh-title {
    margin: 0;
    overflow: hidden; /* the title rises out of a mask */
    padding-bottom: 0.1em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(3.2rem, 11vw, 9rem);
    line-height: 1.05;
  }
  .gh-title span {
    display: block;
    animation: gh-title 1.4s 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .gh-cue {
    position: absolute;
    left: 50%;
    bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px));
    width: 1px;
    height: 3.5rem;
    overflow: hidden;
    background: rgba(239, 233, 220, 0.25);
    pointer-events: none;
    animation: gh-fade 1s 1.6s both;
  }
  .gh-cue span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--cream, #efe9dc);
    animation: gh-draw 2.2s 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }

  @keyframes gh-settle {
    from { transform: scale(1.14); }
    to { transform: scale(1); }
  }
  @keyframes gh-rise {
    from { opacity: 0; transform: translateY(0.8rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes gh-title {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  @keyframes gh-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes gh-draw {
    from { transform: translateY(-100%); }
    60%, to { transform: translateY(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-media, .gh-eyebrow, .gh-title span, .gh-cue, .gh-cue span { animation: none; }
  }
</style>
