---
import { Image } from 'astro:assets';
import hero from '../assets/img/hero_img.webp';
---

<header class="hero" id="hero">
  <!-- the photo sits in a wrapper so the load-in zoom can't clash with the scroll zoom (which targets .hero-img) -->
  <div class="hero-media">
    <Image
      class="hero-img"
      src={hero}
      alt="Bengal cat looking up"
      widths={[800, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      data-w={hero.width}
      data-h={hero.height}
    />
  </div>

  <div class="hero-content">
    <div class="hero-lockup">
      <p class="hero-rail" data-intro>
        <span>Bengal Cattery</span>
        <span>TICA Registered</span>
        <span>United Kingdom</span>
      </p>
      <p class="hero-title" data-intro>Luxury Rosettes</p>
    </div>
  </div>

  <!-- page-coloured wash that takes over at full zoom (desktop) -->
  <div class="hero-fade" aria-hidden="true"></div>
  <!-- black that lifts when the page opens (pure CSS, so it can never get stuck) -->
  <div class="hero-curtain" aria-hidden="true"></div>
</header>

<noscript><style>[data-intro] { opacity: 1 !important; } #main-nav { opacity: 1 !important; }</style></noscript>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { clamp } from '../scripts/math';
  import { HERO, WORD_HIDDEN } from '../scripts/settings';
  import { mount } from '../scripts/lifecycle';
  import { dbg } from '../scripts/debug-log';

  mount(() => {
    // Opening sequence: the photo settles from a slow zoom, the name rises letter by letter across the bottom edge,
    // then the rail of keywords, and finally the navigation arrives. Time-based; the scroll sequence is separate.
    const hero = document.getElementById('hero')!;
    const nav = document.getElementById('main-nav');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // true when this page was reached by a page transition (set in Layout.astro): the nav must not hide and fade in again
    const arrived = !!(window as unknown as { __lrSwapped?: boolean }).__lrSwapped;
    const media = hero.querySelector<HTMLElement>('.hero-media')!;
    const title = hero.querySelector<HTMLElement>('.hero-title')!;
    const rail = hero.querySelector<HTMLElement>('.hero-rail')!;

    const splitChars = (el: HTMLElement) => {
      const text = (el.textContent ?? '').trim();
      el.setAttribute('aria-label', text);
      el.innerHTML = text
        .split(/\s+/)
        .map(
          (w) =>
            `<span class="hw" aria-hidden="true">${[...w].map((c) => `<span class="hc">${c}</span>`).join('')}</span>`,
        )
        .join(' ');
      return Array.from(el.querySelectorAll<HTMLElement>('.hc'));
    };

    // The name is sized by the screen's width AND height (whichever is smaller), so on a short window it can't
    // grow up over the cat's face; the rail above it is as wide as the name.
    const fit = () => {
      const words = title.querySelectorAll<HTMLElement>('.hw');
      if (!words.length) return;
      const size = parseFloat(getComputedStyle(title).fontSize);
      const width = words[words.length - 1].getBoundingClientRect().right - words[0].getBoundingClientRect().left;
      if (width > 0) title.style.fontSize = `${Math.min((size * innerWidth * HERO.fitWidth) / width, hero.clientHeight * HERO.fitHeight)}px`;
    };

    // Where the cat sits. The photo is "cover"-cropped, so on wide or short windows the cat would slide low and the
    // name would end up on its face. Instead the vertical crop is chosen so that the eyes land at HERO.eyeAtHeight of the height;
    // the horizontal crop centres the pair of eyes. The spot of the left eye is published for the scroll zoom.
    const EYE = HERO.eye;
    const photo = hero.querySelector<HTMLImageElement>('.hero-img')!;
    const placeCat = () => {
      const W = hero.clientWidth;
      const H = hero.clientHeight;
      const iw = +(photo.dataset.w ?? HERO.photoFallback.w);
      const ih = +(photo.dataset.h ?? HERO.photoFallback.h);
      const k = Math.max(W / iw, H / ih);
      const sW = iw * k;
      const sH = ih * k;
      const py = sH > H ? clamp((EYE.y * sH - H * HERO.eyeAtHeight) / (sH - H), 0, 1) : 0.5;
      const px = sW > W ? clamp((EYE.mid * sW - W / 2) / (sW - W), 0, 1) : 0.5;
      photo.style.objectPosition = `${px * 100}% ${py * 100}%`;
      const eyeX = EYE.x * sW - px * (sW - W);
      const eyeY = EYE.y * sH - py * (sH - H);
      // w = width of the eye in px (see HERO.eyeWidth): lets the scroll zoom pick a scale that fits the screen
      photo.dataset.eye = JSON.stringify({ ox: (eyeX / W) * 100, oy: (eyeY / H) * 100, w: HERO.eyeWidth * sW });
      dbg(`placeCat W${W} H${H} iw${iw} ih${ih} sW${Math.round(sW)} px${px.toFixed(2)} eyeX${Math.round(eyeX)} ox${((eyeX / W) * 100).toFixed(1)}`);
    };
    placeCat();

    const chars = splitChars(title);
    let raf = 0;
    let lastW = innerWidth;
    const onResize = () => {
      if (innerWidth === lastW) return; // only the height changed: the mobile address bar sliding in or out
      lastW = innerWidth;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        placeCat();
        title.style.fontSize = '';
        fit();
      });
    };
    addEventListener('resize', onResize);
    // The eye's place (photo.dataset.eye) is worked out from the hero's size. On a phone the hero is sometimes measured at the start while the
    // page is still laid out narrower (measured on an iPhone: a width of ~200px instead of 390px, so the zoom's origin came out at 1% instead of
    // 25% and the whole zoom, and the preloader's window, were pushed to the right). A window resize never fires then (the window itself did
    // not change), so the hero's own size is watched: whenever it changes the place is worked out again and the scroll scenes re-measure.
    let heroW = hero.clientWidth;
    let heroH = hero.clientHeight;
    let roRaf = 0;
    const ro = new ResizeObserver(() => {
      if (hero.clientWidth === heroW && hero.clientHeight === heroH) return;
      heroW = hero.clientWidth;
      heroH = hero.clientHeight;
      cancelAnimationFrame(roRaf);
      roRaf = requestAnimationFrame(() => {
        placeCat();
        ScrollTrigger.refresh();
      });
    });
    ro.observe(hero);
    let opening: gsap.core.Timeline | undefined;
    let cancelled = false;

    if (!reduceMotion) {
      gsap.set(chars, { yPercent: WORD_HIDDEN });
      gsap.set(title, { opacity: 1 });
      gsap.set(rail, { y: HERO.railRise });
      // after the intro the photo is already on screen (the preloader's last frame): no second zoom on top of it
      gsap.set(media, { scale: document.documentElement.classList.contains('preloading') ? 1 : HERO.mediaZoom });
      gsap.set(hero, { '--tint': 0 }); // the photo starts undimmed; the darkening arrives at the end of the opening
      if (nav && !arrived) gsap.set(nav, { autoAlpha: 0 });
    }

    // wait for the web font and the photo, but never longer than HERO.maxWait
    const img = hero.querySelector<HTMLImageElement>('.hero-img');
    Promise.race([
      Promise.all([document.fonts.ready, img?.decode?.().catch(() => undefined)]),
      new Promise((r) => setTimeout(r, HERO.maxWait)),
    ]).then(() => {
      if (cancelled) return;
      fit();
      // the intro (Preloader.astro) is on top of the page: the opening waits until it hands over
      if (document.documentElement.classList.contains('preloading') && !document.documentElement.classList.contains('intro-handed')) {
        return new Promise<void>((resolve) => document.addEventListener('preloader-done', () => resolve(), { once: true }));
      }
    }).then(() => {
      if (cancelled) return;
      // everything is measured and laid out: lift the curtain and show the nav (until now the page stays black)
      hero.dataset.ready = '';
      document.documentElement.classList.add('intro-ready');
      if (reduceMotion) {
        gsap.set('[data-intro]', { opacity: 1 });
        return;
      }
      const T = HERO.timeline;
      opening = gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .to(media, { scale: 1, duration: T.zoom }, 0)
        .to(chars, { yPercent: 0, duration: T.chars.dur, stagger: T.chars.stagger }, T.chars.at)
        .to(rail, { opacity: 1, y: 0, duration: T.rail.dur }, T.rail.at);
      // the nav only arrives with the very first intro; after a page transition it was already on screen
      if (!arrived) opening.to(nav, { autoAlpha: 1, duration: T.nav.dur, clearProps: 'opacity,visibility' }, T.nav.at);
      // the very last thing: the photo darkens under the text and the nav (the end of the longest part of the timeline)
      opening.to(hero, { '--tint': 1, duration: T.tint.dur, ease: 'power1.inOut' }, `>${T.tint.overlap}`);
    });

    return () => {
      cancelled = true;
      removeEventListener('resize', onResize);
      ro.disconnect();
      cancelAnimationFrame(roRaf);
      cancelAnimationFrame(raf);
      opening?.kill();
    };
  }, '#hero');
</script>

<style>
  .hero {
    /* Phones: the hero is as tall as the LARGEST viewport (address bar hidden), so it never changes size when the
       bar slides in or out. What must stay visible while the bar is up is placed from the bottom of the SMALL
       viewport (see --bar). On desktop these are all the same value. */
    height: 100vh;
    height: 100lvh;
    --bar: calc(100vh - 100svh);
    --bar: calc(100lvh - 100svh);
    position: relative;
    overflow: hidden;
    background: #111;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    will-change: transform;
  }
  /* Dark overlay: even tint + heavier top (nav) and bottom edges. --tint is 1 (fully on) except during the opening sequence, which
     brings it in last (see the script), once the photo, the name, the rail and the nav are all there. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--tint, 1);
    background:
      linear-gradient(to bottom, rgba(8, 7, 6, 0.55) 0%, rgba(8, 7, 6, 0.2) 35%, rgba(8, 7, 6, 0.65) 100%),
      rgba(8, 7, 6, 0.3);
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 1; /* above the dark overlay; the cream wash and the curtain come after it */
    pointer-events: none;
    color: #f4ede0;
  }
  /* hidden until the opening sequence reveals them (noscript and reduced motion show them straight away) */
  [data-intro] {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-intro] {
      opacity: 1;
    }
  }

  /* The cat keeps the middle of the screen (eyes and nose stay clean); the name sits on the bottom edge,
     edge to edge and cropped by it, with a dashed rail of keywords just above. */
  .hero-lockup {
    position: absolute;
    left: 50%;
    bottom: calc(5svh + var(--bar, 0px));
    transform: translateX(-50%);
    width: max-content; /* as wide as the name; the rail follows it */
    max-width: 96vw;
  }
  .hero-rail {
    margin: 0 0 1.1rem;
    padding-bottom: 0.8rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed rgba(244, 237, 224, 0.5);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: clamp(0.56rem, 0.35vw + 0.45rem, 0.82rem);
    letter-spacing: clamp(0.12em, 0.2vw, 0.28em);
    text-transform: uppercase;
    color: rgba(244, 237, 224, 0.85);
  }
  .hero-title {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-logo, 'Cinzel Decorative', serif);
    font-size: 14vw; /* replaced by the script once the font is measured */
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.03em;
    text-shadow: 0 4px 60px rgba(0, 0, 0, 0.45);
  }
  /* each word is a mask the letters rise out of (padding keeps the swashes of the display font unclipped) */
  .hero-title :global(.hw) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.12em 0.05em 0.14em;
    margin: -0.12em -0.05em -0.14em;
  }
  .hero-title :global(.hc) {
    display: inline-block;
    will-change: transform;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: var(--paper); /* same as body */
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }
  .hero-curtain {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #000;
    pointer-events: none;
    /* stays black until the script has set the page up (data-ready); the long delay is only a safety net */
    animation: curtain 1.6s 6s ease-out forwards;
  }
  .hero[data-ready] .hero-curtain {
    animation: curtain 1.6s 0.15s ease-out forwards;
  }
  /* the nav arrives with the intro (the script fades it in, then hands control back to this rule) */
  :global(html:not(.intro-ready) #main-nav) {
    opacity: 0;
  }
  @keyframes curtain {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-curtain,
    .hero[data-ready] .hero-curtain {
      animation-duration: 0.01s;
      animation-delay: 0s;
    }
  }
</style>
