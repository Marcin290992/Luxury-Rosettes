---
import { Image } from 'astro:assets';
import hero from '../assets/img/hero_img.webp';
---

<header class="hero" id="hero">
  <!-- the photo sits in a wrapper so the load-in zoom can't clash with the scroll zoom (which targets .hero-img) -->
  <div class="hero-media">
    <Image
      class="hero-img"
      src={hero}
      alt="Bengal cat looking up"
      widths={[800, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      data-w={hero.width}
      data-h={hero.height}
    />
  </div>

  <div class="hero-content">
    <div class="hero-lockup">
      <p class="hero-rail" data-intro>
        <span>Bengal Cattery</span>
        <span>TICA Registered</span>
        <span>United Kingdom</span>
      </p>
      <p class="hero-title" data-intro>Luxury Rosettes</p>
    </div>
  </div>

  <!-- page-coloured wash that takes over at full zoom (desktop) -->
  <div class="hero-fade" aria-hidden="true"></div>
  <!-- black that lifts when the page opens (pure CSS, so it can never get stuck) -->
  <div class="hero-curtain" aria-hidden="true"></div>
</header>

<noscript><style>[data-intro] { opacity: 1 !important; }</style></noscript>

<script>
  import gsap from 'gsap';

  // Opening sequence: the photo settles from a slow zoom, the name rises letter by letter across the bottom edge,
  // then the rail of keywords, and finally the navigation arrives. Time-based; the scroll sequence is separate.
  const hero = document.getElementById('hero')!;
  const nav = document.getElementById('main-nav');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const media = hero.querySelector<HTMLElement>('.hero-media')!;
  const title = hero.querySelector<HTMLElement>('.hero-title')!;
  const rail = hero.querySelector<HTMLElement>('.hero-rail')!;

  const splitChars = (el: HTMLElement) => {
    const text = (el.textContent ?? '').trim();
    el.setAttribute('aria-label', text);
    el.innerHTML = text
      .split(/\s+/)
      .map(
        (w) =>
          `<span class="hw" aria-hidden="true">${[...w].map((c) => `<span class="hc">${c}</span>`).join('')}</span>`,
      )
      .join(' ');
    return Array.from(el.querySelectorAll<HTMLElement>('.hc'));
  };

  // The name is sized by the screen's width AND height (whichever is smaller), so on a short window it can't
  // grow up over the cat's face; the rail above it is as wide as the name.
  const fit = () => {
    const words = title.querySelectorAll<HTMLElement>('.hw');
    if (!words.length) return;
    const size = parseFloat(getComputedStyle(title).fontSize);
    const width = words[words.length - 1].getBoundingClientRect().right - words[0].getBoundingClientRect().left;
    if (width > 0) title.style.fontSize = `${Math.min((size * innerWidth * 0.94) / width, innerHeight * 0.12)}px`;
  };

  // Where the cat sits. The photo is "cover"-cropped, so on wide or short windows the cat would slide low and the
  // name would end up on its face. Instead the vertical crop is chosen so that the eyes land at 40% of the height;
  // the horizontal crop centres the pair of eyes. The spot of the left eye is published for the scroll zoom.
  const EYE = { x: 0.371, y: 0.442, mid: 0.46 }; // left eye, and the middle between both eyes, as fractions of the photo
  const photo = hero.querySelector<HTMLImageElement>('.hero-img')!;
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const placeCat = () => {
    const W = hero.clientWidth;
    const H = hero.clientHeight;
    const iw = +(photo.dataset.w ?? 2000);
    const ih = +(photo.dataset.h ?? 1334);
    const k = Math.max(W / iw, H / ih);
    const sW = iw * k;
    const sH = ih * k;
    const py = sH > H ? clamp01((EYE.y * sH - H * 0.4) / (sH - H)) : 0.5;
    const px = sW > W ? clamp01((EYE.mid * sW - W / 2) / (sW - W)) : 0.5;
    photo.style.objectPosition = `${px * 100}% ${py * 100}%`;
    const eyeX = EYE.x * sW - px * (sW - W);
    const eyeY = EYE.y * sH - py * (sH - H);
    photo.dataset.eye = JSON.stringify({ ox: (eyeX / W) * 100, oy: (eyeY / H) * 100 });
  };
  placeCat();

  const chars = splitChars(title);
  let raf = 0;
  addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      placeCat();
      title.style.fontSize = '';
      fit();
    });
  });

  if (!reduceMotion) {
    gsap.set(chars, { yPercent: 115 });
    gsap.set(title, { opacity: 1 });
    gsap.set(rail, { y: 14 });
    gsap.set(media, { scale: 1.18 });
    if (nav) gsap.set(nav, { autoAlpha: 0 });
  }

  // wait for the web font and the photo, but never longer than ~1.8 s
  const img = hero.querySelector<HTMLImageElement>('.hero-img');
  Promise.race([
    Promise.all([document.fonts.ready, img?.decode?.().catch(() => undefined)]),
    new Promise((r) => setTimeout(r, 1800)),
  ]).then(() => {
    fit();
    if (reduceMotion) {
      gsap.set('[data-intro]', { opacity: 1 });
      return;
    }
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .to(media, { scale: 1, duration: 2.8 }, 0)
      .to(chars, { yPercent: 0, duration: 1.3, stagger: 0.05 }, 0.45)
      .to(rail, { opacity: 1, y: 0, duration: 1 }, 1.7)
      .to(nav, { autoAlpha: 1, duration: 1, clearProps: 'opacity,visibility' }, 1.2);
  });
</script>

<style>
  .hero {
    height: 100svh;
    position: relative;
    overflow: hidden;
    background: #111;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    will-change: transform;
  }
  /* Static dark overlay: even tint + heavier top (nav) and bottom edges */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(8, 7, 6, 0.55) 0%, rgba(8, 7, 6, 0.2) 35%, rgba(8, 7, 6, 0.65) 100%),
      rgba(8, 7, 6, 0.3);
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 1; /* above the dark overlay; the cream wash and the curtain come after it */
    pointer-events: none;
    color: #f4ede0;
  }
  /* hidden until the opening sequence reveals them (noscript and reduced motion show them straight away) */
  [data-intro] {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-intro] {
      opacity: 1;
    }
  }

  /* The cat keeps the middle of the screen (eyes and nose stay clean); the name sits on the bottom edge,
     edge to edge and cropped by it, with a dashed rail of keywords just above. */
  .hero-lockup {
    position: absolute;
    left: 50%;
    bottom: 5vh;
    transform: translateX(-50%);
    width: max-content; /* as wide as the name; the rail follows it */
    max-width: 96vw;
  }
  .hero-rail {
    margin: 0 0 1.1rem;
    padding-bottom: 0.8rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed rgba(244, 237, 224, 0.5);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: clamp(0.56rem, 0.35vw + 0.45rem, 0.82rem);
    letter-spacing: clamp(0.12em, 0.2vw, 0.28em);
    text-transform: uppercase;
    color: rgba(244, 237, 224, 0.85);
  }
  .hero-title {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-logo, 'Cinzel Decorative', serif);
    font-size: 14vw; /* replaced by the script once the font is measured */
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.03em;
    text-shadow: 0 4px 60px rgba(0, 0, 0, 0.45);
  }
  /* each word is a mask the letters rise out of (padding keeps the swashes of the display font unclipped) */
  .hero-title :global(.hw) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.12em 0.05em 0.14em;
    margin: -0.12em -0.05em -0.14em;
  }
  .hero-title :global(.hc) {
    display: inline-block;
    will-change: transform;
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: #faf8f3; /* same as body */
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }
  .hero-curtain {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #000;
    pointer-events: none;
    animation: curtain 1.6s 0.15s ease-out forwards;
  }
  @keyframes curtain {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-curtain {
      animation-duration: 0.01s;
      animation-delay: 0s;
    }
  }
</style>
