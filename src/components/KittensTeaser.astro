---
import { Image } from 'astro:assets';
import candy from '../assets/img/cats/candy.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';

import { getKittens, getLitters, nextLitter, monthLabel } from '../data/litters';

const photos = { candy, cosmo, charlie, chester };

// Sold kittens never show. With nobody left, the section turns into "next litter + waiting list".
const kittens = getKittens().filter((k) => k.status !== 'sold');
const next = nextLitter(getLitters());
---

<section class="kit" id="kittens">
  {
    kittens.length > 0 ? (
      <>
        <div class="kit-head">
          <p class="eyebrow" data-reveal>Meet the kittens</p>
          <h2 data-reveal>Waiting for a home</h2>
        </div>
        <div class="kit-grid">
          {kittens.map((k) => (
            <article class="kit-card" data-reveal>
              <div class="kit-photo">
                <Image src={photos[k.photo]} alt={`${k.name}, a Bengal kitten`} widths={[400, 700]} sizes="(min-width:1024px) 22vw, 70vw" loading="lazy" />
              </div>
              <h3>{k.name}</h3>
              <p class="kit-meta">
                {k.gender}
                {k.status === 'reserved' && <span class="kit-reserved">Reserved</span>}
              </p>
              <p class="kit-text">{k.text}</p>
            </article>
          ))}
        </div>
        <p class="kit-more" data-reveal><a href="/available-kittens">View all kittens</a></p>
      </>
    ) : (
      <div class="kit-empty">
        <p class="eyebrow" data-reveal>Kittens</p>
        <h2 data-reveal>{next ? 'Our next litter' : 'Be the first to know'}</h2>
        <p class="kit-text kit-empty-text" data-reveal>
          {next
            ? `Expected in ${monthLabel(next.expected)}, from ${next.dam} and ${next.sire}. Their kittens will be ready to go home around ${monthLabel(next.ready)}.`
            : 'No litters are planned at the moment. Join the waiting list and you will hear from us before anyone else.'}
        </p>
        <p class="kit-empty-actions" data-reveal>
          <a class="kit-pill" href="#">Join the waiting list</a>
          <a class="kit-more-link" href="#cats">Meet the parents</a>
        </p>
      </div>
    )
  }
</section>

<style>
  .kit {
    background: var(--paper);
    color: var(--ink);
    padding: clamp(4rem, 12vh, 9rem) 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin: 0 0 3rem;
  }
  .kit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
  }
  .kit-photo {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--placeholder);
  }
  .kit-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .kit-card:hover .kit-photo :global(img) {
    transform: scale(1.04);
  }
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.1;
    margin: 1rem 0 0.15rem;
  }
  .kit-meta {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin: 0 0 0.5rem;
  }
  .kit-reserved {
    margin-left: 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgba(26, 26, 26, 0.3);
    color: var(--ink);
    opacity: 0.55;
  }
  /* no kittens right now: next litter + waiting list */
  .kit-empty {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto;
  }
  .kit-empty h2 { margin-bottom: 1.25rem; }
  .kit-empty-text { font-size: 1rem; margin: 0 auto 2.25rem; }
  .kit-empty-actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }
  .kit-pill {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    text-decoration: none;
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.4s, color 0.4s;
  }
  .kit-pill:hover { background: transparent; color: var(--ink); }
  .kit-more-link {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.4);
    padding-bottom: 0.4rem;
    transition: color 0.4s, border-color 0.4s;
  }
  .kit-more-link:hover { color: var(--gold-deep); border-color: var(--gold-deep); }
  .kit-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0.75;
    margin: 0;
  }
  .kit-more {
    margin: 3rem 0 0;
    text-align: center;
  }
  .kit-more a {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.4);
    padding-bottom: 0.4rem;
    transition: color 0.4s, border-color 0.4s;
  }
  .kit-more a:hover {
    color: var(--gold-deep);
    border-color: var(--gold-deep);
  }
</style>
