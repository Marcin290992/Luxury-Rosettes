---
import { Image } from 'astro:assets';
import candy from '../assets/img/cats/candy.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';

import { getKittens, getLitters, nextLitter, monthLabel } from '../data/litters';

const photos = { candy, cosmo, charlie, chester };

// Sold kittens never show. With nobody left, the section turns into "next litter + waiting list".
const kittens = getKittens().filter((k) => k.status !== 'sold');
const next = nextLitter(getLitters());
---

<section class="kit" id="kittens">
  {
    kittens.length > 0 ? (
      <>
        <div class="kit-head">
          <p class="eyebrow" data-reveal>Meet the kittens</p>
          <h2 data-reveal>
            Waiting for <em>a home</em>
          </h2>
          <p class="kit-lead" data-reveal>
            Each kitten is raised in our home, health-tested and TICA registered. Reserve yours before they are gone.
          </p>
        </div>
        <div class="kit-grid">
          {kittens.map((k, i) => (
            <article class="kit-card" data-reveal>
              <div class="kit-photo">
                <Image src={photos[k.photo]} alt={`${k.name}, a Bengal kitten`} widths={[400, 700]} sizes="(min-width:1024px) 22vw, 70vw" loading="lazy" />
                <span class={`kit-badge${k.status === 'reserved' ? ' kit-badge--reserved' : ''}`}>{k.status === 'reserved' ? 'Reserved' : 'Available'}</span>
              </div>
              <div class="kit-info">
                <span class="kit-no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{k.name}</h3>
                <p class="kit-meta">{k.gender}</p>
              </div>
              <p class="kit-text">{k.text}</p>
            </article>
          ))}
        </div>
        <p class="kit-more" data-reveal><a href="/available-kittens">View all kittens</a></p>
      </>
    ) : (
      <div class="kit-empty">
        <p class="eyebrow" data-reveal>Kittens</p>
        <h2 data-reveal>{next ? 'Our next litter' : 'Be the first to know'}</h2>
        <p class="kit-text kit-empty-text" data-reveal>
          {next
            ? `Expected in ${monthLabel(next.expected)}, from ${next.dam} and ${next.sire}. Their kittens will be ready to go home around ${monthLabel(next.ready)}.`
            : 'No litters are planned at the moment. Join the waiting list and you will hear from us before anyone else.'}
        </p>
        <p class="kit-empty-actions" data-reveal>
          <a class="kit-pill" href="#">Join the waiting list</a>
          <a class="kit-more-link" href="#cats">Meet the parents</a>
        </p>
      </div>
    )
  }
</section>

<style>
  .kit {
    background: var(--paper);
    color: var(--ink);
    padding: clamp(4rem, 12vh, 9rem) 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .kit-head {
    max-width: 40rem;
    margin: 0 0 clamp(3rem, 7vh, 5rem);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin: 0 0 1.5rem;
  }
  .kit-head .eyebrow::before {
    content: '';
    width: 2.5rem;
    border-top: 1px solid var(--gold-deep);
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }
  h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold-deep);
  }
  .kit-lead {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    opacity: 0.65;
    margin: 0;
  }
  .kit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 1024px) {
    /* a gentle stagger, like a gallery wall */
    .kit-card:nth-child(even) { margin-top: 3.5rem; }
  }
  .kit-photo {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--placeholder);
  }
  .kit-photo::after {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 1px solid rgba(250, 248, 243, 0.55);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s, inset 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .kit-card:hover .kit-photo::after {
    opacity: 1;
    inset: 1rem;
  }
  .kit-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .kit-card:hover .kit-photo :global(img) {
    transform: scale(1.05);
  }
  .kit-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-warm);
    background: var(--gold);
    padding: 0.5rem 0.85rem;
  }
  .kit-badge--reserved {
    color: var(--cream);
    background: rgba(26, 20, 16, 0.78);
    backdrop-filter: blur(6px);
  }
  .kit-info {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.9rem;
    margin: 1.4rem 0 0.7rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(26, 26, 26, 0.18);
  }
  .kit-no {
    grid-row: 1 / 3;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1rem;
    color: var(--gold-deep);
  }
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.05;
    margin: 0;
  }
  .kit-meta {
    font-family: var(--font-body);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0.35rem 0 0;
  }
  /* no kittens right now: next litter + waiting list */
  .kit-empty {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto;
  }
  .kit-empty .eyebrow { justify-content: center; }
  .kit-empty h2 { margin-bottom: 1.25rem; }
  .kit-empty-text { font-size: 1rem; margin: 0 auto 2.25rem; }
  .kit-empty-actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }
  .kit-pill {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    text-decoration: none;
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.4s, color 0.4s;
  }
  .kit-pill:hover { background: transparent; color: var(--ink); }
  .kit-more-link {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.4);
    padding-bottom: 0.4rem;
    transition: color 0.4s, border-color 0.4s;
  }
  .kit-more-link:hover { color: var(--gold-deep); border-color: var(--gold-deep); }
  .kit-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0.75;
    margin: 0;
  }
  .kit-more {
    margin: 3rem 0 0;
    text-align: center;
  }
  .kit-more a {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 26, 26, 0.4);
    padding-bottom: 0.4rem;
    transition: color 0.4s, border-color 0.4s;
  }
  .kit-more a:hover {
    color: var(--gold-deep);
    border-color: var(--gold-deep);
  }
</style>
