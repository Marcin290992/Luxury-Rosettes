---
/**
 * The button of the whole site (the same look and hover as the menu): a link (with `href`) or a button (without; `contact` makes it open
 * the contact form). On hover the letters slide up one after another and a gold copy slides in from below.
 *
 * Looks: the outlined pill; `solid` is the filled one; `link` is plain text with a line under it; `arrow` adds the arrow of the menu's
 * Inquire. The colours come from `--fg` (text and outline, white by default) and `--inv` (text on the filled one, ink by default), so a
 * parent can recolour it, as the corridor finale does while it fades to dark. `light` is for the paper-coloured sections (ink on paper).
 */
interface Props {
  label: string;
  href?: string;
  solid?: boolean;
  contact?: boolean;
  light?: boolean;
  link?: boolean;
  arrow?: boolean;
}
const { label, href, solid = false, contact = false, light = false, link = false, arrow = false } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['cta', { 'cta--solid': solid, 'cta--light': light, 'cta--link': link }]}
  href={href}
  type={href ? undefined : 'button'}
  data-contact-trigger={contact ? '' : undefined}
  aria-label={label}
>
  <span class="cta-label" aria-hidden="true">
    <span class="cta-word">
      {[...label].map((ch, n) => <span class="cta-char" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}
    </span>
  </span>
  {
    arrow && (
      <svg class="cta-arrow" viewBox="0 0 30 12" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M0 6H29M24 1L29 6L24 11" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</Tag>

<style>
  .cta {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 1.1rem; /* between the label and the arrow */
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg, #fff);
    border: 1px solid color-mix(in srgb, var(--fg, #fff) 60%, transparent);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: border-color var(--hover-time) cubic-bezier(0.65, 0, 0.35, 1);
  }
  .cta--light {
    --fg: var(--ink);
    --inv: var(--paper);
  }
  .cta--solid {
    background: var(--fg, #fff);
    color: var(--inv, var(--ink));
  }
  /* plain text with a line under it */
  .cta--link {
    letter-spacing: 0.14em;
    border-width: 0 0 1px;
    border-radius: 0;
    padding: 0 0 0.4rem;
  }
  .cta-label {
    display: block;
    overflow: hidden;
    line-height: 1.5;
  }
  .cta-word {
    display: block;
    white-space: pre;
  }
  .cta-char {
    display: inline-block;
    position: relative;
    transition: transform var(--hover-time) cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--n) * var(--hover-stagger));
  }
  .cta-char::after {
    content: attr(data-ch);
    position: absolute;
    top: 100%;
    left: 0;
    color: var(--gold);
  }
  /* the gold copy needs a gold that shows on its ground: gold would vanish on a light one */
  .cta--solid .cta-char::after,
  .cta--light .cta-char::after {
    color: var(--gold-deep);
  }
  .cta--light.cta--solid .cta-char::after {
    color: var(--gold);
  }
  .cta-arrow {
    width: 30px;
    height: 12px;
    flex: none;
    transition: color var(--hover-time) cubic-bezier(0.65, 0, 0.35, 1);
  }
  @media (hover: hover) {
    .cta:hover {
      border-color: var(--gold);
    }
    .cta--light:hover {
      border-color: var(--gold-deep);
    }
    .cta--solid:hover {
      border-color: var(--fg, #fff);
    }
    .cta:hover .cta-char,
    .cta:focus-visible .cta-char {
      transform: translateY(-100%);
    }
    .cta:hover .cta-arrow,
    .cta:focus-visible .cta-arrow {
      color: var(--gold);
    }
    .cta--light:hover .cta-arrow,
    .cta--light:focus-visible .cta-arrow {
      color: var(--gold-deep);
    }
  }
  .cta:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 4px;
  }
</style>
