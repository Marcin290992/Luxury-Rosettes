---
import Closing from './Closing.astro';
import Footer from './Footer.astro';
import type { ImageMetadata } from 'astro';
import type { LumenGallery } from '../data/lumen';

/**
 * A "Lumen" gallery page (script: scripts/lumen-gallery.ts), in two phases:
 *  HERO - a coloured panel with the gallery's big wordmark. It opens at full height and settles to 75 % (after 0.9 s). The white photo grid waits
 *         just below it. Scrolling (smoothed, 6 % of the gap per frame) pulls the grid up over the hero while the wordmark shrinks to 60 %,
 *         blurs and fades. Past halfway the page finishes the move by itself; at 80 % the header slides in and the grid leaves its big
 *         "intro" layout for zoom level 2 (the pictures glide to their new places).
 *  GRID - the hero is gone; the grid scrolls by transform (no scrollbar), with + / - to change the zoom, a paper-like lift under the mouse
 *         on a photo (desktop) and a photo that opens large from its place in the grid.
 * Placeholder photos and captions, to be replaced.
 */
interface Props {
  gallery: LumenGallery;
  galleries: LumenGallery[];
  start?: 'hero' | 'grid'; // 'grid': no hero, the grid at once (the /gallery page)
  intro?: string[]; // with start 'grid': the photos of a spiral that flies before the grid comes in
  closing?: ImageMetadata; // the photo of the closing block under the grid (with the footer, as on the home page)
}
const { gallery, galleries, start = 'hero', intro = [], closing } = Astro.props;
const first = gallery.photos[0];
---

<div class="lg-root" data-lumen-gallery data-bg={gallery.background} data-accent={gallery.accent} data-start={start} data-intro={intro.join('|')}>
  <div class="lg-hero" aria-hidden="true" style={`background:${gallery.background}`}>
    <div class="lg-hero-inner">
      <p class="lg-hero-label"><span>Scroll to explore</span></p>
      <div class="lg-logo-box">
        <div class="lg-logo" style={`color:${gallery.accent}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox={gallery.italic ? '0 0 680 100' : '0 0 280 100'} fill="currentColor" aria-hidden="true">
            {
              gallery.italic ? (
                <text x="340" y="84" text-anchor="middle" textLength="600" lengthAdjust="spacingAndGlyphs" style="font-family:var(--font-heading),Georgia,serif;font-style:italic;font-weight:600" font-size="112">
                  {gallery.name.charAt(0) + gallery.name.slice(1).toLowerCase()}
                </text>
              ) : (
                <text x="140" y="94" text-anchor="middle" textLength="276" lengthAdjust="spacingAndGlyphs" style="font-family:var(--font-heading),serif;font-weight:500" font-size="132">
                  {gallery.name}
                </text>
              )
            }
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="lg-content">
    <div class="lg-gridwrap">
      <div class="lg-vscroll">
        <div class="lg-scaler">
          <div class="lg-track">
            <div class="lg-grid">
              {
                gallery.photos.map((p, i) => (
                  <div class="lg-item" data-index={i}>
                    <button type="button" class="lg-link" aria-label={`Open picture ${p.id}: ${p.title}`}>
                      <img src={p.src} width={p.width} height={p.height} alt={p.title} data-full={p.full} data-id={p.id} data-title={p.title} data-time={p.time} data-credit={p.credit} draggable="false" loading={i < 10 ? 'eager' : 'lazy'} />
                    </button>
                  </div>
                ))
              }
            </div>
            <!-- under the grid, as on the home page: the closing photo, and the footer that rises over it (the effect follows the grid's scroll: scripts/lumen-gallery.ts) -->
            <div class="lg-ending">
              <Closing photo={closing} eyebrow="Like what you see?" heading={['Come and meet', 'them yourself']} cta={{ label: 'View available kittens', href: '/available-kittens' }} />
              <Footer />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="lg-box" role="dialog" aria-label="Photo" hidden>
    <div class="lg-box-bg"></div>
    <div class="lg-strip" role="listbox" aria-label="Pictures"></div>
    <img class="lg-box-img" src={first.full} alt="" />
    <img class="lg-box-img lg-box-ghost" src={first.full} alt="" aria-hidden="true" />
    <button type="button" class="lg-box-close" aria-label="Close">
      <span>Close</span>
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>

</div>

<style>
  .lg-root,
  .lg-root :global(*) {
    box-sizing: border-box;
  }
  .lg-root {
    --lg-label: clamp(12px, 0.1vw + 11.5px, 14px);
    color: #000;
  }

  /* hero */
  .lg-hero {
    pointer-events: none;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
  }
  .lg-hero-inner {
    display: flex;
    height: 75vh;
    height: 75svh;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
  }
  .lg-hero-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--lg-label);
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #7d7676;
  }
  .lg-hero-label span {
    display: inline-block;
    will-change: transform, opacity;
  }
  .lg-logo-box {
    position: relative;
    min-height: 0;
    width: 100%;
    max-width: 1400px;
    flex: 1;
  }
  .lg-logo {
    position: absolute;
    inset: 0;
    will-change: transform, filter, opacity;
  }
  .lg-logo :global(svg) {
    display: block;
    height: 100%;
    width: 100%;
  }
  /* phone: the site's pill sits at the top and its dock at the bottom, so the hero starts below the pill */
  @media (max-width: 1023px) {
    .lg-hero-inner {
      padding-top: 96px;
    }
  }
  @media (min-width: 1024px) {
    .lg-hero-inner {
      gap: 160px;
      padding: 20px 160px 160px;
    }
  }

  /* the grid, sliding up over the hero */
  .lg-content {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
  }
  .lg-gridwrap {
    position: relative;
    background: #fff;
    color: #000;
    pointer-events: auto;
  }
  .lg-vscroll {
    overflow: hidden;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .lg-scaler {
    transform-origin: center;
    will-change: transform;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
  }
  .lg-track {
    will-change: transform;
  }
  .lg-ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge */
  .lg-ending[data-fx] > :global(footer) {
    margin-top: -30vh;
    margin-top: -30svh;
  }
  .lg-grid {
    display: grid;
    grid-auto-rows: auto;  }
  .lg-item {
    position: relative;
    opacity: 0;
    filter: blur(6px);
  }
  .lg-link {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .lg-link img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* the photo opened large (it grows from its place in the grid) */
  .lg-box {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }
  .lg-box[hidden] {
    display: none;
  }
  .lg-box-bg {
    position: absolute;
    inset: 0;
    background: #fff;
  }
  .lg-box-img {
    position: absolute;
    will-change: transform;
    max-height: 80vh;
    max-height: 80svh;
    max-width: 80vw;
    width: auto;
    height: auto;
  }
  /* the strip of small pictures down the left side of the opened one: the current one is clear, the others faded; a click shows that one */
  .lg-box-ghost {
    opacity: 0;
    pointer-events: none;
  }
  .lg-strip {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: 76px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
  }
  .lg-strip::-webkit-scrollbar {
    display: none;
  }
  .lg-strip :global(.lg-thumb) {
    display: block;
    width: 76px;
    height: 100px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.32;
    transition: opacity 0.4s ease;
  }
  .lg-strip :global(.lg-thumb:hover),
  .lg-strip :global(.lg-thumb.is-active) {
    opacity: 1;
  }
  .lg-strip :global(.lg-thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* the close button, in the style of the site's pill (dark, warm, gold line), at the right where the eye goes after the picture, level with the pill */
  .lg-box-close {
    position: absolute;
    z-index: 3;
    top: 22px;
    right: 28px;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    height: 52px;
    padding: 0 1.3rem 0 1.5rem;
    border: 1px solid rgba(212, 175, 55, 0.55);
    border-radius: 9999px;
    background: rgba(26, 20, 16, 0.92);
    color: var(--cream, #efe9dc);
    box-shadow: 0 14px 34px -14px rgba(26, 20, 16, 0.55);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s ease;
  }
  .lg-box-close svg {
    color: var(--gold, #d4af37);
    transition: transform 0.4s ease;
  }
  .lg-box-close:hover,
  .lg-box-close:focus-visible {
    background: rgba(26, 20, 16, 1);
    border-color: var(--gold, #d4af37);
    outline: none;
  }
  .lg-box-close:hover svg,
  .lg-box-close:focus-visible svg {
    transform: rotate(90deg);
  }
  /* phone: bottom right (the site's pill is across the top and its dock in the middle at the bottom) */
  @media (max-width: 1023px) {
    /* the opened photo on a phone: the pictures lie in a row along the bottom (the full width of the screen, scrolled sideways; the Close pill sits above its right end), so the photo has the whole width */
    .lg-strip {
      top: auto;
      bottom: 12px;
      left: 0;
      right: 0;
      width: auto;
      height: 72px;
      display: flex;
      gap: 4px;
      padding: 0 8px 0 12px;
      overflow-x: auto;
      overflow-y: hidden;
    }
    /* the size is set by the script (fitBox); the 80 % limits of the desktop would shrink the photo again */
    .lg-box-img {
      max-width: none;
      max-height: none;
    }
    .lg-strip :global(.lg-thumb) {
      flex: none;
      width: 54px;
      height: 72px;
    }
    /* only the X, a round button under the site's pill at the right (the photo starts below it) */
    .lg-box-close {
      top: 108px; /* clear of the pill's Inquire button */
      bottom: auto;
      right: 16px;
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
      gap: 0;
    }
    .lg-box-close span {
      display: none;
    }
  }
</style>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLumenGallery } from '../scripts/lumen-gallery';

  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-lumen-gallery]');
    return root ? initLumenGallery(root) : undefined;
  }, '[data-lumen-gallery]');
</script>
