---
import LumenMenu from './LumenMenu.astro';
import type { LumenGallery } from '../data/lumen';

/**
 * The gallery's intro, without any text (script: scripts/lumen-intro.ts): the page is white, and the moment it is there 21 paper photos fly
 * through a three.js spiral; when the spiral is over the gallery chooser (LumenMenu) comes up, its two covers turning over onto the page.
 * Placeholder photos, to be replaced.
 */
interface Props {
  galleries: LumenGallery[];
  spiral: string[]; // the photos that fly through the spiral
}
const { galleries, spiral } = Astro.props;
---

<section class="li-root" data-lumen-intro data-spiral={spiral.join('|')} data-covers={galleries.map((g) => g.coverSrc).join('|')}>
  <LumenMenu galleries={galleries} text="top" />
</section>

<style>
  .li-root {
    position: fixed;
    inset: 0;
    background: #ffffff;
    color: #000;
    overflow: hidden;
  }
</style>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLumenIntro } from '../scripts/lumen-intro';

  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-lumen-intro]');
    return root ? initLumenIntro(root) : undefined;
  }, '[data-lumen-intro]');
</script>
