---
import type { LumenGallery } from '../data/lumen';

/**
 * The gallery chooser ("Choose which gallery you want to explore"): a full-screen layer with the two covers. The script (scripts/lumen-menu.ts)
 * turns each cover over onto the page in WebGL, grows the one under the pointer (desktop), takes the screen's colour from it and slides a
 * "Welcome to ..." line in; a tap takes you to the gallery. It is closed until the page's own script opens it with initLumenMenu(root).open()
 * (the intro does when its spiral is over, a gallery page from its Menu button).
 * `text`: where the heading sits, above the covers (the intro) or below them (a gallery page).
 */
interface Props {
  galleries: LumenGallery[];
  text?: 'top' | 'bottom';
  closable?: boolean;
  topBarName?: string;
}
const { galleries, text = 'top', closable = false, topBarName = '' } = Astro.props;

// a hand-drawn "to" (a placeholder scribble)
const TO_SVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29 27" fill="none" aria-hidden="true">
<path d="M3 17C7 14.5 12 10.5 16 7C18.5 4.8 20.5 2.8 21.8 0.8M9.5 8.2C12.5 8 16 8 18.5 8.4M14 13C11 16 7.5 20 5 23.5C3.5 25.5 5 26 8 24.5C11.5 22.7 15 20 17.6 16.1" stroke="currentColor" stroke-width="0.5" stroke-linecap="round"/>
<path d="M16.5 16.7C14.5 18 12.8 20.5 13 22.6C13.2 24 15.2 23.8 17.2 22C19.6 19.8 21.3 17 21 15.2C20.7 13.6 18.6 13.7 17.1 14.8C15.7 15.8 15 17.7 16 18.8C17.3 20 22 18.7 27.1 16.9" stroke="currentColor" stroke-width="0.5" stroke-linecap="round"/>
</svg>`;
---

<div class="lm-root" data-lumen-menu data-text={text} hidden>
  <button type="button" class="lm-backdrop" aria-label="Close menu" disabled></button>
  {
    closable && (
      <div class="lm-bar">
        <span class="lm-bar-name">{topBarName}</span>
        <button type="button" class="lm-x" aria-label="Close menu">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    )
  }
  <div class="lm-body">
    <h2 class="lm-heading"><span>Choose which gallery you</span><span>want to explore</span></h2>
    <div class="lm-area">
      <div class="lm-grid" data-hidden>
        {
          galleries.map((g, i) => (
            <div class={`lm-welcome ${i === 0 ? 'left' : 'right'}`} data-for={i} aria-hidden="true">
              <span class="lm-line" data-line="1">
                <span class="lm-display">WELCOME</span>
              </span>
              <span class="lm-line" data-line="2" style={`padding-left:${i === 0 ? '30%' : '8%'}`}>
                <span class="lm-to" set:html={TO_SVG} />
                <span class={`lm-display ${g.italic ? 'is-italic' : ''}`}>{g.name}</span>
              </span>
            </div>
          ))
        }
        {
          galleries.map((g, i) => (
            <div class="lm-card" data-index={i} data-bg={g.background} data-accent={g.accent} data-href={g.href}>
              <a href={g.href} aria-label={`${g.title}: ${g.name}`} data-astro-prefetch="false">
                <img src={g.coverSrc} width={g.coverWidth} height={g.coverHeight} alt={`${g.title} cover`} draggable="false" />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .lm-root {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: #000;
    color: #fff;
  }
  .lm-root[hidden] {
    display: none;
  }
  .lm-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: default;
    background: none;
    border: 0;
  }
  .lm-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 15px 0 20px;
    pointer-events: none;
  }
  .lm-bar-name {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 0.2em;
  }
  .lm-x {
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    background: #3a3a3a;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
  }
  .lm-body {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 32px 20px;
    pointer-events: none;
  }
  .lm-root[data-text='bottom'] .lm-body {
    flex-direction: column-reverse;
  }
  .lm-heading {
    margin: 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(16px, 1.1vw + 11px, 20px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .lm-heading span {
    display: block;
  }
  .lm-area {
    display: flex;
    min-height: 0;
    width: 100%;
    flex: 1;
    align-items: center;
    justify-content: center;
  }
  .lm-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 0;
    flex-shrink: 0;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr;
    pointer-events: auto;
  }
  .lm-grid.is-lg {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr;
  }
  .lm-grid[data-hidden] {
    visibility: hidden;
    pointer-events: none;
  }
  .lm-card {
    width: 100%;
    height: 100%;
    min-height: 0;
    visibility: hidden; /* shown when its cover has turned over (the WebGL sheet is what is seen until then) */
  }
  .lm-card a {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .lm-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lm-welcome {
    position: absolute;
    z-index: 10;
    pointer-events: none;
    visibility: hidden;
  }
  .lm-welcome.left {
    bottom: 0;
    left: 0;
    transform: translate(-50%, 50%);
  }
  .lm-welcome.right {
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
  }
  .lm-line {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform, opacity;
  }
  .lm-display {
    display: block;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(50px, 4vw + 35px, 100px);
    line-height: 1;
  }
  .lm-display.is-italic {
    font-style: italic;
  }
  .lm-to {
    display: block;
    height: clamp(20px, 0.65vw + 18px, 30px);
    margin-right: 4px;
  }
  .lm-to :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
  @media (min-width: 1024px) {
    .lm-body {
      gap: 80px;
      padding: 80px;
    }
  }
</style>

