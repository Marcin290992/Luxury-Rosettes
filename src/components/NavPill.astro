---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-cat.svg';

const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/our-cats', label: 'Our Cats' },
  { href: '/available-kittens', label: 'Kittens' },
  { href: '/awards', label: 'Awards' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/blog', label: 'Blog' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav id="main-nav" class="nav-pill" aria-label="Main">
  <span class="nav-glass" aria-hidden="true"></span>
  <div class="nav-header">
    <button
      id="menu-btn"
      type="button"
      class="nav-btn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      <span id="menu-text" class="inquire-label" aria-hidden="true">
        <span class="nav-word">{[...'Menu'].map((ch, n) => <span class="nav-char" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}</span>
      </span>
    </button>

    <a href="/" class="nav-logo" aria-label="Luxury Rosettes — home">
      <Image src={logo} alt="" height={56} loading="eager" />
    </a>

    <button type="button" class="nav-btn inquire-btn" aria-label="Inquire" data-contact-trigger>
      <span class="inquire-label" aria-hidden="true">
        <span class="nav-word">{[...'Inquire'].map((ch, n) => <span class="nav-char" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}</span>
      </span>
      <svg class="arrow-icon" viewBox="0 0 30 12" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M0 6H29M24 1L29 6L24 11" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <div class="nav-content">
    <div id="nav-panel" class="nav-body" inert>
      <div class="nav-inner">
        <div class="nav-brand">
          <p class="nav-title">Luxury Rosettes</p>
          <p class="nav-subtitle">Bengal Cattery</p>
        </div>

        <ul class="nav-links">
          {links.map(({ href, label }, i) => (
            <li style={`--i:${i}`}>
              <a href={href} aria-label={label} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="nav-word" aria-hidden="true">
                  {[...label].map((ch, n) => <span class="nav-char" style={`--n:${n}`} data-ch={ch}>{ch}</span>)}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="nav-footer">TICA Registered · United Kingdom</p>
      </div>
    </div>
  </div>
</nav>

<script>
  import { navigate } from 'astro:transitions/client';
  import { prefetch } from 'astro:prefetch';
  import { mount } from '../scripts/lifecycle';
  import { glassSurface } from '../scripts/glass-surface';
  import { getLenis } from '../scripts/lenis';
  import { getScrollY, onPageScroll, scrollBox } from '../scripts/scroller';
  import { NAV_SCROLLED_AT as SCROLLED_AT } from '../scripts/settings';

  const BORDERS = 2; // px: the pill's top and bottom border
  const AT_TOP = 40; // px: scrolled less than this counts as the top of the page
  const TAP_MS = 440; // on a touch screen (no hover) the chosen link plays its hover (see .chosen below) before the page transition starts: a letter's slide plus the longest stagger

  mount(() => {
    const nav = document.getElementById('main-nav')!;
    const btn = nav.querySelector<HTMLElement>('#menu-btn')!;
    const word = nav.querySelector<HTMLElement>('#menu-text .nav-word')!;
    const panel = nav.querySelector<HTMLElement>('#nav-panel')!;
    const logo = nav.querySelector<HTMLElement>('.nav-logo')!;
    const header = nav.querySelector<HTMLElement>('.nav-header')!;

    // The glass layer (see .nav-glass) is as tall as the open pill and only revealed down to the pill's height. The refraction at its edge
    // (Chromium only, see glass-surface.ts) follows the shape that is revealed now: the closed pill or the open one.
    const glass = glassSurface(nav.querySelector<HTMLElement>('.nav-glass')!);
    let openHeight = 0;
    const shapeGlass = () => {
      const closedHeight = header.offsetHeight + BORDERS;
      const radius = parseFloat(getComputedStyle(nav).getPropertyValue('--radius')); // the target one: a custom property does not animate
      glass.shape(nav.classList.contains('expanded') ? openHeight : closedHeight, radius);
    };
    // the open pill: header + panel (its content, at most its max-height) + the borders
    const measureOpen = () => {
      const max = parseFloat(getComputedStyle(panel).maxHeight);
      const body = Number.isFinite(max) ? Math.min(panel.scrollHeight, max) : panel.scrollHeight;
      openHeight = header.offsetHeight + BORDERS + body;
      nav.style.setProperty('--open-h', `${openHeight}px`);
      shapeGlass();
    };
    measureOpen();
    window.addEventListener('resize', measureOpen);
    document.fonts?.ready.then(measureOpen);

    // the letters' timing is a global CSS token (--hover-time, --hover-stagger, see Layout.astro); the script only needs it in ms
    const cssMs = (name: string) => {
      const v = getComputedStyle(nav).getPropertyValue(name).trim();
      return parseFloat(v) * (v.endsWith('ms') ? 1 : 1000);
    };
    const letterMs = cssMs('--hover-time');
    const staggerMs = cssMs('--hover-stagger');

    // one span per letter, like the server-rendered label, so the hover effect works on both words
    // (cloned, so the letters keep Astro's scoped-style attribute)
    const proto = word.firstElementChild!.cloneNode(false) as HTMLElement;
    const letter = (ch: string, n: number) => {
      const el = proto.cloneNode(false) as HTMLElement;
      el.style.setProperty('--n', String(n));
      el.dataset.ch = ch; // the gold copy that slides in from below on a hover
      el.textContent = ch;
      return el;
    };
    const letters = (text: string) => [...text].map((ch, n) => letter(ch, n));
    const labelBox = word.parentElement!; // clips the words that slide in and out
    let label = word.textContent ?? 'Menu'; // the label that is shown, or that the running roll is going to
    let rollTimer = 0;
    const setLabel = (next: string) => {
      window.clearTimeout(rollTimer);
      label = next;
      labelBox.querySelectorAll('.nav-word.out').forEach((old) => old.remove());
      labelBox.style.minWidth = '';
      word.classList.remove('enter', 'settle');
      word.replaceChildren(...letters(next));
    };
    // Menu <-> Close: the old word slides up and out, the new one comes in from below, letter after letter like a hover. Each is a whole word
    // with its own letter widths: if the new letters sat in the old word's places, the spacing would jump when the plain word replaces them.
    const rollLabel = (next: string) => {
      if (next === label) return;
      setLabel(label); // a roll that is still running is finished first
      const out = word.cloneNode(true) as HTMLElement;
      out.classList.add('out');
      labelBox.style.minWidth = `${labelBox.offsetWidth}px`; // the old word keeps its room until it has left
      labelBox.append(out);
      word.replaceChildren(...letters(next));
      word.classList.add('enter'); // below its place, whatever the pointer does to the letters
      void word.offsetWidth;
      word.classList.replace('enter', 'settle');
      out.classList.add('go');
      rollTimer = window.setTimeout(() => setLabel(next), letterMs + Math.max(label.length, next.length) * staggerMs + 60);
      label = next;
    };

    const setOpen = (open: boolean) => {
      nav.classList.toggle('expanded', open);
      shapeGlass();
      btn.setAttribute('aria-expanded', String(open));
      rollLabel(open ? 'Close' : 'Menu');
      panel.toggleAttribute('inert', !open);
      // the scenes that follow the scroll hold still while the menu is open (see `nav-menu` in awards-spiral.ts)
      document.dispatchEvent(new CustomEvent('nav-menu', { detail: { open, leaving: false } }));
    };

    // While the menu is open the pages it links to are fetched in the background (the click then only swaps them in: on a phone the
    // download used to start at the tap and the transition waited for it)
    const warm = () => {
      panel.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const u = new URL(a.href, location.href);
        if (u.origin === location.origin && u.pathname !== location.pathname) prefetch(u.pathname + u.search, { ignoreSlowConnection: true });
      });
    };
    let warmTimer = 0;
    const onToggle = () => {
      const open = !nav.classList.contains('expanded');
      setOpen(open);
      // the pages are fetched once the menu has nearly finished opening, not while it animates: the downloads competed with the animation on a phone
      window.clearTimeout(warmTimer);
      if (open) warmTimer = window.setTimeout(warm, 800);
    };
    // Close on outside click, Escape, or after choosing a link
    const onOutsideClick = (e: MouseEvent) => {
      // the path, not the target: clicking the Menu button swaps its letters, so the target is already detached by now
      if (!e.composedPath().includes(nav)) setOpen(false);
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && nav.classList.contains('expanded')) {
        setOpen(false);
        btn.focus();
      }
    };
    // A link in the menu or the logo starts the page transition at once, with the menu as it is. It is not folded first: the new page builds
    // its own menu, closed, and the old one leaves with the old page (a menu that started to fold at the tap would be caught half-folded in the
    // picture of the old page, which is taken a moment later). A link to the page you are already on, from a scrolled page, plays the same
    // transition (to a fresh copy of the page, at its top) instead of scrolling back; from the top of the page it does nothing.
    let giveUp = 0;
    let go = 0;
    const leave = (href: string, link: HTMLElement) => {
      // everything that is still animating in the menu (the letters of a hover, the links coming in one after another) finishes at once, in
      // its final state, so that the picture of the old page is never taken with a half-done animation; the chosen link shows its finished hover
      nav.classList.add('leaving');
      link.classList.add('chosen');
      document.dispatchEvent(new CustomEvent('nav-menu', { detail: { open: false, leaving: true } })); // stays held until the page is gone
      // if the page never changes (no connection), the menu closes after all
      window.clearTimeout(giveUp);
      giveUp = window.setTimeout(() => {
        nav.classList.remove('leaving');
        link.classList.remove('chosen');
        setOpen(false);
      }, 6000);
      // a touch screen has no hover to have been seen: the chosen link plays it now (the letters slide up, the gold copy comes in), and the page
      // transition starts when it has finished. With a mouse the hover has been on the link already, so the transition starts at once.
      const plays = !window.matchMedia('(hover: hover)').matches && link.querySelector('.nav-char');
      go = window.setTimeout(() => navigate(href), plays ? TAP_MS : 0);
    };
    const onLinkClick = (e: MouseEvent) => {
      const link = (e.target as Element).closest('a'); // a click on an icon inside a link counts as the link
      if (!link) return;
      const url = new URL(link.href, location.href);
      const sameOrigin = url.origin === location.origin && !link.target && !link.hasAttribute('download');
      const samePage = url.pathname === location.pathname && url.search === location.search;
      const plain = !e.defaultPrevented && e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const transition = sameOrigin && plain && !reduced && (samePage ? !url.hash && getScrollY() > AT_TOP : true);
      if (transition) {
        e.preventDefault();
        leave(url.href, link);
        return;
      }
      // everything else: the menu simply folds
      setOpen(false);
      if (!sameOrigin || !plain || !samePage) return; // another page with reduced motion (the router goes there itself), an external link, a new tab
      if (url.hash) return; // an anchor on this page: the browser scrolls to it
      e.preventDefault();
      if (reduced && getScrollY() > AT_TOP) {
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(0, { immediate: true });
        else (scrollBox() ?? window).scrollTo({ top: 0 });
      }
    };
    // Inquire: close menu, let the contact modal (when added) listen for this event
    const onNavClick = (e: MouseEvent) => {
      if (!(e.target as Element).closest('[data-contact-trigger]')) return;
      setOpen(false);
      document.dispatchEvent(new CustomEvent('open-contact-modal'));
    };
    // Stronger glass once the page scrolls (readability over light sections)
    const onScroll = () => nav.classList.toggle('is-scrolled', getScrollY() > SCROLLED_AT);

    btn.addEventListener('click', onToggle);
    document.addEventListener('click', onOutsideClick);
    document.addEventListener('keydown', onKeydown);
    panel.addEventListener('click', onLinkClick);
    // the page of a link is fetched the moment the finger is on it, ~100ms before the click: if it was not fetched yet, the transition waits for it
    const onLinkDown = (e: Event) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      const u = new URL(a.href, location.href);
      if (u.origin === location.origin && u.pathname !== location.pathname) prefetch(u.pathname + u.search, { ignoreSlowConnection: true });
    };
    panel.addEventListener('pointerdown', onLinkDown);
    logo.addEventListener('click', onLinkClick);
    nav.addEventListener('click', onNavClick);
    const offScroll = onPageScroll(onScroll);
    onScroll();

    return () => {
      window.removeEventListener('resize', measureOpen);
      glass.destroy();
      btn.removeEventListener('click', onToggle);
      document.removeEventListener('click', onOutsideClick);
      document.removeEventListener('keydown', onKeydown);
      panel.removeEventListener('click', onLinkClick);
      panel.removeEventListener('pointerdown', onLinkDown);
      logo.removeEventListener('click', onLinkClick);
      window.clearTimeout(rollTimer);
      window.clearTimeout(giveUp);
      window.clearTimeout(go);
      window.clearTimeout(warmTimer);
      nav.removeEventListener('click', onNavClick);
      offScroll();
    };
  });
</script>

<style>
  /* The pill paints no background of its own: the glass is a layer behind its content. The layer has the size of the OPEN pill all the time
     and is only revealed down to the pill's height (clip-path), so the element with the backdrop blur never changes size. */
  .nav-pill {
    --text: #f3efe4;
    --glass: rgba(24, 20, 16, 0.5);
    --border: rgba(255, 255, 255, 0.2);
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
    --head: 58px; /* the header's height */
    --radius: 34px;
    --blur: 10px;
    --intro: 1; /* 0-1: how much of the pill is shown while it arrives with the home page's intro (see Hero.astro) */
    --open-h: calc(var(--head) + 2px + min(100dvh - 7rem, 700px)); /* the pill's height when open (the script puts the measured one here) */

    position: fixed;
    top: 1.25rem;
    left: 50%;
    translate: -50% 0;
    width: min(94vw, 660px);
    z-index: 1000;
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--border) calc(var(--intro) * 100%), transparent);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, calc(0.22 * var(--intro))); /* drawn outside the box only, so it never shows through the glass */
    transition: border-radius 0.3s var(--ease); /* closing: quick, so that a chosen link starts its page transition soon */
  }
  .nav-pill.expanded {
    --radius: 28px;
    transition: border-radius 0.6s var(--ease); /* opening */
  }
  /* stronger glass once the page scrolls (readability over light sections) and while the menu is open */
  .nav-pill.is-scrolled,
  .nav-pill.expanded {
    --glass: rgba(24, 20, 16, 0.7);
  }

  .nav-glass {
    position: absolute;
    top: -1px; /* the glass covers the pill's border box */
    left: -1px;
    right: -1px;
    height: var(--open-h);
    z-index: -1;
    pointer-events: none;
    opacity: var(--intro); /* the glass's own opacity: unlike the pill's, it leaves the blur its view of the page */
    background: var(--glass);
    clip-path: inset(0 0 calc(var(--open-h) - var(--head) - 2px) 0 round var(--radius));
    transition: background 0.25s ease, clip-path 0.3s var(--ease);
  }
  .nav-pill.expanded .nav-glass {
    clip-path: inset(0 0 0 0 round var(--radius));
    transition: background 0.4s ease, clip-path 0.6s var(--ease);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .nav-glass {
      -webkit-backdrop-filter: blur(var(--blur)) saturate(140%);
      backdrop-filter: blur(var(--blur)) saturate(140%);
    }
    /* Chromium: the same blur, and the edge bends the light (glass-surface.ts adds the class and the filter) */
    .nav-glass.glass-refract {
      backdrop-filter: blur(var(--blur)) var(--glass-filter) saturate(140%);
    }
  }
  /* without blur support: a solid-enough background */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav-pill {
      --glass: rgba(24, 20, 16, 0.92);
    }
  }

  /* The pill is its own layer in a page transition, and a backdrop blur has nothing to sample there: the old pill and the new one
     were drawn differently (the menu seemed to load twice, and Safari flickered it). On touch devices the glass is therefore solid,
     and it is the same before, during and after a transition. */
  @media (pointer: coarse) {
    .nav-glass {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .nav-pill {
      --glass: rgba(34, 29, 25, 0.86);
    }
    .nav-pill.is-scrolled,
    .nav-pill.expanded {
      --glass: rgba(30, 26, 22, 0.92);
    }
  }

  .nav-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--head);
    padding: 0 1.25rem 0 1.5rem;
    opacity: var(--intro);
  }

  .nav-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .nav-btn:hover { color: var(--text); } /* the gold comes from the sliding letters and lines, not the whole button */
  .nav-btn:focus-visible,
  .nav-links a:focus-visible,
  .nav-logo:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* whole pixels only (8px block in a 24px button in a 58/64px header), so both hairlines land on the pixel grid and stay equally thick */
  #menu-btn { height: 24px; }
  .menu-lines { display: flex; flex-direction: column; gap: 6px; }
  .menu-lines span {
    width: 22px;
    height: 0;
    /* a border, not a background: borders snap to whole device pixels, so both lines stay equally thick at 125%/150% zoom */
    border-top: 1px solid currentColor;
    transition: transform 0.4s var(--ease), border-color var(--hover-time) var(--ease);
  }
  #menu-btn:hover .menu-lines span,
  #menu-btn:focus-visible .menu-lines span { border-color: var(--gold); }
  .expanded .menu-lines span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .expanded .menu-lines span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .nav-logo { justify-self: center; display: block; line-height: 0; }
  .nav-logo :global(img) {
    height: 40px;
    width: auto;
  }

  .inquire-btn {
    justify-self: end;
    gap: 0.9rem;
    padding: 0.65rem 1.4rem;
    border: 1px solid rgba(243, 239, 228, 0.4);
    border-radius: 999px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }
  /* same hover as the menu links: the letters slide up, a gold copy slides in from below */
  .inquire-btn:hover { color: var(--text); }
  .inquire-label { display: block; overflow: hidden; line-height: 1.35; }
  .arrow-icon { width: 30px; height: 12px; transition: color var(--hover-time) var(--ease); }
  .inquire-btn:hover .arrow-icon,
  .inquire-btn:focus-visible .arrow-icon { color: var(--gold); }

  /* Height animation without JS: 0fr -> 1fr */
  .nav-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease); /* closing: quick, so that a chosen link starts its page transition soon */
  }
  .expanded .nav-content {
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.6s var(--ease); /* opening */
  }

  .nav-body::-webkit-scrollbar { display: none; }

  .nav-body {
    min-height: 0;
    overflow: hidden auto;
    scrollbar-width: none; /* no scrollbar flash while the panel animates open */
    -ms-overflow-style: none;
    max-height: calc(100dvh - 7rem); /* never taller than the viewport */
  }

  /* Staggered reveal: links one after another, brand name last.
     Closing is instant-ish (no delays) so the panel doesn't linger. */
  .nav-links li,
  .nav-brand,
  .nav-footer {
    opacity: 0;
    translate: 0 12px;
    transition: opacity 0.2s ease, translate 0.2s ease;
  }
  .expanded .nav-links li,
  .expanded .nav-brand,
  .expanded .nav-footer {
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.55s ease, translate 0.7s var(--ease);
  }
  .expanded .nav-links li { transition-delay: calc(0.25s + var(--i) * 0.08s); }
  .expanded .nav-brand { transition-delay: 0.8s; }
  .expanded .nav-footer { transition-delay: 0.95s; }

  /* Open panel fills (almost) the whole screen: brand top, links centred, footer pinned bottom. Everything in it is sized by the window's
     height as well (the dvh values below), so the whole panel, footer included, fits on a low screen without scrolling. */
  .nav-inner {
    box-sizing: border-box; /* the padding is part of the height, or the panel would be taller than the space it gets */
    min-height: min(calc(100dvh - 7rem), 700px);
    padding: 0.75rem 1.5rem min(1.5rem, 2.4dvh);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nav-brand {
    margin: 0 0 min(1.75rem, 3dvh);
    text-align: center;
  }
  .nav-title {
    margin: 0;
    font-family: var(--font-logo, 'Cinzel Decorative', serif);
    font-size: min(clamp(1.15rem, 5.2vw, 2rem), 4.6dvh);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.2;
    white-space: nowrap;
    color: #ba8e47; /* gold from the logo */
  }
  .nav-subtitle {
    margin: min(0.6rem, 1dvh) 0 0;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: min(clamp(0.75rem, 2.8vw, 1rem), 2.6dvh);
    font-weight: 300;
    letter-spacing: 0.75em;
    padding-left: 0.75em; /* balances trailing letter-spacing so it centres */
    text-transform: uppercase;
    color: #fff;
  }

  .nav-links {
    list-style: none;
    margin: auto 0; /* centres the list between brand and footer */
    padding: min(1.5rem, 2.5dvh) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: min(1rem, 1.4dvh); /* space between the menu options */
  }
  .nav-links a {
    display: inline-block;
    overflow: hidden; /* the word slides up out of this window, a gold copy slides in from below */
    padding: 0 0.75rem;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: min(clamp(1.7rem, 6vw, 2.1rem), 4.5dvh);
    line-height: 1.35;
    font-weight: 400;
    color: var(--text);
    text-decoration: none;
  }
  .nav-word { display: block; white-space: pre; }
  /* Menu <-> Close (see rollLabel in the script): the old word slides up and out, the new one comes in from below. They are whole words
