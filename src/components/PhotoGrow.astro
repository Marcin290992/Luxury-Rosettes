---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LetterButton from './LetterButton.astro';

/**
 * Three photos side by side; scrolling grows the middle one to fill the screen (pushing the others out and dimming them), and a headline with a
 * button comes in over it (the "Other trips" section of the white-desert capture, lib/fx/otherTrips.js, written for this site). The scroll does
 * all of it (CSS sticky + a scrub that follows the scroll, as in the capture). The words of the headline rise out of their windows like every other
 * text of the site. On a phone, without the script, or with reduced motion: the middle photo alone with the headline and the button over it.
 */
interface Props {
  images: [ImageMetadata, ImageMetadata, ImageMetadata]; // left, middle (the one that grows), right
  alts?: [string, string, string];
  headline: string;
  cta: { label: string; href: string };
}
const { images, alts = ['', '', ''], headline, cta } = Astro.props;
const [left, mid, right] = images;
---

<section class="pg" data-photo-grow>
  <div class="pg-track" data-pg-track>
    <div class="pg-stage" data-pg-stage>
      <div class="pg-img pg-img--l" data-pg-left>
        <div class="pg-wrap"><Image src={left} alt={alts[0]} widths={[600, 1000]} sizes="34vw" loading="lazy" /></div>
      </div>
      <div class="pg-img pg-img--m" data-pg-mid>
        <Image src={mid} alt={alts[1]} widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" />
        <span class="pg-shade" data-pg-shade aria-hidden="true"></span>
      </div>
      <div class="pg-img pg-img--r" data-pg-right>
        <div class="pg-wrap"><Image src={right} alt={alts[2]} widths={[600, 1000]} sizes="34vw" loading="lazy" /></div>
      </div>

      <div class="pg-copy">
        <h2 class="pg-title">{headline}</h2>
        <div class="pg-btn" data-pg-btn><LetterButton label={cta.label} href={cta.href} arrow /></div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { mount } from '../scripts/lifecycle';
  import { WORD_HIDDEN } from '../scripts/settings';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  mount(() => {
    const mm = gsap.matchMedia();
    const splits: SplitText[] = [];

    mm.add('(min-width: 769px) and (prefers-reduced-motion: no-preference)', () => {
      const root = document.querySelector<HTMLElement>('[data-photo-grow]');
      if (!root) return;
      const track = root.querySelector<HTMLElement>('[data-pg-track]')!;
      const stage = root.querySelector<HTMLElement>('[data-pg-stage]')!;
      const left = root.querySelector<HTMLElement>('[data-pg-left]')!;
      const mid = root.querySelector<HTMLElement>('[data-pg-mid]')!;
      const right = root.querySelector<HTMLElement>('[data-pg-right]')!;
      const shade = root.querySelector<HTMLElement>('[data-pg-shade]')!;
      const btn = root.querySelector<HTMLElement>('[data-pg-btn]')!;
      root.dataset.live = '';

      const title = SplitText.create(root.querySelector('.pg-title')!, { type: 'words', mask: 'words' });
      splits.push(title);

      // the side photos rise in a little later than the middle one
      gsap.fromTo(
        [left, right],
        { yPercent: 12 },
        { yPercent: 0, ease: 'none', scrollTrigger: { trigger: root, start: 'top bottom', end: 'top top', scrub: true } },
      );

      // the middle photo grows to the full width, the others are pushed out and dim, then the headline and the button come in over it
      const tl = gsap.timeline({
        scrollTrigger: { trigger: track, start: 'top top', end: 'bottom bottom', scrub: true, invalidateOnRefresh: true },
      });
      tl.to(mid, { width: '100%', duration: 1, ease: 'power2.inOut' }, 0)
        .to(stage, { paddingLeft: 0, paddingRight: 0, duration: 1, ease: 'power2.inOut' }, 0)
        .fromTo(mid.querySelector('img'), { scale: 1.25 }, { scale: 1, duration: 1, ease: 'power2.inOut' }, 0)
        .to([left, right], { opacity: 0.4, duration: 1, ease: 'none' }, 0)
        .to(shade, { opacity: 1, duration: 0.5, ease: 'none' }, 0.6)
        .fromTo(title.words, { yPercent: WORD_HIDDEN }, { yPercent: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out' }, 0.85)
        .fromTo(btn, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power3.out' }, 1.3)
        .to({}, { duration: 0.35 });

      return () => {
        delete root.dataset.live;
        splits.splice(0).forEach((s) => s.revert());
      };
    });

    return () => mm.revert();
  }, '[data-photo-grow]');
</script>

<style>
  .pg {
    background: #0c0907;
    color: #f4ede0;
  }

  /* ---- a phone, no script, reduced motion: the middle photo alone, with the headline and the button over it ---- */
  .pg-stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .pg-img--l,
  .pg-img--r {
    display: none;
  }
  .pg-img--m {
    position: absolute;
    inset: 0;
  }
  .pg-img--m :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pg-shade {
    position: absolute;
    inset: 0;
    background: rgba(8, 7, 6, 0.5);
    pointer-events: none;
  }
  .pg-copy {
    position: relative;
    z-index: 1;
    padding: 0 6vw;
    text-align: center;
  }
  .pg-title {
    margin: 0 0 2rem;
    font-family: var(--font-heading, serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 9vw, 7rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pg-btn {
    display: flex;
    justify-content: center;
  }

  /* ---- with the script, from a tablet up: a tall track and a stage that sticks while the middle photo grows ---- */
  @media (min-width: 769px) {
    .pg[data-live] .pg-track {
      height: 200vh;
      height: 200svh;
    }
    .pg[data-live] .pg-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      display: flex;
      justify-content: center;
      padding-inline: 0.75rem;
      box-sizing: border-box;
    }
    .pg[data-live] .pg-img {
      position: relative;
      display: block;
      width: 33.3333%;
      height: 100%;
      overflow: clip;
      inset: auto;
    }
    .pg[data-live] .pg-img--m {
      flex: none;
      z-index: 2;
    }
    .pg[data-live] .pg-img--l .pg-wrap,
    .pg[data-live] .pg-img--r .pg-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: clip;
      max-width: calc(100% - 0.75rem);
    }
    .pg[data-live] .pg-img--r .pg-wrap {
      margin-left: auto;
    }
    .pg[data-live] .pg-img :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .pg[data-live] .pg-shade {
      opacity: 0;
    }
    .pg[data-live] .pg-copy {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      pointer-events: none;
    }
    .pg[data-live] .pg-btn {
      pointer-events: auto;
      visibility: hidden; /* the script shows it (autoAlpha) once the headline has come in */
    }
  }
</style>
