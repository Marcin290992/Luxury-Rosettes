---
import { Image } from 'astro:assets';
import LetterButton from './LetterButton.astro';
import type { ImageMetadata } from 'astro';
import { spots } from '../scripts/spots';

/**
 * One dark screen (after a "Roots" section): one huge word across the upper half that flies in letter by
 * letter from the right, and three overlapping photos that then grow out of nothing one after another, each cut to the shape of a spot (a clip-path; the same spots as in the Bengals section, see scripts/spots.ts). A line of text with a button stands bottom left. The photos follow the
 * mouse with different strengths. On its own it plays by itself, once, when it comes onto the screen; inside a StripeCover (the home page) it is pinned and the scroll plays it.
 * Without the script (or with reduced motion) everything is simply there. A demo of it is at /demo/roots-reveal.
 */
interface Props {
  images: [ImageMetadata, ImageMetadata, ImageMetadata]; // the tall one (front), the one behind it at the top, the one at the right
  word?: string;
  text?: string;
  cta?: { label: string; href: string };
}
const {
  images,
  word = 'Your Bengal',
  text = 'Every Bengal is raised in our home: handled daily, health-tested and ready to share yours.',
  cta = { label: 'Available kittens', href: '/available-kittens' },
} = Astro.props;
const [front, top, right] = images;

// the three windows: the same spots the photos of the Bengals section are cut to (the tall tapering one in front)
const SHAPES = [spots[1], spots[0], spots[3]];
---

<section class="rt" data-roots-reveal>
  <svg class="rt-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {SHAPES.map((d, i) => <clipPath id={`rt-spot-${i + 1}`} clipPathUnits="objectBoundingBox"><path d={d} /></clipPath>)}
    </defs>
  </svg>

  <div class="rt-trigger">
    <h2 class="rt-huge">{word}</h2>

    <div class="rt-float rt-float-3">
      <Image class="rt-pic rt-pic-3" src={right} alt="" widths={[500, 800]} sizes="30vw" loading="lazy" />
    </div>
    <div class="rt-float rt-float-2">
      <Image class="rt-pic rt-pic-2" src={top} alt="" widths={[600, 900]} sizes="40vw" loading="lazy" />
    </div>
    <div class="rt-float rt-float-1">
      <Image class="rt-pic rt-pic-1" src={front} alt="" widths={[500, 800]} sizes="34vw" loading="lazy" />
    </div>

    <div class="rt-col">
      <p class="rt-text">{text}</p>
      <div class="rt-btn"><LetterButton label={cta.label} href={cta.href} arrow /></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { mount } from '../scripts/lifecycle';
  import { WORD_HIDDEN } from '../scripts/settings';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // ---------- the numbers ----------
  const WORD = { stagger: 0.05, duration: 1.3 }; // the letters of the huge word rising out of their windows (the same as the hero's name)
  const SPOTS = { pause: 0.5, stagger: 0.45, duration: 1.5 }; // the spots growing from their centres, one after another (`pause`: seconds the finished word stands alone before the first one starts)
  const ENTRANCE = 0.65; // inside a StripeCover (the section is pinned and scrubbed by the scroll): the share of the scrolling the entrance takes
  const FOLLOW = [0.09, 0.06, 0.035]; // how much each photo follows the mouse (front, top, right)

  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-roots-reveal]');
    if (!root) return;
    const trigger = root.querySelector<HTMLElement>('.rt-trigger')!;
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const splits: SplitText[] = [];
      let alive = true;

      // the photos follow the mouse, each with its own strength
      const floats = ['.rt-float-1', '.rt-float-2', '.rt-float-3'].map((sel, i) => {
        const el = root.querySelector<HTMLElement>(sel)!;
        return {
          strength: FOLLOW[i],
          xTo: gsap.quickTo(el, 'x', { duration: 1.2, ease: 'power3' }),
          yTo: gsap.quickTo(el, 'y', { duration: 1.2, ease: 'power3' }),
        };
      });
      const onMove = (e: MouseEvent) => {
        const dx = e.clientX - innerWidth / 2;
        const dy = e.clientY - innerHeight / 2;
        floats.forEach((f) => {
          f.xTo(dx * f.strength);
          f.yTo(dy * f.strength);
        });
      };
      window.addEventListener('mousemove', onMove);

      document.fonts.ready.then(() => {
        if (!alive) return;
        const text = SplitText.create(root.querySelector('.rt-text')!, { type: 'words', mask: 'words' });
        const huge = SplitText.create(root.querySelector('.rt-huge')!, { type: 'chars,words', mask: 'words' });
        splits.push(text, huge);

        // the huge word, the three photos one after another (the one behind, at the top, first: the tall one in front covers part of it), then the line of text and the button. Inside a StripeCover
        // the section is pinned and the scroll plays it (then a hold, then the stripes close it); on its own it plays by itself, once.
        // on a touch screen a flick of the finger runs through the scroll in a blink: the scrub then trails far behind the finger (so the
        // photos always grow where they can be seen) and the entrance takes a bigger share of the scrolling
        const touch = matchMedia('(pointer: coarse)').matches;
        const share = touch ? 0.6 : ENTRANCE; // a touch screen: more empty scrolling at the end, so the finished section can be seen before the stripes
        const wrap = root.closest<HTMLElement>('[data-stripe-cover]');
        // the photos wait until the last letter of the word has landed (and a pause on top), so the word is seen whole first
        const spotsAt = WORD.duration + (huge.chars.length - 1) * WORD.stagger + SPOTS.pause;
        const tl = gsap
          .timeline({
            defaults: { ease: 'power3.out' },
            scrollTrigger: wrap ? { trigger: wrap, start: 'top top', end: 'bottom bottom', scrub: touch ? 1.5 : 1.1 } : { trigger, start: 'top 60%', once: true },
          })
          .from(huge.chars, { yPercent: WORD_HIDDEN, ...WORD, ease: 'power3.out' }, 0)
          .from([2, 1, 3].map((n) => root.querySelector(`#rt-spot-${n} path`)!), { scale: 0, svgOrigin: '0.5 0.5', stagger: SPOTS.stagger, duration: SPOTS.duration, ease: 'power2.inOut' }, spotsAt)
          .from(text.words, { yPercent: 110, duration: 0.9, stagger: 0.05 }, spotsAt + 1.2)
          .from(root.querySelector('.rt-btn')!, { opacity: 0, y: 20, duration: 0.8 }, spotsAt + 1.8);
        // the rest of the scrolling (a hold, then the stripes) is empty time at the end of the timeline
        if (wrap) tl.to({}, { duration: tl.duration() * (1 / share - 1) }, '>');

        ScrollTrigger.refresh();
      });

      return () => {
        alive = false;
        window.removeEventListener('mousemove', onMove);
        splits.forEach((s) => s.revert());
        gsap.set(root.querySelectorAll('.rt-float, .rt-float *, .rt-btn'), { clearProps: 'all' });
      };
    });

    return () => mm.revert();
  }, '[data-roots-reveal]');
</script>

<style is:global>
  .rt {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    overflow: clip;
    background: var(--ink-warm, #1a1410);
    color: var(--cream, #efe9dc);
  }
  /* everything is placed on the screen as on the picture: the photos overlap, the word is behind them, the text in front */
  .rt-trigger { position: relative; min-height: 100svh; }
  .rt-huge {
    position: absolute; left: 0; right: 0; top: 11%; z-index: 1; margin: 0; text-align: center;
    font: 300 clamp(5rem, 14vw, 16rem) / 1 var(--font-heading, serif);
    color: color-mix(in srgb, var(--gold, #d4af37) 55%, var(--cream, #efe9dc));
    text-transform: uppercase; white-space: nowrap;
  }
  .rt-col { position: absolute; left: 12%; bottom: 5%; z-index: 5; width: 38%; }
  .rt-text { margin: 0; font: 300 clamp(1.8rem, 3.4vw, 3.6rem) / 1.05 var(--font-heading, serif); color: var(--cream, #efe9dc); }
  .rt-btn { margin-top: 2rem; }

  /* the three photos: the top one is behind the huge word (z-index 0, the word is 1), the one at the right is behind the tall one */
  .rt-defs { position: absolute; width: 0; height: 0; }
  .rt-float { position: absolute; will-change: transform; }
  .rt-float-3 { z-index: 2; left: 73%; top: 42%; width: 23%; height: 52%; }
  .rt-float-2 { z-index: 0; left: 61%; top: 2%; width: 31%; height: 47%; }
  .rt-float-1 { z-index: 4; left: 53%; top: 15%; width: 24%; height: 77%; }
  .rt-pic { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rt-pic-1 { clip-path: url(#rt-spot-1); }
  .rt-pic-2 { clip-path: url(#rt-spot-2); }
  .rt-pic-3 { clip-path: url(#rt-spot-3); }

  @media (max-width: 1023px) {
    /* the menu pill covers the top ~6.5rem of the screen: the word starts below it */
    .rt-huge { top: 8.4rem; font-size: clamp(3rem, 15vw, 7rem); }
    .rt-col { left: 5vw; width: 90%; bottom: 3%; }
    .rt-text { font-size: clamp(1.25rem, 5.4vw, 2rem); }
    .rt-float-2 { left: 30%; top: 28%; width: 66%; height: 27%; }
    .rt-float-1 { left: 22%; top: 36%; width: 58%; height: 34%; }
    .rt-float-3 { left: 3%; top: 53%; width: 44%; height: 20%; }
  }
</style>
