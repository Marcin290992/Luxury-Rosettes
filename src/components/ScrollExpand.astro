---
// Vanilla scroll-expand: a framed image opens up to fill the screen as you scroll, then hands over to
// the slotted content. No dependencies — just a scroll listener and requestAnimationFrame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  title?: string;
  scrollHint?: string;
  startWidth?: number; // % of the screen the frame starts at
  startHeight?: number;
  startRadius?: number; // px
  endRadius?: number;
  mediaZoom?: number; // image starts zoomed in by this factor and settles to 1
  scrollDistance?: number; // screens of scrolling the expansion takes
  holdDistance?: number; // screens it stays fully open afterwards
  smoothing?: number; // seconds of easing towards the scroll position (0 = none)
  startScrim?: number; // 0..1 darkening while the frame is still small, so the title stays readable
  overlayScrim?: number; // 0..1 darkening once open, so slotted text stays readable
}

const {
  image,
  alt = '',
  title = '',
  scrollHint = '',
  startWidth = 42,
  startHeight = 58,
  startRadius = 18,
  endRadius = 0,
  mediaZoom = 1.35,
  scrollDistance = 1.2,
  holdDistance = 0.35,
  smoothing = 0.08,
  startScrim = 0.6,
  overlayScrim = 0.6,
} = Astro.props;

const has = Astro.slots.has('default');
---

<section
  class="scroll-expand"
  data-scroll-expand
  data-start-width={startWidth}
  data-start-height={startHeight}
  data-start-radius={startRadius}
  data-end-radius={endRadius}
  data-media-zoom={mediaZoom}
  data-scroll-distance={scrollDistance}
  data-hold-distance={holdDistance}
  data-smoothing={smoothing}
  data-start-scrim={startScrim}
  data-overlay-scrim={overlayScrim}
>
  <div class="se-track">
    <div class="se-stage">
      <div class="se-frame">
        <Image class="se-media" src={image} alt={alt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" draggable="false" />
        <div class="se-scrim"></div>
        {
          has && (
            <div class="se-overlay">
              <slot />
            </div>
          )
        }
      </div>
      {title && <div class="se-title">{title}</div>}
      {scrollHint && <div class="se-hint">{scrollHint}</div>}
      <div class="se-dim" aria-hidden="true"></div>
      <div class="se-probe" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  import { clamp, smoothstep } from '../scripts/math';

  function init(root: HTMLElement) {
    const num = (key: string, fallback: number) => {
      const v = parseFloat(root.dataset[key] ?? '');
      return Number.isFinite(v) ? v : fallback;
    };
    const c = {
      startWidth: num('startWidth', 42),
      startHeight: num('startHeight', 58),
      startRadius: num('startRadius', 18),
      endRadius: num('endRadius', 0),
      mediaZoom: num('mediaZoom', 1.35),
      scrollDistance: num('scrollDistance', 1.2),
      holdDistance: num('holdDistance', 0.35),
      smoothing: num('smoothing', 0.08),
      startScrim: num('startScrim', 0.6),
      overlayScrim: num('overlayScrim', 0.6),
    };

    const track = root.querySelector<HTMLElement>('.se-track')!;
    const stage = root.querySelector<HTMLElement>('.se-stage')!;
    const frame = root.querySelector<HTMLElement>('.se-frame')!;
    const media = root.querySelector<HTMLElement>('.se-media')!;
    const scrim = root.querySelector<HTMLElement>('.se-scrim');
    const title = root.querySelector<HTMLElement>('.se-title');
    const hint = root.querySelector<HTMLElement>('.se-hint');
    const overlay = root.querySelector<HTMLElement>('.se-overlay');
    const probe = root.querySelector<HTMLElement>('.se-probe')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let stageH = 0; // the stage is as tall as the LARGEST viewport (lvh) and never changes with the mobile address bar
    let visibleH = 0; // the part that is visible while the bar is showing (svh)
    let boxW = 0;
    let lastW = window.innerWidth;
    let current = 0;
    let target = 0;
    let raf = 0;

    // Start rectangle (all in % of the stage). Laptops: as configured. Phones and tablets: a SQUARE, centred in the
    // visible part of the screen.
    const start = () => {
      if (boxW >= 1024) return { w: c.startWidth, h: c.startHeight, cy: 50 };
      const side = Math.min(boxW * 0.74, visibleH * 0.5);
      return { w: (side / boxW) * 100, h: (side / stageH) * 100, cy: (visibleH / 2 / stageH) * 100 };
    };
    let st = { w: c.startWidth, h: c.startHeight, cy: 50 };

    const apply = (p: number) => {
      const e = smoothstep(0, 1, p);
      const w = st.w + (100 - st.w) * e;
      const h = st.h + (100 - st.h) * e;
      const cy = st.cy + (50 - st.cy) * e;
      const ix = Math.max(0, (100 - w) / 2);
      const top = Math.max(0, cy - h / 2);
      const bottom = Math.max(0, 100 - top - h);
      const r = c.startRadius + (c.endRadius - c.startRadius) * e;
      frame.style.clipPath = `inset(${top.toFixed(3)}% ${ix.toFixed(3)}% ${bottom.toFixed(3)}% ${ix.toFixed(3)}% round ${r}px)`;
      media.style.transform = `scale(${c.mediaZoom + (1 - c.mediaZoom) * e})`;
      if (scrim) scrim.style.opacity = `${c.startScrim + (c.overlayScrim - c.startScrim) * e}`;
      if (title) {
        const out = smoothstep(0.4, 0.88, p);
        title.style.opacity = `${1 - out}`;
        title.style.transform = `translate3d(0, ${-28 * out}px, 0) scale(${1 + 0.06 * out})`;
      }
      if (hint) {
        const gone = smoothstep(0, 0.12, p);
        hint.style.opacity = `${1 - gone}`;
        hint.style.transform = `translate3d(0, ${8 * gone}px, 0)`;
      }
      if (overlay) {
        const inn = smoothstep(0.68, 1, p);
        overlay.style.opacity = `${inn}`;
        overlay.style.transform = `translate3d(0, ${18 * (1 - inn)}px, 0)`;
        overlay.style.pointerEvents = inn > 0.5 ? 'auto' : 'none';
      }
    };

    const measure = () => {
      // heights come from CSS (lvh): only the length of the track is set here, also in lvh, so nothing changes in
      // px when the address bar slides away
      track.style.height = `calc(100vh * ${1 + Math.max(0, c.scrollDistance) + Math.max(0, c.holdDistance)})`;
      track.style.height = `calc(100lvh * ${1 + Math.max(0, c.scrollDistance) + Math.max(0, c.holdDistance)})`;
      stageH = stage.offsetHeight;
      visibleH = probe.offsetHeight;
      boxW = root.clientWidth;
      st = start();
      stage.style.setProperty('--se-title-size', `${clamp(boxW * 0.075, 28, 96)}px`);
    };
    const progress = () => clamp(-track.getBoundingClientRect().top / (stageH * Math.max(0.01, c.scrollDistance)), 0, 1);

    const tick = () => {
      // frame-rate independent ease towards the scroll position
      const k = c.smoothing <= 0 ? 1 : 1 - Math.exp(-1 / (60 * c.smoothing));
      current += (target - current) * k;
      const settled = Math.abs(target - current) < 0.0004;
      if (settled) current = target;
      apply(current);
      raf = settled ? 0 : requestAnimationFrame(tick);
    };
    const onScroll = () => {
      target = progress();
      if (c.smoothing <= 0 || reduceMotion) {
        current = target;
        apply(current);
      } else if (!raf) {
        raf = requestAnimationFrame(tick);
      }
    };
    const onResize = () => {
      // only the height changed = the mobile address bar sliding in or out: nothing to re-measure, nothing may jump
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      measure();
      target = current = progress();
      apply(current);
    };

    measure();
    target = current = progress();
    apply(current);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    // layout above can shift after fonts/images load or a pin is created
    window.addEventListener('load', () => {
      lastW = -1; // force a re-measure once everything above has settled
      onResize();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-scroll-expand]').forEach(init);
</script>

<style>
  .scroll-expand {
    position: relative;
    z-index: 2; /* above the stage, so it can slide over it */
    width: 100%;
  }
  .se-track {
    position: relative;
    width: 100%;
  }
  .se-stage {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    background: #16120e; /* opaque + dark: covers the stage behind it, and white type reads everywhere */
    --se-title-size: 4rem;
  }
  .se-frame {
    position: absolute;
    inset: 0;
    clip-path: inset(21% 29% 21% 29% round 18px);
    will-change: clip-path;
  }
  .se-frame :global(.se-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform-origin: center;
    user-select: none;
    -webkit-user-drag: none;
  }
  .se-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.45) 50%, rgba(0, 0, 0, 0.55));
    opacity: 0;
  }
  .se-overlay {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6%;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .se-probe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100vh;
    height: 100svh;
    visibility: hidden;
    pointer-events: none;
  }
  .se-title {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100vh;
    height: 100svh; /* centred on what is visible while the address bar is up */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6%;
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--se-title-size);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    will-change: opacity, transform;
  }
  /* darkened by the next chapter while it slides over this one */
  .se-dim {
    position: absolute;
    inset: 0;
    background: #0b0907;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }
  .se-hint {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100svh - 2.8rem);
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    pointer-events: none;
    will-change: opacity, transform;
  }
</style>
