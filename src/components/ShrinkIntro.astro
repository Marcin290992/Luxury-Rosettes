---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/img/hero_img.webp';

/**
 * An opening for a page (after the Codegrid "Waabi Scroll Animation", see scripts/shrink-intro.ts): a photo fills the screen
 * with a headline on it (it opens like the home page: the photo settles, the letters rise); scrolling sends the headline away, then shrinks the photo to a small
 * tile while four columns of small photos drift up around a line of text, and a quiet closing line follows.
 * Without the script (or with reduced motion) it is the photo with its headline, a grid of the small photos and the closing line.
 */
interface Props {
  headline: string;
  collection: string;
  closing?: string; // an optional quiet line at the end
}
const { headline, collection, closing } = Astro.props;

// Sixteen small photos, four to a column. Sample ones for now (the cats and the story photos, some of them twice): to be replaced
// with the photos of the page.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/img/{cats,story}/*.webp', { eager: true });
const pool = Object.values(found).map((m) => m.default);
const tiles = Array.from({ length: 16 }, (_, i) => pool[(i * 5) % pool.length]);
const columns = [0, 1, 2, 3].map((c) => tiles.slice(c * 4, c * 4 + 4));
---

<div class="si">
  <section class="si-hero" id="shrink-intro">
    <div class="si-pin">
      <div class="si-img">
        <Image src={hero} alt="" widths={[900, 1600, 2400]} sizes="100vw" loading="eager" />
        <span class="si-shade" aria-hidden="true"></span>
      </div>
      <div class="si-header"><h1 set:html={headline} /></div>
    </div>
  </section>

  <section class="si-about">
    <div class="si-cols" aria-hidden="true">
      {
        columns.map((column) => (
          <div class="si-col">
            {column.map((img) => (
              <div class="si-tile">
                <Image src={img} alt="" widths={[200, 400]} sizes="125px" loading="lazy" />
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <div class="si-about-text"><h3>{collection}</h3></div>
    <!-- stripes in the colour of the dark page: they rise from the bottom one after another and cover the held screen, and the next section follows
         (the script draws them; without it they are not shown) -->
    <div class="si-stripes" aria-hidden="true">
      <div></div><div></div><div></div><div></div><div></div>
    </div>
  </section>
  <div class="si-hold" aria-hidden="true"></div>

  {
    closing && (
      <section class="si-outro">
        <h3>{closing}</h3>
      </section>
    )
  }
</div>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initShrinkIntro } from '../scripts/shrink-intro';

  mount(() => {
    const root = document.querySelector<HTMLElement>('.si');
    return root ? initShrinkIntro(root) : undefined;
  });
</script>

<style>
  .si {
    background: var(--paper);
    color: var(--ink);
    display: flow-root; /* the margin under the held section stays inside, so there is room for it to stay put */
  }
  .si h1,
  .si h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    line-height: 1.02;
    margin: 0;
  }
  .si h1 {
    font-size: clamp(2.6rem, 6vw, 5.5rem);
  }
  .si h3 {
    font-size: clamp(1.8rem, 3.2vw, 3rem);
  }

  /* ---- without the script: the photo with its headline, a grid of the small photos, the closing line ---- */
  .si-pin {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: clamp(5.5rem, 14vh, 9rem) 1.5rem 3rem;
    color: #fff;
    overflow: hidden;
  }
  .si-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .si-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .si-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0.35));
  }
  .si-header {
    position: relative;
    max-width: 52rem;
  }
  .si-about {
    padding: var(--space) 1.5rem;
    text-align: center;
  }
  .si-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 40rem;
    margin: 0 auto 3rem;
  }
  .si-col {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .si-tile {
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
  }
  .si-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .si-about-text h3,
  .si-outro h3 {
    max-width: 40rem;
    margin: 0 auto;
  }
  .si-outro {
    padding: clamp(5rem, 14vh, 9rem) 1.5rem;
    text-align: center;
    background: #ebe7dc; /* a shade darker than the page, as in the original */
  }

  /* ---- with the script: the photo, its lines and the tile are pinned in a tall track ---- */
  .si-hero[data-live] {
    height: calc((1 + var(--si-length)) * 100svh);
  }
  .si-hero[data-live] .si-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    display: block;
  }
  .si-hero[data-live] .si-img {
    /* centred by auto margins, not by translate(-50%, -50%): on a window with an odd width or height the translate is a half pixel,
       which the layout does not round, so the photo sat half a pixel off and a hairline of the paper showed along one edge */
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    will-change: width, height;
  }
  .si-hero[data-live] .si-header {
    position: absolute;
    inset: 0;
    max-width: none;
    padding: clamp(2rem, 4vw, 4rem);
    display: flex;
    align-items: flex-end;
    will-change: transform, opacity;
  }
  .si-hero[data-live] .si-header h1 {
    width: min(75%, 56rem);
  }

  /* the next section rises under the last part of the pin (the tile is still on the screen), over the shrinking photo */
  /* The section stays put on the screen (sticky) for two more screens of scrolling while the tiles drift up and out of it; the next section is
     pulled up over its end (see the `pull` of CatStack on the page) and slides up over it. The hold is a block of that length after it: a sticky
     box can only stay within its parent, and a margin is part of the box, so it would give it no room. */
  .si-stripes {
    display: none;
  }
  .si-hero[data-live] + .si-about .si-stripes {
    display: flex;
    flex-direction: column;
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .si-hero[data-live] + .si-about .si-stripes div {
    flex: 1;
    margin-top: -1px;
    background: var(--ink-warm, #1a1410);
    transform: scaleY(0);
    transform-origin: bottom;
  }
  .si-hold {
    display: none;
  }
  .si-hero[data-live] ~ .si-hold {
    display: block;
    height: 220vh;
    height: 220svh;
  }
  .si-hero[data-live] + .si-about {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    margin-top: calc(var(--si-overlap) * -100svh);
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .si-hero[data-live] + .si-about .si-cols {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0;
    max-width: none;
    margin: 0;
    padding: 4rem;
  }
  .si-hero[data-live] + .si-about .si-col {
    position: relative;
    height: 125%;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    will-change: transform;
  }
  .si-hero[data-live] + .si-about .si-tile {
    width: 125px;
    height: 125px;
    aspect-ratio: auto;
  }
  .si-hero[data-live] + .si-about .si-about-text {
    position: relative;
    width: min(40%, 34rem);
  }

  @media (max-width: 1000px) {
    .si-hero[data-live] .si-header h1 {
      width: 100%;
    }
    .si-hero[data-live] + .si-about .si-cols {
      padding: 2rem;
    }
    .si-hero[data-live] + .si-about .si-tile {
      width: 75px;
      height: 75px;
      opacity: 0.25;
      filter: saturate(0);
    }
    .si-hero[data-live] + .si-about .si-about-text {
      width: 100%;
      padding: 2rem;
    }
  }
</style>
