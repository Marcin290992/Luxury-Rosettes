---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The kittens on a tilted ring in 3D that turns slowly, with a depth of field (after the React Bits "Spin Shutter", rewritten as plain WebGL2,
 * see scripts/spin-shutter.ts). Hover or click a card to bring it forward, drag to turn the ring; a click on the front card goes to its `href`.
 * Without the script (or without WebGL2) the same markup is a grid of the photos with their names.
 */
interface Props {
  items: { img: ImageMetadata; alt: string; title: string; subtitle?: string; href?: string }[];
  label?: string;
}
const { items, label = 'The kittens on a turning ring. Point at a photo to focus on it, click to bring it forward, drag to turn the ring.' } = Astro.props;
const photos = await Promise.all(items.map((i) => getImage({ src: i.img, width: 1024, format: 'webp' })));
---

<div class="ss" role="region" aria-roledescription="carousel" aria-label={label} tabindex="0">
  <div class="ss-stage"></div>
  <ul class="ss-items">
    {
      items.map((it, i) => (
        <li data-href={it.href}>
          <img src={photos[i].src} alt={it.alt} width={photos[i].attributes.width} height={photos[i].attributes.height} loading="eager" decoding="async" />
          <span class="ss-title">{it.title}</span>
          {it.subtitle && <span class="ss-sub">{it.subtitle}</span>}
        </li>
      ))
    }
  </ul>
  <div class="ss-caption" aria-hidden="true"><span class="ss-caption-title"></span><span class="ss-caption-sub"></span></div>
  <div class="ss-live" aria-live="polite"></div>
  <!-- whatever the page puts in the slot stands in the middle of the ring; the pointer goes through to the cards -->
  <div class="ss-center"><slot /></div>
</div>

<!-- without JS the photos are a plain grid (with JS the list is hidden from the first paint: no flash of the grid before the ring) -->
<noscript>
  <style is:inline>
    .ss { height: auto !important; padding: 2rem 1.5rem; }
    .ss .ss-items { position: static !important; width: auto !important; height: auto !important; margin: 0 !important; clip: auto !important; overflow: visible !important; white-space: normal !important; display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 1rem; list-style: none; padding: 0; }
    .ss img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; display: block; }
    .ss .ss-title, .ss .ss-sub { display: block; font-size: 0.9rem; }
    .ss .ss-center, .ss .ss-caption { display: none; }
  </style>
</noscript>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initSpinShutter } from '../scripts/spin-shutter';
  import { getLenis } from '../scripts/lenis';

  mount(() => {
    const root = document.querySelector<HTMLElement>('.ss');
    if (!root) return;
    const destroy = initSpinShutter(root);
    if (!destroy) root.dataset.fallback = ''; // no WebGL2: the photos stay as a plain grid
    // a click on the front card: the page moves on to the card's link (#anchors scroll, smoothly)
    const onSelect = (e: Event) => {
      const href = (e as CustomEvent<{ href: string }>).detail.href;
      if (href.startsWith('#')) {
        const target = document.querySelector<HTMLElement>(href);
        if (!target) return;
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(target, { offset: -80 });
        else target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else window.location.assign(href);
    };
    root.addEventListener('ss:select', onSelect);
    return () => {
      root.removeEventListener('ss:select', onSelect);
      destroy?.();
    };
  }, '.ss');
</script>

<style>
  .ss {
    position: relative;
    width: 100%;
    height: clamp(26rem, 70vh, 40rem);
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    outline: none;
  }
  .ss:focus-visible {
    outline: 2px solid color-mix(in oklch, currentColor 35%, transparent);
    outline-offset: -2px;
  }
  .ss-stage {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .ss :global(canvas) {
    -webkit-user-drag: none;
  }

  /* without the script: a grid of the photos with their names */
  .ss[data-fallback] {
    height: auto;
    padding: 2rem 1.5rem;
  }
  .ss[data-fallback] .ss-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ss[data-fallback] img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }
  .ss[data-fallback] .ss-title,
  .ss[data-fallback] .ss-sub {
    display: block;
    font-size: 0.9rem;
  }
  .ss[data-fallback] .ss-sub {
    opacity: 0.6;
  }
  .ss[data-fallback] {
    display: flex;
    flex-direction: column;
  }
  .ss[data-fallback] .ss-center {
    position: static;
    transform: none;
    order: -1;
    width: auto;
    margin: 0 auto 2rem;
  }
  .ss[data-fallback] .ss-caption {
    display: none;
  }

  /* with it: the list is only for screen readers */
  .ss:not([data-fallback]) .ss-items,
  .ss-live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .ss-center {
    position: absolute;
    left: var(--ss-cx, 50%);
    top: var(--ss-cy, 50%);
    transform: translate(-50%, -50%);
    width: min(100%, 44rem);
    text-align: center;
    pointer-events: none;
  }
  .ss-caption {
    position: absolute;
    left: 50%;
    bottom: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%);
    will-change: opacity;
  }
  .ss-caption-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.25;
  }
  .ss-caption-sub {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    opacity: 0.55;
  }
</style>
