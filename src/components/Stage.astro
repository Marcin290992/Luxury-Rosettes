---
import Hero from './Hero.astro';
import Story from './Story.astro';
---

<!--
  Desktop: hero + story share one pinned stage. A SINGLE scroll-scrubbed timeline drives everything
  (zoom into the eye → cream wash → photos/text enter → steps 01-03 → fade out), so scroll position is
  the only state: wheel, scrollbar, keys and touch all behave the same, and going back is the exact reverse.
  Mobile / reduced motion: no pin — plain hero followed by the stacked story.
-->
<div id="stage">
  <Hero />
  <Story />
  <div class="stage-dim" aria-hidden="true"></div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initLenis } from '../scripts/lenis';

  gsap.registerPlugin(ScrollTrigger);
  // the mobile address bar sliding in/out changes the window height: that must not re-measure the pins
  ScrollTrigger.config({ ignoreMobileResize: true });

  // ---- photo shapes ------------------------------------------------------------------------------
  // Rounded polygon as a path with a fixed command structure, so GSAP can tween one shape into another.
  // Coordinates are 0..1 (objectBoundingBox), t = how much of each edge the rounded corner eats.
  type Pt = [number, number];
  const rounded = (pts: Pt[], t = 0.12) => {
    const n = pts.length;
    const lerp = (a: Pt, b: Pt, k: number): Pt => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k];
    const f = (p: Pt) => `${p[0].toFixed(4)} ${p[1].toFixed(4)}`;
    const s = pts.map((v, i) => lerp(v, pts[(i + n - 1) % n], t));
    const e = pts.map((v, i) => lerp(v, pts[(i + 1) % n], t));
    return `M ${f(e[n - 1])}` + pts.map((v, i) => ` L ${f(s[i])} Q ${f(v)} ${f(e[i])}`).join('') + ' Z';
  };
  const bigShapes = [
    rounded([[0.2, 0], [1, 0], [0.9, 1], [0, 0.72]]),
    rounded([[0, 0.05], [0.88, 0], [1, 0.76], [0.12, 1]]),
    rounded([[0.12, 0], [1, 0.12], [0.86, 1], [0, 0.88]]),
  ];
  const smallShapes = [
    rounded([[0, 0], [0.55, 0.1], [1, 0.85], [0.1, 1]]),
    rounded([[0.1, 0.05], [1, 0], [0.9, 0.9], [0, 1]]),
    rounded([[0, 0.12], [0.9, 0], [1, 1], [0.15, 0.9]]),
  ];

  // Wrap every word in a masked span so it can slide up out of a clip
  const splitWords = (el: HTMLElement) => {
    const words = (el.textContent ?? '').trim().split(/\s+/);
    el.setAttribute('aria-label', words.join(' '));
    el.innerHTML = words
      .map((w) => `<span class="w" aria-hidden="true"><span class="wi">${w}</span></span>`)
      .join(' ');
    return Array.from(el.querySelectorAll<HTMLElement>('.wi'));
  };
  // Delay per word: lines cascade, words cascade a little within each line
  const lineOf = (el: HTMLElement) => el.parentElement!.offsetTop;
  const wordDelays = (words: HTMLElement[], perLine = 0.14, perWord = 0.035) => {
    const tops = [...new Set(words.map(lineOf))].sort((a, b) => a - b);
    return {
      lines: tops.length,
      delays: words.map((w, i) => {
        const first = words.findIndex((x) => lineOf(x) === lineOf(w));
        return tops.indexOf(lineOf(w)) * perLine + (i - first) * perWord;
      }),
    };
  };

  // ---- timeline layout (seconds; the scroll distance is PX_PER_SEC × total length) -----------------
  const PX_PER_SEC = 520; // higher = the whole sequence is spread over more scrolling (slower)
  const ZOOM = 2.4; // zoom into the eye
  const WASH = 1.7; // cream wash starts (ends with the zoom)
  const INTRO = ZOOM + 0.25; // photos + text enter only once the screen is fully cream — never over the eye, in either direction
  const FIRST_STEP = 4.2; // when step 01 → 02 starts
  const STEP_GAP = 2.4; // distance between transitions
  const STEP_DUR = 1.6;
  const HOLD_END = 9; // step 03 stays until here; the last screen of the pin is the next section covering it

  const mm = gsap.matchMedia();
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    initLenis(); // smooth wheel only — it never changes where the page is

    const stage = document.getElementById('stage')!;
    const story = document.getElementById('story')!;
    let ctx: gsap.Context | undefined;
    let cancelled = false;

    stage.dataset.stage = '';
    story.dataset.pinned = '';

    // Line breaks depend on the web font, so build once fonts are ready
    document.fonts.ready.then(() => {
      if (cancelled) return;
      ctx = gsap.context(() => build(stage, story), stage);
    });

    return () => {
      cancelled = true;
      ctx?.revert();
      delete stage.dataset.stage;
      delete story.dataset.pinned;
    };
  });

  // ---- tablets and phones --------------------------------------------------------------------------
  // The story's pinned layout is made for wide screens, so below 1024px only the HERO is pinned: its whole
  // sequence stays (the dive into the eye, the cream wash, the opening text leaving) and then hands over to the
  // normal, stacked story. The wash ends on the page colour, so the hand-over has no seam.
  const small = gsap.matchMedia();
  small.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    initLenis();
    const hero = document.getElementById('hero')!;
    const heroImg = hero.querySelector<HTMLElement>('.hero-img')!;
    const fade = hero.querySelector<HTMLElement>('.hero-fade')!;
    const storyEl = document.getElementById('story')!;
    const DIVE = 2.1; // screens of swiping for the dive itself ...
    const LIFT = 1; // ... and one more while the story rises over the cream (no empty page in between)
    const heroBox = stickIn(hero, 1 + DIVE + LIFT);
    const eye = () => JSON.parse(heroImg.dataset.eye ?? '{"ox":40,"oy":40,"w":0}') as { ox: number; oy: number; w: number };
    const origin = () => `${eye().ox}% ${eye().oy}%`;
    // the eye should end up filling most of the short side of the screen (7 on a laptop; a phone needs less)
    const scale = () => {
      const w = eye().w || window.innerWidth * 0.12;
      return Math.min(8, Math.max(3.5, (0.9 * Math.min(window.innerWidth, window.innerHeight)) / w));
    };

    const tl = gsap.timeline({
      defaults: { immediateRender: false },
      scrollTrigger: {
        trigger: heroBox,
        start: 'top top',
        end: () => `+=${heroBox.offsetHeight - hero.offsetHeight}`,
        invalidateOnRefresh: true,
        scrub: 0.7,
      },
    });
    tl.fromTo(
      heroImg,
      { scale: 1, xPercent: 0, yPercent: 0, transformOrigin: origin },
      { scale, xPercent: () => 50 - eye().ox, yPercent: () => 50 - eye().oy, transformOrigin: origin, duration: ZOOM, ease: 'power3.inOut' },
      0,
    )
      .fromTo(fade, { opacity: 0 }, { opacity: 1, duration: ZOOM - WASH, ease: 'power1.in' }, WASH)
      .fromTo('.hero-content', { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -40, duration: 0.9, ease: 'power2.in' }, 0);
    tl.set({}, {}, ZOOM * ((DIVE + LIFT) / DIVE)); // the dive takes the first part of the pin; the rest is the story rising

    // the story is pinned right after (created in page order; line widths do not matter here, so no waiting for fonts)
    const storyCleanup = buildStoryMobile(storyEl);
    document.fonts.ready.then(() => ScrollTrigger.refresh());

    return () => {
      storyCleanup();
      unstick(hero, heroBox);
      tl.scrollTrigger?.kill();
      tl.kill();
      gsap.set([heroImg, fade, hero.querySelector('.hero-content')], { clearProps: 'all' });
    };
  });


  // On touch screens a GSAP pin switches the element to position:fixed on the main thread, which visibly jitters when the
  // pin starts and while the page is scrolled by the compositor. Instead the element sits in a tall box and sticks with
  // CSS (position: sticky), which the compositor handles on its own; GSAP only reads the scroll position.
  function stickIn(el: HTMLElement, screens: number) {
    const box = document.createElement('div');
    box.dataset.stick = '';
    box.style.cssText = `position:relative;height:calc(100lvh * ${screens})`;
    el.parentNode!.insertBefore(box, el);
    box.appendChild(el);
    el.style.position = 'sticky';
    el.style.top = '0';
    return box;
  }
  function unstick(el: HTMLElement, box: HTMLElement) {
    box.parentNode?.insertBefore(el, box);
    box.remove();
    el.style.position = '';
    el.style.top = '';
  }

  // ---- the story on tablets and phones (< 1024px) ----------------------------------------------------
  // Same three steps as on a laptop, in a portrait layout: two photos on top (in the same morphing shapes; they trade
  // sides at every step), the words below, the progress line at the bottom. It is pinned right after the dive into the
  // eye; step 01 is already in place while the story rises over the cream, so there is never an empty page.
  function buildStoryMobile(story: HTMLElement) {
    story.dataset.mobile = '';
    const STORY_SCREENS = 3.9; // screens of swiping the three steps take: a whole step is more than one swipe, so a flick can't skip it
    const storyBox = stickIn(story, 1 + STORY_SCREENS);
    storyBox.style.marginTop = '-100lvh'; // rises over the cream while the hero is still stuck
    storyBox.style.zIndex = '2';
    const q = <T extends HTMLElement>(sel: string) => gsap.utils.toArray<T>(sel, story);
    const steps = q('.step');
    const bigLayers = q('.big .layer');
    const smallLayers = q('.small .layer');
    const nums = q('.num');
    const bigShape = story.querySelector<HTMLElement>('.big')!;
    const smallShape = story.querySelector<HTMLElement>('.small')!;
    const bigPath = story.querySelector('#clipBig path')!;
    const smallPath = story.querySelector('#clipSmall path')!;
    const words = steps.map((s) => splitWords(s.querySelector<HTMLElement>('.heading')!));
    const extras = steps.map((s) => gsap.utils.toArray<HTMLElement>('.eyebrow, .cta', s));
    const last = steps.length - 1;

    // Sizes and vertical positions of the photos are plain CSS (svh units: they do NOT change when the mobile address
    // bar slides away, so nothing can jump at the first swipe). The only thing that moves is `left`, which depends
    // on the width alone.
    const LAYOUT = {
      big: [0.34, 0.04, 0.34].map((l) => ({ left: () => l * window.innerWidth })),
      small: [0.04, 0.59, 0.04].map((l) => ({ left: () => l * window.innerWidth })),
    };
    const place = () => {
      gsap.set(bigShape, LAYOUT.big[0]);
      gsap.set(smallShape, LAYOUT.small[0]);
    };
    const onRefreshInit = () => {
      if ('mobile' in story.dataset) place();
    };
    ScrollTrigger.addEventListener('refreshInit', onRefreshInit);

    // everything step 01 needs is already in its final state
    bigPath.setAttribute('d', bigShapes[0]);
    smallPath.setAttribute('d', smallShapes[0]);
    place();
    gsap.set(steps, { autoAlpha: 0 });
    gsap.set(steps[0], { autoAlpha: 1 });
    gsap.set(words.slice(1).flat(), { yPercent: 115 });
    gsap.set(extras.slice(1).flat(), { autoAlpha: 0, y: 16 });
    gsap.set([bigLayers.slice(1), smallLayers.slice(1)], { autoAlpha: 0 });
    gsap.set(nums.slice(1), { autoAlpha: 0, y: 12 });
    gsap.set('.fill', { clipPath: 'inset(0% 100% 0% 0%)' });

    const FIRST = 0.8;
    const GAP = 1.8;
    const DUR = 1.4;
    const SETTLED = 1.9; // after this many time units a step's words and button are all in place
    const END = FIRST + GAP * last + SETTLED + 0.2;
    // resting points as a share of the pin: step 01 (the start), then each later step once it has settled
    const REST = [0, ...Array.from({ length: last }, (_, k) => (FIRST + GAP * k + SETTLED) / END), 1];
    const tl = gsap.timeline({
      defaults: { immediateRender: false },
      scrollTrigger: {
        trigger: storyBox,
        start: 'top top',
        end: () => `+=${storyBox.offsetHeight - story.offsetHeight}`,
        invalidateOnRefresh: true,
        scrub: 0.7, // the animation eases towards the finger instead of following it 1:1
        // the brake: after the finger lifts, the scroll settles on the nearest step, never between two
        snap: { snapTo: REST, directional: false, duration: { min: 0.2, max: 0.6 }, delay: 0.1, ease: 'power2.inOut' }, // nearest point: it must not push on from a step the pager has just reached
      },
    });
    tl.fromTo('.fill', { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: END - FIRST, ease: 'none' }, FIRST);

    for (let i = 0; i < last; i++) {
      const s = FIRST + i * GAP;
      const n = i + 1;
      tl.fromTo(words[i], { yPercent: 0 }, { yPercent: -115, duration: 0.5, stagger: 0.012, ease: 'power2.in' }, s)
        .fromTo(extras[i], { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -12, duration: 0.35 }, s)
        .fromTo(steps[i], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.01 }, s + 0.55)
        .fromTo(steps[n], { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.01 }, s + 0.05)
        .fromTo(words[n], { yPercent: 115 }, { yPercent: 0, duration: 0.8, stagger: 0.03, ease: 'power3.out' }, s + 0.7)
        .fromTo(extras[n], { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.7, stagger: 0.1 }, s + 1.1);
      [bigLayers, smallLayers].forEach((layers) => {
        tl.fromTo(layers[i], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.8, ease: 'power1.inOut' }, s)
          .fromTo(layers[n], { autoAlpha: 0, scale: 1.12 }, { autoAlpha: 1, scale: 1, duration: DUR - 0.2, ease: 'power2.out' }, s);
      });
      tl.fromTo(bigPath, { attr: { d: bigShapes[i] } }, { attr: { d: bigShapes[n] }, duration: DUR - 0.2, ease: 'power3.inOut' }, s)
        .fromTo(smallPath, { attr: { d: smallShapes[i] } }, { attr: { d: smallShapes[n] }, duration: DUR - 0.2, ease: 'power3.inOut' }, s)
        // the photos glide to the opposite sides (the one in front first)
        .fromTo(bigShape, LAYOUT.big[i], { ...LAYOUT.big[n], duration: DUR, ease: 'power3.inOut' }, s + 0.12)
        .fromTo(smallShape, LAYOUT.small[i], { ...LAYOUT.small[n], duration: DUR, ease: 'power3.inOut' }, s)
        .fromTo(nums[i], { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -12, duration: 0.4 }, s)
        .fromTo(nums[n], { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.5 }, s + 0.2);
    }
    tl.set({}, {}, END); // the last step rests before the page moves on

    // ---- paging: one swipe = one step -----------------------------------------------------------------------------
    // While the story is pinned, a swipe (or a wheel notch on a tablet with a mouse) is not scrolling: it moves to the next
    // or the previous step, and further swipes are ignored until it has arrived. At the first step a swipe back, and at the
    // last step a swipe on, lead out of the story. The scrollbar, keys and the snapping above still work as a fallback.
    const st = tl.scrollTrigger!;
    const H = () => window.innerHeight;
    const stops = () => REST.slice(0, -1).map((r) => st.start + r * (st.end - st.start)); // step 01, 02, 03
    let busy = false;
    const proxy = { y: 0 };
    const goTo = (dir: number) => {
      if (busy) return;
      const pts = stops();
      const y0 = window.scrollY;
      let i = 0;
      pts.forEach((pt, k) => { if (Math.abs(pt - y0) < Math.abs(pts[i] - y0)) i = k; });
      const j = i + dir;
      const y = j < 0 ? st.start - H() * 0.6 : j > last ? st.end + H() * 0.6 : pts[j];
      busy = true;
      proxy.y = y0;
      gsap.to(proxy, {
        y,
        duration: 1.15,
        ease: 'power2.inOut',
        onUpdate: () => window.scrollTo(0, proxy.y),
        onComplete: () => gsap.delayedCall(0.12, () => (busy = false)), // a short pause so the end of the swipe is not read as a new one
      });
    };
    const pager = ScrollTrigger.observe({
      target: window,
      type: 'touch,wheel',
      tolerance: 14,
      preventDefault: true,
      allowClicks: true,
      onChangeY: (self) => {
        if (busy) return;
        if (Math.abs(self.deltaY) < 1) return;
        goTo(self.deltaY > 0 ? -1 : 1); // Observer reports the finger's travel: finger up (page down) = negative
      },
    });
    pager.disable();
    // active only while the story is pinned (so the rest of the page scrolls normally)
    const inside = () => window.scrollY >= st.start - 2 && window.scrollY <= st.end + 2;
    const syncPager = () => (inside() ? pager.enable() : pager.disable());
    st.vars.onToggle = syncPager;
    ScrollTrigger.addEventListener('scrollEnd', syncPager);
    syncPager();

    return () => {
      pager.kill();
      ScrollTrigger.removeEventListener('scrollEnd', syncPager);
      ScrollTrigger.removeEventListener('refreshInit', onRefreshInit);
      tl.scrollTrigger?.kill();
      tl.kill();
      unstick(story, storyBox);
      delete story.dataset.mobile;
      gsap.set(
        [steps, bigShape, smallShape, bigLayers, smallLayers, nums, words.flat(), extras.flat(), story.querySelector('.fill')],
        { clearProps: 'all' },
      );
    };
  }

  function build(stage: HTMLElement, story: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => gsap.utils.toArray<T>(sel, story);

    const heroImg = stage.querySelector<HTMLElement>('.hero-img')!;
    const fade = stage.querySelector<HTMLElement>('.hero-fade')!;
    const steps = q('.step');
    const bigLayers = q('.big .layer');
    const smallLayers = q('.small .layer');
    const nums = q('.num');
    const bigPath = story.querySelector('#clipBig path')!;
    const smallPath = story.querySelector('#clipSmall path')!;
    const words = steps.map((s) => splitWords(s.querySelector<HTMLElement>('.heading')!));
    const extras = steps.map((s) => gsap.utils.toArray<HTMLElement>('.eyebrow, .cta', s));
    const firstImgs = [bigLayers[0], smallLayers[0]].map((l) => l.querySelector('img')!);
    const last = steps.length - 1;
    const bigShape = story.querySelector<HTMLElement>('.big')!;
    const smallShape = story.querySelector<HTMLElement>('.small')!;
    const progressEl = story.querySelector<HTMLElement>('.progress')!;
    // Layout alternates every step: even = text left / photos right, odd = photos left / text right.
    // Offsets (vw) from the even layout to the odd one.
    // Everything in px (functions, re-measured on resize) so the photos always clear the nav pill and the
    // bottom edge, whatever the screen height.
    const NAV = 122; // px reserved at the top for the nav pill
    const PAD = 28; // px kept free at the bottom
    const areaH = () => window.innerHeight - NAV - PAD;
    const textShift = () => window.innerWidth * 0.51;
    // Photo boxes per layout: left/width in vw, top/height as a fraction of the free height.
    // The two swap roles: one grows while the other shrinks, and they trade places.
    const box = (l: number, t: number, w: number, h: number) => ({
      left: () => (l * window.innerWidth) / 100,
      top: () => NAV + t * areaH(),
      width: () => (w * window.innerWidth) / 100,
      height: () => h * areaH(),
    });
    const LAYOUT = {
      big: [box(65, 0, 32, 1), box(27, 0, 15, 0.46), box(58, 0.1, 38, 0.88)],
      small: [box(46.5, 0.54, 16.5, 0.46), box(3, 0.2, 28, 0.78), box(45.5, 0.04, 16.5, 0.44)],
    };

    // ---- starting state (everything the timeline animates *from*) ----
    bigPath.setAttribute('d', bigShapes[0]);
    smallPath.setAttribute('d', smallShapes[0]);
    // the spot of the eye on screen is worked out by the hero (it depends on how the photo is cropped)
    const eye = () => JSON.parse(heroImg.dataset.eye ?? '{"ox":37,"oy":48}') as { ox: number; oy: number };
    gsap.set(heroImg, { transformOrigin: () => `${eye().ox}% ${eye().oy}%` });
    gsap.set(steps, { autoAlpha: 0 });
    gsap.set(steps[0], { autoAlpha: 1 });
    const placeStart = () => {
      gsap.set(bigShape, { ...LAYOUT.big[0], right: 'auto', bottom: 'auto' });
      gsap.set(smallShape, { ...LAYOUT.small[0], right: 'auto', bottom: 'auto' });
    };
    placeStart();
    // px values go stale on resize: re-place before ScrollTrigger re-measures (the timeline then re-renders them)
    ScrollTrigger.addEventListener('refreshInit', () => {
      if ('stage' in stage.dataset) placeStart();
    });
    steps.forEach((st, i) => gsap.set(st, { x: () => (i % 2 ? textShift() : 0) }));
    gsap.set(words.flat(), { yPercent: 115 });
    gsap.set(extras.flat(), { autoAlpha: 0, y: 16 });
    gsap.set([bigLayers.slice(1), smallLayers.slice(1)], { autoAlpha: 0 });
    gsap.set(bigLayers[0], { clipPath: 'inset(0% 100% 0% 0%)' });
    gsap.set(smallLayers[0], { clipPath: 'inset(100% 0% 0% 0%)' });
    gsap.set(firstImgs, { scale: 1.3 });
    gsap.set(nums, { autoAlpha: 0, y: 12 });
    gsap.set(nums[0], { autoAlpha: 1, y: 0 }); // the counter rides in with the progress line
    gsap.set('.progress', { autoAlpha: 0 });
    gsap.set('.fill', { clipPath: 'inset(0% 100% 0% 0%)' });

    // First real section after the stage (Astro can put <script>/<style> tags in between). Found before the
    // pin exists — pinning wraps the stage in a spacer element. It starts one screen early (margin-top: -100vh)
    // so that it slides over the last step instead of following it.
    let next = stage.nextElementSibling as HTMLElement | null;
    while (next && /^(SCRIPT|STYLE|LINK)$/.test(next.tagName)) next = next.nextElementSibling as HTMLElement | null;
    if (next) gsap.set(next, { marginTop: '-100vh' });

    // pin length = the sequence + one screen of scrolling during which the next section covers the stage
    const total = HOLD_END + window.innerHeight / PX_PER_SEC;

    const tl = gsap.timeline({
      defaults: { immediateRender: false },
      scrollTrigger: {
        trigger: stage,
        start: 'top top',
        end: `+=${total * PX_PER_SEC}`,
        pin: true,
        anticipatePin: 1,
        invalidateOnRefresh: true, // the eye's spot depends on the window size
        scrub: 1, // how long the animation trails behind the scroll position
      },
    });

    // 1. Zoom into the eye, then the screen turns cream
    tl.fromTo(
      heroImg,
      { scale: 1, xPercent: 0, yPercent: 0, transformOrigin: () => `${eye().ox}% ${eye().oy}%` },
      {
        scale: 7,
        xPercent: () => 50 - eye().ox,
        yPercent: () => 50 - eye().oy,
        transformOrigin: () => `${eye().ox}% ${eye().oy}%`,
        duration: ZOOM,
        ease: 'power3.inOut',
      },
      0,
    ).fromTo(fade, { opacity: 0 }, { opacity: 1, duration: ZOOM - WASH, ease: 'power1.in' }, WASH);

    // the opening text and scroll cue leave as soon as the dive begins
    tl.fromTo('.hero-content', { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -40, duration: 0.9, ease: 'power2.in' }, 0);

    // 2. Entrance: masks open, images settle from a slow zoom, heading rises line by line
    tl.fromTo(bigLayers[0], { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.4, ease: 'power3.out' }, INTRO)
      .fromTo(firstImgs[0], { scale: 1.3 }, { scale: 1, duration: 2.2, ease: 'power2.out' }, INTRO)
      .fromTo(smallLayers[0], { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.3, ease: 'power3.out' }, INTRO + 0.15)
      .fromTo(firstImgs[1], { scale: 1.3 }, { scale: 1, duration: 2, ease: 'power2.out' }, INTRO + 0.15)
      .fromTo(extras[0][0], { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.8 }, INTRO + 0.05);
    const intro = wordDelays(words[0]);
    words[0].forEach((w, i) =>
      tl.fromTo(w, { yPercent: 115 }, { yPercent: 0, duration: 0.9, ease: 'power3.out' }, INTRO + 0.12 + intro.delays[i]),
    );
    tl.fromTo(extras[0][1], { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power3.out' }, INTRO + 0.12 + intro.lines * 0.14 + 0.35)
      .fromTo('.progress', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.8, ease: 'none' }, INTRO + 0.9);

    // progress line fills across all steps
    tl.fromTo(
      '.fill',
      { clipPath: 'inset(0% 100% 0% 0%)' },
      { clipPath: 'inset(0% 0% 0% 0%)', duration: HOLD_END - (INTRO + 1.5), ease: 'none' },
      INTRO + 1.5,
    );

    // 3. Step transitions 01→02→03: text swaps, photos cross-fade, shapes morph, counter flips
    for (let i = 0; i < last; i++) {
      const s = FIRST_STEP + i * STEP_GAP;
      const next = i + 1;
      // text
      tl.fromTo(words[i], { yPercent: 0 }, { yPercent: -115, duration: 0.5, stagger: 0.015, ease: 'power2.in' }, s)
        .fromTo(extras[i], { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -12, duration: 0.35 }, s)
        .fromTo(steps[i], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.01 }, s + 0.6)
        .fromTo(steps[next], { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.01 }, s + 0.05)
        .fromTo(words[next], { yPercent: 115 }, { yPercent: 0, duration: 0.9, stagger: 0.04, ease: 'power3.out' }, s + 1.0)
        .fromTo(extras[next], { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1 }, s + 1.5);
      // photos
      [bigLayers, smallLayers].forEach((layers) => {
        tl.fromTo(layers[i], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.9, ease: 'power1.inOut' }, s)
          .fromTo(layers[next], { autoAlpha: 0, scale: 1.12 }, { autoAlpha: 1, scale: 1, duration: STEP_DUR - 0.3, ease: 'power2.out' }, s);
      });
      tl.fromTo(bigPath, { attr: { d: bigShapes[i] } }, { attr: { d: bigShapes[next] }, duration: STEP_DUR - 0.3, ease: 'power3.inOut' }, s)
        .fromTo(smallPath, { attr: { d: smallShapes[i] } }, { attr: { d: smallShapes[next] }, duration: STEP_DUR - 0.3, ease: 'power3.inOut' }, s);
      // layout swap: photos glide left (or back right), the new text appears on the opposite side
      const toOdd = next % 2 === 1;
      const [from, to] = [i, next];
      // the photo in front travels first, so at the halfway point the two have a gap between them —
      // that is when their layers trade places, where it can't be seen
      const lead = 0.25;
      tl.fromTo(bigShape, LAYOUT.big[from], { ...LAYOUT.big[to], duration: STEP_DUR, ease: 'power3.inOut' }, s + (toOdd ? lead : 0))
        .fromTo(smallShape, LAYOUT.small[from], { ...LAYOUT.small[to], duration: STEP_DUR, ease: 'power3.inOut' }, s + (toOdd ? 0 : lead))
        .fromTo(progressEl, { x: () => (toOdd ? 0 : textShift()) }, { x: () => (toOdd ? textShift() : 0), duration: STEP_DUR, ease: 'power3.inOut' }, s);
      // the smaller photo always lies on top: layers trade places once the two are about the same size
      tl.set(bigShape, { zIndex: toOdd ? 3 : 1 }, s + lead / 2 + STEP_DUR * 0.5);
      // counter
      tl.fromTo(nums[i], { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -12, duration: 0.4 }, s)
        .fromTo(nums[next], { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.5 }, s + 0.2);
    }

    // The timeline simply holds on step 03 for the last screen of the pin — that is where the next section
    // slides over the stage (it has margin-top: -100vh, see ScrollExpand). The parallax below is tied 1:1 to
    // that section's position (no scrub lag), so the stage drifts up and dims exactly as it is being covered.
    tl.set({}, {}, total);

    if (next) {
      gsap
        .timeline({ scrollTrigger: { trigger: next, start: 'top bottom', end: 'top top', scrub: true } })
        .fromTo(story, { y: 0 }, { y: -window.innerHeight * 0.22, ease: 'none' }, 0)
        .fromTo('.stage-dim', { opacity: 0 }, { opacity: 0.5, ease: 'none' }, 0);
    }
  }
</script>

<style>
  /* Pinned stage: hero and story stacked in one viewport */
  #stage[data-stage] {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: #faf8f3;
  }
  /* darkens the stage while the next section slides over it */
  .stage-dim {
    display: none;
  }
  #stage[data-stage] .stage-dim {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #14110d;
    opacity: 0;
    pointer-events: none;
  }
  /* explicit layer order: hero (its own stacking context, so the cream wash can't climb above the story) → story → dim */
  #stage[data-stage] :global(.hero) {
    position: absolute;
    inset: 0;
    height: 100%;
    z-index: 0;
  }
  #stage[data-stage] :global(.story) {
    z-index: 1;
  }
</style>
