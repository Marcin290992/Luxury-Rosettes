---
import Hero from './Hero.astro';
import Story from './Story.astro';
---

<!--
  Desktop: hero + story share one pinned stage. A SINGLE scroll-scrubbed timeline drives everything
  (zoom into the eye → cream wash → photos/text enter → steps 01-03 → fade out), so scroll position is
  the only state: wheel, scrollbar, keys and touch all behave the same, and going back is the exact reverse.
  Mobile / reduced motion: no pin — plain hero followed by the stacked story.
-->
<div id="stage">
  <Hero />
  <Story />
  <div class="stage-dim" aria-hidden="true"></div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initDesktop } from '../scripts/stage/desktop';
  import { initMobile } from '../scripts/stage/mobile';
  import { destroyLenis } from '../scripts/lenis';
  import { mount } from '../scripts/lifecycle';

  gsap.registerPlugin(ScrollTrigger);
  // the mobile address bar sliding in/out changes the window height: that must not re-measure the pins
  ScrollTrigger.config({ ignoreMobileResize: true });

  // Laptops and wider: one pinned stage (hero + story). Phones and tablets: the hero and the story pinned with CSS sticky.
  mount(() => {
    const stopDesktop = initDesktop();
    const stopMobile = initMobile();
    return () => {
      stopDesktop();
      stopMobile();
      destroyLenis();
    };
  });
</script>

<style>
  /* Pinned stage: hero and story stacked in one viewport */
  #stage[data-stage] {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: var(--paper);
  }
  /* darkens the stage while the next section slides over it */
  .stage-dim {
    display: none;
  }
  #stage[data-stage] .stage-dim {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #14110d;
    opacity: 0;
    pointer-events: none;
  }
  /* explicit layer order: hero (its own stacking context, so the cream wash can't climb above the story) → story → dim */
  #stage[data-stage] :global(.hero) {
    position: absolute;
    inset: 0;
    height: 100%;
    z-index: 0;
  }
  #stage[data-stage] :global(.story) {
    z-index: 1;
  }
</style>
