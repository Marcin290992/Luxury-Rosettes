---
/**
 * A transition that opens a section on stripes (the mirror of StripeCover, which only covers). Put it after a section that stands still at its
 * end: a few stripes in a solid colour rise from the bottom one after another, driven by the scroll, and cover it; the moment they have closed the
 * slotted section comes out ON them by itself (timed, not scrolled: progress 0..1 is published as --sr-intro on the track and as an `sr:intro`
 * event on it, the section plays its own entrance from it; scrolling back up before the stripes open takes it away again), holds and scrolls on.
 * The track lies over the last screens of the section before it (nothing is added to the page's length but the hold).
 * Without the script (or with reduced motion) it is just the section in the flow.
 */
interface Props {
  stripes?: number; // how many stripes
  color?: string; // the stripes' colour: the section's own background
  pin?: number; // screens of scrolling the stripes take to close (they end when the section before it stops standing still)
  duration?: number; // seconds the section's entrance takes, once the stripes have closed
  hold?: number; // screens the finished section stays on the screen before the page goes on
}
const { stripes = 5, color = '#FAF8F3', pin = 1, duration = 1.8, hold = 0.5 } = Astro.props;
---

<div
  class="sr"
  data-stripe-reveal
  data-stripes={stripes}
  data-pin={pin}
  data-duration={duration}
  style={`--sr-pin:${pin};--sr-hold:${hold};--sr-color:${color}`}
>
  <div class="sr-pin">
    <div class="sr-stripes" aria-hidden="true">
      {Array.from({ length: stripes }, () => <div class="sr-stripe"></div>)}
    </div>
    <div class="sr-content">
      <slot />
    </div>
  </div>
</div>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import gsap from 'gsap';
  import { mount } from '../scripts/lifecycle';
  import { drawStripes } from '../scripts/stripes';

  gsap.registerPlugin(ScrollTrigger);

  mount(() => {
    const root = document.querySelector<HTMLElement>('[data-stripe-reveal]');
    const screen = root?.querySelector<HTMLElement>('.sr-pin');
    const content = root?.querySelector<HTMLElement>('.sr-content');
    if (!root || !screen || !content) return;
    const stripes = Array.from(root.querySelectorAll<HTMLElement>('.sr-stripe'));
    const pin = parseFloat(root.dataset.pin ?? '1');
    const ease = gsap.parseEase('sine.inOut'); // the stripes ease in and out of their rise instead of starting and stopping at full speed
    const duration = parseFloat(root.dataset.duration ?? '2.6');
    const entrance = { value: 0 };
    let closed = false;
    let entering: gsap.core.Tween | undefined;
    const mm = gsap.matchMedia();

    const publish = (value: number) => {
      root.style.setProperty('--sr-intro', value.toFixed(4));
      root.dispatchEvent(new CustomEvent('sr:intro', { detail: value }));
    };

    const show = (value: number) => {
      entrance.value = value;
      publish(value);
      content.style.visibility = value > 0 ? 'visible' : 'hidden';
      content.style.pointerEvents = value >= 0.5 ? '' : 'none'; // the wall can be dragged while it is still settling
    };

    // The stripes follow the scroll with a little inertia (quickTo), so no flick of the wheel makes them jump.
    const stripe = { v: 0 };
    const setStripe = gsap.quickTo(stripe, 'v', { duration: 0.6, ease: 'power2.out', onUpdate: () => drawStripes(stripes, stripe.v) });
    let leaving = false; // the section is on its way out: the stripes stay closed until it has gone

    // p: 0..1 over the stripes' scrolling. The section stays hidden until the stripes have closed (it is the colour of the stripes, so it would show
    // through the gaps); then its entrance plays by itself. Scrolling back up plays it out the same way, by the clock and as slowly as it came in,
    // and the stripes wait closed until it has gone and only then open (following the scroll again).
    const draw = (p: number) => {
      const eased = ease(p);
      // visually closed: the eased end is long and flat, so the entrance does not wait for the last pixels of scrolling (and does not flicker on the edge)
      const nowClosed = closed ? eased >= 0.97 : eased >= 0.995;
      if (nowClosed && !closed) {
        closed = true;
        leaving = false;
        content.style.visibility = 'visible';
        entering?.kill();
        entering = gsap.to(entrance, { value: 1, duration, ease: 'none', onUpdate: () => show(entrance.value) });
      } else if (!nowClosed && closed) {
        closed = false;
        leaving = true;
        entering?.kill();
        entering = gsap.to(entrance, {
          value: 0,
          duration: duration * entrance.value, // as long as the part of the entrance that has played
          ease: 'none',
          onUpdate: () => show(entrance.value),
          onComplete: () => {
            leaving = false;
            setStripe(ease(latest));
          },
        });
      }
      latest = p;
      setStripe(closed || leaving ? 1 : eased);
    };
    let latest = 0;

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      root.dataset.live = '';
      content.style.visibility = 'hidden';
      content.style.pointerEvents = 'none';
      publish(0);
      drawStripes(stripes, 0);
      draw(0);
      const trigger = ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: () => `+=${pin * screen.clientHeight}`,
        invalidateOnRefresh: true,
        onUpdate: (self) => draw(self.progress),
        onRefresh: (self) => draw(self.progress),
      });
      ScrollTrigger.refresh();
      return () => {
        trigger.kill();
        entering?.kill();
        gsap.killTweensOf(stripe);
        stripes.forEach((s) => s.removeAttribute('style'));
        content.removeAttribute('style');
        root.style.removeProperty('--sr-intro');
        delete root.dataset.live;
        root.dispatchEvent(new CustomEvent('sr:intro', { detail: 1 }));
      };
    });

    return () => {
      mm.revert();
      delete root.dataset.live;
    };
  }, '[data-stripe-reveal]');
</script>

<style>
  .sr-stripes {
    display: none;
  }
  /* a track with a sticky screen in it: the screen stands still while the stripes close (pin screens), it holds once they have closed; the
     track starts pin + 1 screens before the end of the section before it, so the stripes rise over its still last screens */
  .sr[data-live] {
    position: relative;
    z-index: 6;
    height: calc((1 + var(--sr-pin, 1) + var(--sr-hold, 0.5)) * 100vh);
    height: calc((1 + var(--sr-pin, 1) + var(--sr-hold, 0.5)) * 100svh);
    margin-top: calc(-1 * (1 + var(--sr-pin, 1)) * 100vh);
    margin-top: calc(-1 * (1 + var(--sr-pin, 1)) * 100svh);
  }
  .sr[data-live] .sr-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .sr[data-live] .sr-stripes {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .sr-stripe {
    flex: 1;
    margin-top: -1px;
    background: var(--sr-color, #faf8f3);
    transform: scaleY(0);
    transform-origin: bottom;
  }
  .sr[data-live] .sr-content {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
</style>
