---
// Real Facebook reviews, verbatim
// The first review, Julius C., is the large band above this section (see QuoteBand in index.astro)
const others = [
  { name: 'Zoe T.', quote: 'Fantastic communication. I bought my first Snow Bengal from Sylwia, she was very helpful with care and what they require: healthy kitten, full papers and support. Thank you.' },
  { name: 'Marcin K.', quote: 'You can truly see that Sylvia does what she does with passion and love. Amazing knowledge and understanding of cats\' behaviour. Our cat is healthy, chipped, and fully vaccinated. We also received toys and 24/7 support.' },
  { name: 'Robert S.', quote: 'We were shown all the details of our cats and their lineage and were very confident that we were getting our cats from the right person. Highly recommend Luxury Rosettes.' },
];
const reviews = others;
---

<section class="tm" id="reviews">
  <div class="tm-head">
    <div>
      <p class="eyebrow" data-reveal>Families</p>
      <h2 data-line-reveal data-char-reveal>In their words</h2>
    </div>
    <div class="tm-nav" data-reveal>
      <span class="tm-count" aria-live="polite"><b>01</b> / {String(reviews.length).padStart(2, '0')}</span>
      <button class="tm-btn" type="button" data-dir="-1" aria-label="Previous review"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.5 5l-7 7 7 7" /></svg></button>
      <button class="tm-btn" type="button" data-dir="1" aria-label="Next review"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 5l7 7-7 7" /></svg></button>
    </div>
  </div>
  <div class="tm-view" data-reveal>
    <div class="tm-track">
      {
        reviews.map((r) => (
          <blockquote class="tm-slide">
            <p>{r.quote}</p>
            <footer>{r.name} <span>Facebook review</span></footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLineReveal } from '../scripts/line-reveal';

  // The reviews sit in one row. The active one is centred and full size; the others stand beside it, smaller and dimmer,
  // and every step slides the whole row so the next one becomes the main one.
  mount(() => {
    const root = document.getElementById('reviews')!;
    const view = root.querySelector<HTMLElement>('.tm-view')!;
    const track = root.querySelector<HTMLElement>('.tm-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.tm-slide'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.tm-btn'));
    const count = root.querySelector<HTMLElement>('.tm-count b')!;
    let index = 0;
    const lines = initLineReveal(Array.from(root.querySelectorAll<HTMLElement>('[data-line-reveal]')));

    // where the row sits when review i is the main one
    const xFor = (i: number) => view.clientWidth / 2 - (slides[i].offsetLeft + slides[i].offsetWidth / 2);
    let rowX = 0;
    const place = () => {
      rowX = xFor(index);
      track.style.transform = `translate3d(${rowX}px, 0, 0)`;
      slides.forEach((el, i) => {
        el.classList.toggle('is-active', i === index);
        el.setAttribute('aria-hidden', String(i !== index));
      });
      buttons.forEach((btn) => (btn.disabled = index + Number(btn.dataset.dir) < 0 || index + Number(btn.dataset.dir) >= slides.length));
      count.textContent = String(index + 1).padStart(2, '0');
    };
    const go = (to: number) => {
      index = Math.min(slides.length - 1, Math.max(0, to));
      place();
    };

    const onButton = (e: Event) => go(index + Number((e.currentTarget as HTMLElement).dataset.dir));
    const onSlide = (e: Event) => go(slides.indexOf(e.currentTarget as HTMLElement));
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') go(index - 1);
      if (e.key === 'ArrowRight') go(index + 1);
    };
    // The row follows the mouse or the finger while it is held (grab), pulls back a little at its two ends, and on release settles on the nearest
    // review; a quick flick moves one review on. A drag that moved is not a click (it would jump to the review under the pointer).
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startIndex = 0;
    let lastX = 0;
    let lastT = 0;
    let speed = 0; // px per ms, the last stretch of the drag
    let rawX = 0;
    const onDown = (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = lastX = e.clientX;
      lastT = e.timeStamp;
      speed = 0;
      startIndex = index;
      rawX = rowX;
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) < 5) return; // a click is not a drag
      if (!moved) {
        moved = true;
        view.classList.add('is-dragging');
        view.setPointerCapture(e.pointerId);
      }
      const dt = Math.max(1, e.timeStamp - lastT);
      speed = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastT = e.timeStamp;
      rawX = rowX + dx;
      const far = xFor(0); // the row cannot go further right than this, nor further left than the last review: it resists there
      const near = xFor(slides.length - 1);
      if (rawX > far) rawX = far + (rawX - far) * 0.35;
      if (rawX < near) rawX = near + (rawX - near) * 0.35;
      track.style.transform = `translate3d(${rawX}px, 0, 0)`;
    };
    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      view.classList.remove('is-dragging');
      if (!moved) return;
      // the nearest review to the middle, or one step on for a quick flick
      let to = 0;
      slides.forEach((_, i) => {
        if (Math.abs(xFor(i) - rawX) < Math.abs(xFor(to) - rawX)) to = i;
      });
      // a short drag (a fifth of the way to the next review) or a quick flick moves one review on
      const step = Math.abs(xFor(Math.min(1, slides.length - 1)) - xFor(0)) || 1;
      const pulled = rawX - rowX;
      if (to === startIndex && (Math.abs(speed) > 0.5 || Math.abs(pulled) > step * 0.2)) {
        const dir = Math.abs(speed) > 0.5 ? speed : pulled;
        to = Math.min(slides.length - 1, Math.max(0, startIndex + (dir < 0 ? 1 : -1)));
      }
      go(to);
      place(); // also when it is the same review: the row goes back to its place
    };
    // after a drag, the click that follows the release is swallowed
    const onClickCapture = (e: Event) => {
      if (!moved) return;
      e.stopPropagation();
      e.preventDefault();
      moved = false;
    };
    const resize = new ResizeObserver(place);

    buttons.forEach((btn) => btn.addEventListener('click', onButton));
    slides.forEach((el) => el.addEventListener('click', onSlide));
    root.addEventListener('keydown', onKey);
    view.addEventListener('pointerdown', onDown);
    view.addEventListener('pointermove', onMove);
    view.addEventListener('pointerup', onUp);
    view.addEventListener('pointercancel', onUp);
    view.addEventListener('click', onClickCapture, true);
    resize.observe(view);
    root.tabIndex = -1;
    place();

    return () => {
      buttons.forEach((btn) => btn.removeEventListener('click', onButton));
      slides.forEach((el) => el.removeEventListener('click', onSlide));
      root.removeEventListener('keydown', onKey);
      view.removeEventListener('pointerdown', onDown);
      view.removeEventListener('pointermove', onMove);
      view.removeEventListener('pointerup', onUp);
      view.removeEventListener('pointercancel', onUp);
      view.removeEventListener('click', onClickCapture, true);
      view.classList.remove('is-dragging');
      resize.disconnect();
      lines();
      track.style.transform = '';
    };
  }, '#reviews');
</script>

<style>
  .tm {
    background: var(--paper);
    color: var(--ink);
    padding: var(--space) 0;
    overflow: hidden;
  }
  .tm-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto clamp(2.5rem, 6vh, 4rem);
    padding: 0 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin: 0;
  }
  .tm-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .tm-count {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    opacity: 0.6;
    margin-right: 0.75rem;
  }
  .tm-count b {
    font-weight: 500;
    color: var(--gold-deep);
  }
  .tm-btn {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgba(26, 26, 26, 0.35);
    background: transparent;
    color: var(--ink);
    display: inline-grid;
    place-items: center;
    padding: 0;
    cursor: pointer;
    transition: background var(--hover-time), color var(--hover-time), border-color var(--hover-time), opacity var(--hover-time);
  }
  .tm-btn svg {
    display: block;
  }
  .tm-btn:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .tm-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .tm-view {
    touch-action: pan-y;
    user-select: none;
  }
  /* The one place with a hand: the row can be dragged. The site has one arrow everywhere (Layout.astro, !important), so this needs the same
     weight, and the more specific selector wins over the universal one. */
  .tm-view,
  .tm-view * {
    cursor: grab !important;
  }
  .tm-view.is-dragging,
  .tm-view.is-dragging * {
    cursor: grabbing !important;
  }
  .tm-view.is-dragging .tm-track {
    transition: none;
  }
  .tm-track {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 4rem);
    width: max-content;
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
  }
  .tm-slide {
    width: min(46rem, 80vw);
    flex: none;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(26, 26, 26, 0.25);
    opacity: 0.32;
    transform: scale(0.92);
    transform-origin: 50% 0;
    cursor: inherit;
    transition: opacity 0.9s, transform 0.9s cubic-bezier(0.65, 0, 0.35, 1), border-color 0.9s;
  }
  .tm-slide.is-active {
    opacity: 1;
    transform: none;
    border-color: var(--gold-deep);
  }
  .tm-slide p {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.1vw, 1.7rem);
    line-height: 1.4;
  }
  footer {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 1.5rem;
  }
  footer span {
    opacity: 0.5;
    margin-left: 0.75rem;
  }
  @media (max-width: 640px) {
    .tm-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-track,
    .tm-slide {
      transition: none;
    }
  }
</style>
