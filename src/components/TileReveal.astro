---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { TILE_REVEAL } from '../scripts/settings';

/**
 * Photo tiles fly in from above and below and form a grid, the grid zooms past the camera, the tiles step aside and
 * the headline is left alone on the stage, with the default slot (text, buttons) fading in under it. All of it is
 * scrubbed by the scroll. The headline goes in the `headline` slot.
 * Without the script (or with reduced motion) the photos simply stack above the text.
 */
interface Props {
  images: { src: ImageMetadata; alt?: string }[];
  id?: string;
}
const { images, id = 'tile-reveal' } = Astro.props;
const { columns, gap, gridWidth, tileAspect, scrollLength } = TILE_REVEAL;
---

<section
  class="tr"
  id={id}
  style={`--tr-cols:${columns};--tr-gap:${gap}px;--tr-width:${gridWidth}px;--tr-aspect:${tileAspect};--tr-length:${scrollLength}`}
>
  <div class="tr-stage">
    <div class="tr-content">
      <div class="tr-headline"><slot name="headline" /></div>
      <div class="tr-reveal"><slot /></div>
    </div>
    <div class="tr-frame" aria-hidden="true">
      <div class="tr-grid">
        {
          images.map((img) => (
            <div class="tr-tile">
              <Image src={img.src} alt={img.alt ?? ''} widths={[400, 700]} sizes="(min-width:1024px) 24vw, 30vw" loading="lazy" draggable="false" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initTileReveal } from '../scripts/tile-reveal';
  import { TILE_REVEAL } from '../scripts/settings';

  mount(() => {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('.tr'));
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    let destroy: (() => void)[] = [];

    // runs whenever motion is allowed (and follows the setting if it changes while the page is open)
    const sync = () => {
      destroy.forEach((d) => d());
      destroy = [];
      roots.forEach((root) => delete root.dataset.live);
      if (!motion.matches) return;
      roots.forEach((root) => {
        root.dataset.live = '';
        destroy.push(initTileReveal(root, TILE_REVEAL));
      });
    };
    motion.addEventListener('change', sync);
    sync();

    return () => {
      motion.removeEventListener('change', sync);
      destroy.forEach((d) => d());
      roots.forEach((root) => delete root.dataset.live);
    };
  });
</script>

<style>
  .tr {
    position: relative;
    background: var(--ink-warm);
    color: var(--cream);
  }
  /* without the script: the text, then the photos in a plain grid */
  .tr-stage {
    display: flex;
    flex-direction: column;
    padding: clamp(4rem, 12vh, 8rem) 1.5rem;
  }
  .tr-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }
  .tr-frame {
    order: 2;
    width: min(var(--tr-width), 100%);
    margin: 3rem auto 0;
  }
  .tr-grid {
    display: grid;
    grid-template-columns: repeat(var(--tr-cols), minmax(0, 1fr));
    gap: var(--tr-gap);
  }
  .tr-tile {
    aspect-ratio: var(--tr-aspect);
    overflow: hidden;
    border-radius: 2px;
    background: var(--placeholder);
  }
  .tr-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  /* with the script: one sticky stage inside a tall track, scrubbed by the scroll */
  .tr[data-live] {
    height: calc((1 + var(--tr-length)) * 100svh);
  }
  .tr[data-live] .tr-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: 0;
    overflow: hidden;
  }
  .tr[data-live] .tr-content {
    position: relative;
    z-index: 10;
    height: 100%;
    justify-content: center;
    padding: 0 1.5rem;
  }
  .tr[data-live] .tr-frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(var(--tr-width), calc(100% - var(--tr-gap) * 2));
    margin: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .tr[data-live] .tr-grid,
  .tr[data-live] .tr-tile,
  .tr[data-live] .tr-headline,
  .tr[data-live] .tr-reveal {
    will-change: transform;
    backface-visibility: hidden;
  }
  .tr[data-live] .tr-tile {
    visibility: hidden;
  }
  .tr[data-live] .tr-reveal {
    opacity: 0;
  }
  /* the headline stays readable while tiles pass behind it */
  .tr[data-live] .tr-headline {
    text-shadow: 0 2px 30px rgba(12, 9, 7, 0.7);
  }
</style>
