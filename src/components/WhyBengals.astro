---
import { Image } from 'astro:assets';
import kita from '../assets/img/cats/kita.webp';

const traits = [
  { title: 'Rosette markings', text: 'A coat as unique as a fingerprint, with wild-inspired patterns impossible to replicate.' },
  { title: 'Wild by nature', text: 'Descended from Asian Leopard Cats, with an untamed spirit refined for home life.' },
  { title: 'Remarkable intelligence', text: 'Quick to learn, endlessly curious and deeply engaged with their world.' },
  { title: 'Devoted companions', text: 'Bengals form lasting bonds: loyal, affectionate and uniquely present.' },
];
---

<!--
  Pinned sequence, then the text. The photo starts as two tiles, the left one lower and the right one higher, a small gap
  between them. First the tiles level out, then the gap closes and they are one photo, which grows to fill the whole
  screen, and then the paper closes in around the word BENGALS (the letters shrink from huge), leaving the photo only inside the letters.
  Without the script (or with reduced motion): the photo is whole and everything just stacks.
-->
<section class="why" id="why-bengals">
  <div class="why-track">
    <div class="why-stage">
      <div class="why-img">
        <div class="why-half why-half--l">
          <Image src={kita} alt="Kita, a golden Bengal queen" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
        </div>
        <div class="why-half why-half--r" aria-hidden="true">
          <Image src={kita} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
        </div>
      </div>

      <!-- Knockout: a sheet of paper with the word BENGALS cut out of it, over the photo. At first the letters are so huge
           that the whole screen is inside them (the photo shows); they shrink to the word, and the photo is left in the
           letters. The script places the word and scales it around the centre of the stage. -->
      <svg class="why-knock" aria-hidden="true" focusable="false">
        <defs>
          <mask id="why-knock-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
            <rect width="100%" height="100%" fill="#fff"></rect>
            <g class="why-knock-word">
              <text class="why-knock-text" text-anchor="middle" dominant-baseline="central" fill="#000">BENGALS</text>
            </g>
          </mask>
        </defs>
        <rect class="why-knock-paper" width="100%" height="100%" mask="url(#why-knock-mask)"></rect>
      </svg>
    </div>
  </div>

  <div class="why-copy">
    <header class="why-head">
      <p class="eyebrow" data-reveal>Bengal excellence</p>
      <h2 data-reveal>Why <em>Bengals?</em></h2>
    </header>
    <ul class="traits">
      {
        traits.map((t) => (
          <li data-reveal>
            <i class="trait-line" data-dash aria-hidden="true"></i>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mount } from '../scripts/lifecycle';

  gsap.registerPlugin(ScrollTrigger);

  mount(() => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const section = document.getElementById('why-bengals')!;
      const track = section.querySelector<HTMLElement>('.why-track')!;
      const stage = section.querySelector<HTMLElement>('.why-stage')!;
      const img = section.querySelector<HTMLElement>('.why-img')!;
      const halfL = section.querySelector<HTMLElement>('.why-half--l')!;
      const halfR = section.querySelector<HTMLElement>('.why-half--r')!;

      section.dataset.live = '';

      const H = () => stage.clientHeight;
      const W = () => window.innerWidth;

      // start: the left tile lower, the right one higher, and a small gap between them
      gsap.set(halfL, { x: () => -W() * 0.007, y: () => H() * 0.06 });
      gsap.set(halfR, { x: () => W() * 0.007, y: () => -H() * 0.06 });

      // A sticky stage inside a tall track: the scroll position scrubs the timeline (no GSAP pin: on touch screens it
      // would switch the stage to position:fixed on the main thread and jitter).
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: track, start: 'top top', end: 'bottom bottom', scrub: 1, invalidateOnRefresh: true },
      });

      // 1. the tiles level out
      tl.to([halfL, halfR], { y: 0, duration: 1, ease: 'power2.inOut' }, 0);
      // 2. then the gap closes: one photo
      tl.to([halfL, halfR], { x: 0, duration: 0.8, ease: 'power2.inOut' }, 0.9);
      // 3. the finished photo grows to fill the whole screen (the width and height are animated, so the photo re-crops
      //    instead of stretching)
      tl.to(img, { width: () => stage.clientWidth, height: () => stage.clientHeight, duration: 1.4, ease: 'power2.inOut' }, 1.7);
      // 4. the paper closes in around the word: the letters start so big that the whole screen is inside them, then shrink
      //    to the width of the screen, so the photo ends up only in the letters.
      //    The word is placed at the centre of the stage and scaled around that centre by hand (a matrix on the <g>): GSAP's own
      //    transform origin needs a bounding box, and elements inside a <mask> have none, so it scaled from the corner.
      const knock = section.querySelector<SVGElement>('.why-knock')!;
      const word = knock.querySelector<SVGGElement>('.why-knock-word')!;
      const text = knock.querySelector<SVGTextElement>('.why-knock-text')!;
      const zoom = { s: 8 };
      const place = () => {
        const cx = stage.clientWidth / 2;
        const cy = stage.clientHeight / 2;
        text.setAttribute('x', String(cx));
        text.setAttribute('y', String(cy));
        word.setAttribute('transform', `translate(${cx * (1 - zoom.s)} ${cy * (1 - zoom.s)}) scale(${zoom.s})`);
      };
      place();
      ScrollTrigger.addEventListener('refresh', place); // sizes can change; the centre is read again each time

      gsap.set(knock, { opacity: 0 });
      tl.to({}, { duration: 0.3 }); // a beat on the full-screen photo
      tl.to(knock, { opacity: 1, duration: 0.6 }, '>');
      tl.to(zoom, { s: 1, duration: 1.8, ease: 'power3.inOut', onUpdate: place, immediateRender: false }, '<');
      tl.to({}, { duration: 0.7 }); // a rest on the finished picture before the page moves on
      return () => {
        ScrollTrigger.removeEventListener('refresh', place);
        delete section.dataset.live;
      };
    });
    return () => mm.revert();
  });
</script>

<style>
  .why {
    background: var(--paper);
    color: var(--ink);
  }

  /* ---- plain stack: photo, heading, traits (no script / reduced motion) ---- */
  .why-track {
    padding: clamp(4rem, 12vh, 9rem) 1.5rem 0;
  }
  .why-stage {
    max-width: 72rem;
    margin: 0 auto;
  }
  /* the two tiles side by side; together they are one photo */
  .why-img {
    display: flex;
    width: min(100%, 52rem);
    aspect-ratio: 4 / 5;
    margin: 0 auto;
  }
  /* No shadow on the tiles (each would cast a dark line onto the other where they meet), and the right tile tucks half a
     pixel under the left one so no hairline of paper shows between them at fractional widths. */
  .why-half {
    position: relative;
    width: 50%;
    height: 100%;
    overflow: hidden;
    background: var(--placeholder);
    will-change: transform;
  }
  .why-half--r {
    width: calc(50% + 0.5px);
    margin-left: -0.5px;
  }
  .why-knock {
    display: none;
  }
  /* each tile shows its side of the same photo: the image is twice as wide as the tile */
  .why-half :global(img) {
    position: absolute;
    top: 0;
    width: 200%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .why-half--l :global(img) { left: 0; }
  .why-half--r :global(img) { right: 0; }

  .why-copy {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 10vh, 7rem) 1.5rem clamp(4rem, 12vh, 9rem);
  }
  .why-head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 7vh, 4.5rem);
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    margin: 0;
  }
  .traits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .traits li {
    position: relative;
    border-top: var(--dash-track);
    padding-top: 1.4rem;
  }
  /* the strong line over the light one, drawn in from the left when it scrolls into view */
  .trait-line {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 0;
    border-top: var(--dash-strong);
  }
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }
  .traits p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.75;
    opacity: 0.75;
    margin: 0;
    max-width: 30rem;
  }
  @media (min-width: 700px) {
    .why-img {
      aspect-ratio: 16 / 9;
    }
    .traits {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 3rem;
    }
  }
  @media (min-width: 1024px) {
    .traits {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }

  /* ---- pinned sequence (the script sets data-live) ---- */
  .why[data-live] .why-track {
    --screens: 6.5; /* how many screens of scrolling the sequence lasts */
    height: calc(100vh * var(--screens));
    height: calc(100lvh * var(--screens)); /* lvh: constant when the mobile address bar slides away */
    padding: 0;
  }
  .why[data-live] .why-stage {
    position: sticky;
    top: 0;
    max-width: none;
    margin: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .why[data-live] .why-img {
    position: relative;
    z-index: 1;
    width: 88vw;
    height: 52vh;
    height: 52lvh;
    aspect-ratio: auto;
    margin: 0;
  }
  .why[data-live] .why-knock {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .why-knock-paper {
    fill: var(--paper);
  }
  /* the word is about 86vw wide: the letters fill the width of the screen once the zoom has settled */
  .why-knock-text {
    font-family: var(--font-heading);
    font-size: 20vw;
    letter-spacing: -0.02em;
  }  @media (min-width: 1024px) {
    .why[data-live] .why-img {
      width: 68vw;
      height: 62vh;
      height: 62lvh;
    }
  }
</style>
