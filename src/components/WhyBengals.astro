---
import { Image } from 'astro:assets';
import kita from '../assets/img/cats/kita.webp';
import candy from '../assets/img/cats/candy.webp';
import draco from '../assets/img/cats/draco.webp';
import chester from '../assets/img/cats/chester.webp';
import cosmo from '../assets/img/cats/cosmo.webp';

// Photos already on the site, for now: swap them for the real ones (one per trait). `side` is the side of the page the photo is
// on, `speed` how far it drifts against the page while it passes, `tilt` how far the spot is turned (degrees).
const scenes = [
  { img: candy, name: 'Candy', alt: 'Candy, one of our Bengals', side: 'right', speed: 0.75, tilt: -3, title: 'Rosette markings', text: 'A coat as unique as a fingerprint, with wild-inspired patterns impossible to replicate.' },
  { img: draco, name: 'Draco', alt: 'Draco, one of our Bengals', side: 'left', speed: 1.3, tilt: 2, title: 'Wild by nature', text: 'Descended from Asian Leopard Cats, with an untamed spirit refined for home life.' },
  { img: chester, name: 'Chester', alt: 'Chester, one of our Bengals', side: 'right', speed: 0.95, tilt: -2, title: 'Remarkable intelligence', text: 'Quick to learn, endlessly curious and deeply engaged with their world.' },
  { img: cosmo, name: 'Cosmo', alt: 'Cosmo, one of our Bengals', side: 'left', speed: 1.2, tilt: 3, title: 'Devoted companions', text: 'Bengals form lasting bonds: loyal, affectionate and uniquely present.' },
];

// The photos are cut to the spots of a Bengal's coat: soft, uneven, no two alike. Each spot is a ring of points around the
// middle of a unit square (a radius per point, so the edge wanders), joined into one smooth closed curve (Catmull-Rom turned
// into cubic Béziers). Used twice: as the clip of the photo and as the thin ring drawn around it, like the outline of a rosette.
const spotPath = (radii: number[], stretch: [number, number], turn: number) => {
  const n = radii.length;
  const pts = radii.map((r, i) => {
    const a = (i / n) * Math.PI * 2 + turn;
    return [0.5 + Math.cos(a) * r * stretch[0], 0.5 + Math.sin(a) * r * stretch[1]];
  });
  const f = (v: number) => v.toFixed(4);
  let d = `M ${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n];
    const p1 = pts[i];
    const p2 = pts[(i + 1) % n];
    const p3 = pts[(i + 2) % n];
    d += ` C ${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return `${d} Z`;
};
const lobes = (n: number, base: number, amount: number, count: number, phase: number) =>
  Array.from({ length: n }, (_, i) => base + amount * Math.cos(count * ((i / n) * Math.PI * 2) + phase));
const spots = [
  spotPath([0.46, 0.43, 0.47, 0.44, 0.46, 0.42, 0.47, 0.45, 0.43, 0.46], [1, 1], 0.2), // a rounded, slightly lumpy spot
  spotPath([0.48, 0.4, 0.38, 0.44, 0.48, 0.47, 0.4, 0.37, 0.43, 0.47], [0.86, 1], 1.1), // a tall, tapering one
  spotPath([0.46, 0.47, 0.44, 0.3, 0.25, 0.33, 0.44, 0.47, 0.46, 0.45], [1, 0.96], 0.5), // a kidney: dented on one side
  spotPath(lobes(12, 0.4, 0.07, 3, 0.5), [1, 1], 0), // three soft lobes, like a rosette
];
---

<!--
  Pinned sequence, then a long scroll. The photo starts as two tiles, the left one lower and the right one higher, a small
  gap between them. First the tiles level out, then the gap closes and they are one photo, which grows to fill the whole
  screen, and then the paper closes in around the word BENGALS (the letters shrink from huge), leaving the photo only
  inside the letters. The paper burns away from the middle and shows the dark page with the big heading; the pin ends
  and the page goes on scrolling down: framed photos drift in parallax and open with a clip-path as they arrive, each
  beside one of the four traits.
  Without the script (or with reduced motion): the photo is whole and everything just stacks.
-->
<section class="why" id="why-bengals">
  <div class="why-track">
    <div class="why-stage">
      <div class="why-img">
        <div class="why-half why-half--l">
          <Image src={kita} alt="Kita, a golden Bengal queen" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
        </div>
        <div class="why-half why-half--r" aria-hidden="true">
          <Image src={kita} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
        </div>
      </div>

      <!-- Knockout: a sheet of paper with the word BENGALS cut out of it, over the photo. At first the letters are so huge
           that the whole screen is inside them (the photo shows); they shrink to the word, and the photo is left in the
           letters. The script places the word and scales it around the centre of the stage. -->
      <svg class="why-knock" aria-hidden="true" focusable="false">
        <defs>
          <mask id="why-knock-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
            <rect width="100%" height="100%" fill="#fff"></rect>
            <g class="why-knock-word">
              <text class="why-knock-text" text-anchor="middle" dominant-baseline="central" fill="#000">BENGALS</text>
            </g>
          </mask>
        </defs>
        <rect class="why-knock-paper" width="100%" height="100%" mask="url(#why-knock-mask)"></rect>
      </svg>

      <!-- What the burn reveals: the first screen of the dark page. In the pinned chapter it sits under the photo and under
           the ember canvas; without the script it is simply the heading that follows the photo. -->
      <div class="why-copy">
        <header class="why-head">
          <p class="eyebrow">Bengal excellence</p>
          <h2><span class="why-line"><span>Why</span></span><em class="why-line"><span>Bengals?</span></em></h2>
        </header>
      </div>
    </div>
  </div>

  <!-- The rest of the dark page. It starts under the end of the pinned chapter, so the first photo rises over the bottom of
       the heading's screen before the pin lets go. -->
  <!-- The spots the photos are cut to (objectBoundingBox: the same curve fits any size of box) -->
  <svg class="why-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {spots.map((d, i) => (
        <clipPath id={`why-spot-${i}`} clipPathUnits="objectBoundingBox"><path d={d}></path></clipPath>
      ))}
    </defs>
  </svg>

  <div class="why-more">
    {
      scenes.map((s, i) => (
        <article class={`why-scene why-scene--${s.side}`}>
          <div class="why-spot" data-speed={s.speed} data-tilt={s.tilt} style={`--tilt:${s.tilt}deg`}>
            <svg class="why-ring" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d={spots[i % spots.length]} vector-effect="non-scaling-stroke"></path>
            </svg>
            <figure class="why-fig">
              <div class="why-shape" style={`clip-path:url(#why-spot-${i % spots.length})`}>
                <Image src={s.img} alt={s.alt} widths={[600, 1000, 1400]} sizes="(min-width:1024px) 40vw, 80vw" loading="lazy" />
              </div>
            </figure>
          </div>
          <div class="why-text">
            <p class="why-statement" aria-label={s.text}>
              {s.text.split(' ').map((w) => (
                <Fragment>
                  <span class="w" aria-hidden="true"><span>{w}</span></span>{' '}
                </Fragment>
              ))}
            </p>
            <i class="trait-line" aria-hidden="true"></i>
            <div class="why-by">
              <h3>{s.title}</h3>
              <p>{s.name}</p>
            </div>
          </div>        </article>
      ))
    }
  </div></section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mount } from '../scripts/lifecycle';
  import { EMBER } from '../scripts/settings';
  import type { EmberBurn } from '../scripts/ember-burn';

  gsap.registerPlugin(ScrollTrigger);

  mount(() => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const section = document.getElementById('why-bengals')!;
      const track = section.querySelector<HTMLElement>('.why-track')!;
      const stage = section.querySelector<HTMLElement>('.why-stage')!;
      const img = section.querySelector<HTMLElement>('.why-img')!;
      const halfL = section.querySelector<HTMLElement>('.why-half--l')!;
      const halfR = section.querySelector<HTMLElement>('.why-half--r')!;

      section.dataset.live = '';

      const H = () => stage.clientHeight;
      const W = () => window.innerWidth;

      // start: the left tile lower, the right one higher, and a small gap between them
      gsap.set(halfL, { x: () => -W() * 0.007, y: () => H() * 0.06 });
      gsap.set(halfR, { x: () => W() * 0.007, y: () => -H() * 0.06 });

      // A sticky stage inside a tall track: the scroll position scrubs the timeline (no GSAP pin: on touch screens it
      // would switch the stage to position:fixed on the main thread and jitter).
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        // refreshPriority: this chapter is far down the page, below pins that are made later (the stage, the cats row). A lower
        // priority makes it measure itself after them, so their spacers are counted in its start and end.
        scrollTrigger: { trigger: track, start: 'top top', end: 'bottom bottom', scrub: 1, invalidateOnRefresh: true, refreshPriority: -1 },
      });

      // 1. the tiles level out
      tl.to([halfL, halfR], { y: 0, duration: 1, ease: 'power2.inOut' }, 0);
      // 2. then the gap closes: one photo
      tl.to([halfL, halfR], { x: 0, duration: 0.8, ease: 'power2.inOut' }, 0.9);
      // 3. the finished photo grows to fill the whole screen (the width and height are animated, so the photo re-crops
      //    instead of stretching)
      tl.to(img, { width: () => stage.clientWidth, height: () => stage.clientHeight, duration: 1.4, ease: 'power2.inOut' }, 1.7);
      // 4. the paper closes in around the word: the letters start so big that the whole screen is inside them, then shrink
      //    to the width of the screen, so the photo ends up only in the letters.
      //    The word is placed at the centre of the stage and scaled around that centre by hand (a matrix on the <g>): GSAP's own
      //    transform origin needs a bounding box, and elements inside a <mask> have none, so it scaled from the corner.
      const knock = section.querySelector<SVGElement>('.why-knock')!;
      const word = knock.querySelector<SVGGElement>('.why-knock-word')!;
      const text = knock.querySelector<SVGTextElement>('.why-knock-text')!;
      const zoom = { s: 8 };
      const place = () => {
        const cx = stage.clientWidth / 2;
        const cy = stage.clientHeight / 2;
        text.setAttribute('x', String(cx));
        text.setAttribute('y', String(cy));
        word.setAttribute('transform', `translate(${cx * (1 - zoom.s)} ${cy * (1 - zoom.s)}) scale(${zoom.s})`);
      };
      place();
      ScrollTrigger.addEventListener('refresh', place); // sizes can change; the centre is read again each time

      gsap.set(knock, { opacity: 0 });

      // 5. the ember. When the word has settled the paper catches fire in the middle and burns away, and the dark page under
      //    it (the heading) shows through the hole. The burn is the scroll position: scrub it back and the paper grows
      //    back. three.js and the burn shader are fetched shortly before the section arrives.
      const copy = section.querySelector<HTMLElement>('.why-copy')!;
      const eyebrow = copy.querySelector<HTMLElement>('.eyebrow')!;
      const headLines = gsap.utils.toArray<HTMLElement>('.why-line > span', copy);
      const photo = halfL.querySelector<HTMLImageElement>('img')!;
      let ember: EmberBurn | null = null;
      let disposed = false;
      const swap = { v: 0 }; // 0 = the real photo and word are on screen, 1 = the canvas has taken over
      const burn = { p: 0 }; // 0 = untouched, 1 = burnt away

      gsap.set(eyebrow, { autoAlpha: 0, y: 12 });
      gsap.set(headLines, { yPercent: 115 }); // each line waits below its own window
      copy.style.visibility = 'hidden';

      const apply = () => {
        const swapped = swap.v > 0.5;
        copy.style.visibility = swapped ? 'visible' : 'hidden';
        if (ember) {
          copy.style.opacity = '1';
          // the canvas shows the finished picture, so the real photo and word step aside; the canvas hides itself when burnt
          img.style.visibility = swapped ? 'hidden' : '';
          knock.style.visibility = swapped ? 'hidden' : '';
          ember.show(swapped && burn.p < 0.999);
        } else {
          copy.style.opacity = String(burn.p); // no WebGL (or not loaded yet): the page simply fades in over the word
        }
      };

      // the finished picture as a flat image for the shader: paper, with the photo showing through the word
      const bake = (): HTMLCanvasElement => {
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        const r = Math.min(window.devicePixelRatio || 1, EMBER.maxPixelRatio);
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(w * r);
        canvas.height = Math.round(h * r);
        const ctx = canvas.getContext('2d')!;
        ctx.scale(r, r);
        ctx.fillStyle = getComputedStyle(section).getPropertyValue('--paper').trim() || '#faf8f3';
        ctx.fillRect(0, 0, w, h);
        const iw = photo.naturalWidth;
        const ih = photo.naturalHeight;
        if (!iw || !ih) return canvas;
        const layer = document.createElement('canvas');
        layer.width = canvas.width;
        layer.height = canvas.height;
        const lctx = layer.getContext('2d')!;
        lctx.scale(r, r);
        // the photo, covering the stage with the same focal point as the tiles (50% 35%)
        const s = Math.max(w / iw, h / ih);
        lctx.drawImage(photo, (w - iw * s) * 0.5, (h - ih * s) * 0.35, iw * s, ih * s);
        // keep it only inside the letters, set exactly like the SVG word
        const style = getComputedStyle(text);
        lctx.globalCompositeOperation = 'destination-in';
        lctx.font = `${parseFloat(style.fontSize)}px ${style.fontFamily}`;
        if ('letterSpacing' in lctx && style.letterSpacing !== 'normal') (lctx as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = style.letterSpacing;
        lctx.textAlign = 'center';
        lctx.textBaseline = 'middle';
        lctx.fillStyle = '#000';
        lctx.fillText(text.textContent ?? '', w / 2, h / 2);
        ctx.drawImage(layer, 0, 0, w, h);
        return canvas;
      };

      const load = async () => {
        try {
          const module = await import('../scripts/ember-burn');
          photo.loading = 'eager';
          await Promise.all([photo.decode().catch(() => undefined), document.fonts.ready]);
          if (disposed) return;
          const created = await module.createEmberBurn(stage, {
            paper: bake(),
            origin: EMBER.origin,
            emberColor: EMBER.color,
            charColor: EMBER.char,
            glow: EMBER.glow,
            edge: EMBER.edge,
            roughness: EMBER.roughness,
            detail: EMBER.detail,
            scorch: EMBER.scorch,
            gold: EMBER.gold,
            lobes: EMBER.lobes,
            charWidth: EMBER.charWidth,
            speckle: EMBER.speckle,
            flicker: EMBER.flicker,
            sparks: EMBER.sparks,
            maxPixelRatio: EMBER.maxPixelRatio,
          });
          if (disposed) {
            created?.destroy();
            return;
          }
          ember = created;
          ember?.setProgress(burn.p);
          apply();
        } catch {
          ember = null; // the fade-in fallback in apply() takes over
        }
      };
      ScrollTrigger.create({ trigger: section, start: EMBER.loadAhead, once: true, refreshPriority: -1, onEnter: () => void load() });

      // sizes can change: the canvas and the flat picture are made again
      const onRefresh = () => {
        if (!ember) return;
        ember.resize();
        ember.setPaper(bake());
      };
      ScrollTrigger.addEventListener('refresh', onRefresh);

      tl.to({}, { duration: 0.3 }); // a beat on the full-screen photo
      tl.to(knock, { opacity: 1, duration: 0.6 }, '>');
      tl.to(zoom, { s: 1, duration: 1.5, ease: 'power3.inOut', onUpdate: place, immediateRender: false }, '<');
      tl.to({}, { duration: 0.4 }); // a beat on the finished word
      tl.to(swap, { v: 1, duration: 0.02, onUpdate: apply }, '>');
      tl.addLabel('burn');
      tl.to(burn, { p: 1, duration: 2, ease: 'none', onUpdate: () => { ember?.setProgress(burn.p); apply(); } }, 'burn');
      // the heading waits until the burn has opened most of the screen, then rises into its lines one after the other
      tl.to(eyebrow, { autoAlpha: 1, y: 0, duration: 1, ease: 'power2.out' }, 'burn+=1.5');
      tl.to(headLines, { yPercent: 0, duration: 1.5, stagger: 0.3, ease: 'power3.out' }, 'burn+=1.7');
      tl.to({}, { duration: 0.9 }); // a rest on the heading before the pin lets go and the page scrolls on

      // 6. the long scroll. Each scene is a photo cut to the shape of a spot of the coat, beside one trait. A clip-path opens the
      //    photo from a narrow slit to its full width as the scene arrives; the spot drifts against the page while it passes
      //    (each at its own speed, a little turned) and the picture inside drifts the other way; a thin ring around it turns
      //    slowly the opposite way, like the outline of a rosette; the statement rises in word by word, its gold line draws and the caption fades in.
      const CLOSED = 'inset(0% 100% 0% 0%)';
      const OPEN = 'inset(0% 0% 0% 0%)';
      // both ends in full (fromTo): the browser shortens "inset(0% 44% 0% 44%)" to "inset(0% 44%)" when GSAP reads it back,
      // and the two strings would then no longer line up value by value
      const SLIT = 'inset(0% 44% 0% 44%)';
      const scenes = gsap.utils.toArray<HTMLElement>('.why-scene', section);
      scenes.forEach((scene) => {
        const spot = scene.querySelector<HTMLElement>('.why-spot')!;
        const fig = scene.querySelector<HTMLElement>('.why-fig')!;
        const ring = scene.querySelector<SVGElement>('.why-ring')!;
        const pic = fig.querySelector<HTMLElement>('img')!;
        const words = gsap.utils.toArray<HTMLElement>('.why-statement .w > span', scene);
        const by = scene.querySelector<HTMLElement>('.why-by')!;
        const line = scene.querySelector<HTMLElement>('.trait-line')!;
        const speed = Number(spot.dataset.speed) || 1;
        const tilt = Number(spot.dataset.tilt) || 0;
        // refreshPriority: see the main timeline above; these also sit below the pins that are made later
        const through = { trigger: scene, start: 'top bottom', end: 'bottom top', scrub: true, invalidateOnRefresh: true, refreshPriority: -1 };
        const arrive = { trigger: scene.querySelector('.why-text'), start: 'top 85%', toggleActions: 'play none none reverse', refreshPriority: -1 };

        gsap.set(spot, { rotation: tilt });
        gsap.set(pic, { scale: 1.3 });
        gsap.set(ring, { autoAlpha: 0 });
        gsap.set(words, { yPercent: 115 }); // each word waits below its own window
        gsap.set(by, { autoAlpha: 0, y: 16 });
        gsap.set(line, { clipPath: CLOSED });

        gsap.fromTo(fig, { clipPath: SLIT }, { clipPath: OPEN, ease: 'power2.inOut', scrollTrigger: { trigger: scene, start: 'top 92%', end: 'top 35%', scrub: 0.8, refreshPriority: -1 } });
        gsap.fromTo(spot, { y: () => 90 * speed }, { y: () => -90 * speed, ease: 'none', scrollTrigger: through });
        gsap.fromTo(pic, { yPercent: -9 }, { yPercent: 9, ease: 'none', scrollTrigger: through });
        gsap.fromTo(ring, { rotation: 10 }, { rotation: -10, ease: 'none', scrollTrigger: through });
        gsap.to(ring, { autoAlpha: 1, duration: 1.2, ease: 'power2.out', scrollTrigger: arrive });
        gsap.to(words, { yPercent: 0, duration: 1.1, stagger: 0.045, ease: 'power3.out', scrollTrigger: arrive });
        gsap.to(by, { autoAlpha: 1, y: 0, duration: 0.9, delay: 0.5, ease: 'power2.out', scrollTrigger: arrive });
        gsap.to(line, { clipPath: OPEN, duration: 1.1, ease: 'power3.inOut', scrollTrigger: arrive });
      });
      return () => {
        disposed = true;
        ember?.destroy();
        ember = null;
        ScrollTrigger.removeEventListener('refresh', place);
        ScrollTrigger.removeEventListener('refresh', onRefresh);
        copy.style.visibility = '';
        copy.style.opacity = '';
        img.style.visibility = '';
        knock.style.visibility = '';
        delete section.dataset.live;
      };
    });
    return () => mm.revert();
  });
</script>

<style>
  .why {
    background: var(--paper);
    color: var(--ink);
  }

  /* ---- plain stack: photo, heading, scenes (no script / reduced motion) ---- */
  .why-track {
    padding: clamp(4rem, 12vh, 9rem) 1.5rem 0;
  }
  .why-stage {
    max-width: 72rem;
    margin: 0 auto;
  }
  /* the two tiles side by side; together they are one photo */
  .why-img {
    display: flex;
    width: min(100%, 52rem);
    aspect-ratio: 4 / 5;
    margin: 0 auto;
  }
  /* No shadow on the tiles (each would cast a dark line onto the other where they meet), and the right tile tucks half a
     pixel under the left one so no hairline of paper shows between them at fractional widths. */
  .why-half {
    position: relative;
    width: 50%;
    height: 100%;
    overflow: hidden;
    background: var(--placeholder);
    will-change: transform;
  }
  .why-half--r {
    width: calc(50% + 0.5px);
    margin-left: -0.5px;
  }
  .why-knock {
    display: none;
  }
  /* each tile shows its side of the same photo: the image is twice as wide as the tile */
  .why-half :global(img) {
    position: absolute;
    top: 0;
    width: 200%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .why-half--l :global(img) { left: 0; }
  .why-half--r :global(img) { right: 0; }

  .why-copy {
    padding: clamp(3.5rem, 10vh, 7rem) 0 clamp(2rem, 6vh, 4rem);
  }
  .why-head {
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 1rem;
  }
  h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    margin: 0;
  }

  /* the scenes on a dark page: a photo in the shape of a spot of the coat, and one trait */
  .why-defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .why-more {
    background: var(--ink-warm);
    color: var(--cream);
    padding: clamp(3rem, 8vh, 6rem) 1.5rem clamp(5rem, 14vh, 10rem);
    overflow-x: clip; /* the rings around the spots reach past the edge of a narrow screen; clip, so nothing is made to scroll */
  }
  .why-scene {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: clamp(2rem, 8vh, 5rem) 0;
  }
  /* the cell the spot lives in: the photo fills it, the ring is a little larger */
  .why-spot {
    position: relative;
    width: 78%;
    aspect-ratio: 1 / 1.08;
  }
  .why-scene--right .why-spot { margin-left: auto; }
  .why:not([data-live]) .why-spot { rotate: var(--tilt, 0deg); }
  .why-fig {
    position: absolute;
    inset: 0;
    margin: 0;
    z-index: 1;
  }
  .why-shape {
    width: 100%;
    height: 100%;
    background: #0c0907;
  }
  .why-shape :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  /* the thin ring around the spot, drawn with the same curve, a little larger and turned: the outline of a rosette */
  .why-ring {
    position: absolute;
    left: -7%;
    top: -7%;
    width: 114%;
    height: 114%;
    z-index: 0;
