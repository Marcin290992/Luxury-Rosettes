---
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Luxury Rosettes',
  description = 'Luxury Rosettes — TICA registered Bengal cat breeder in the UK. Champion bloodlines, health-tested kittens raised with love.',
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Montserrat:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- A refresh starts the page over: no restored scroll position (the pinned sections and the intro are built to start from the top) -->
    <script is:inline>
      try {
        const nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') {
          history.scrollRestoration = 'manual';
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
          scrollTo(0, 0);
        }
      } catch (e) {}
    </script>
    <!-- The intro of the home page (Preloader.astro) is marked here, in the head, so that it is known before the first paint: until the
         preloader itself is built the screen is already dark and nothing of the page shows. (Not re-run on a click through: only on a real load.) -->
    <script is:inline>
      try {
        if (
          document.readyState === 'loading' &&
          location.pathname === '/' &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('preloading', 'preloaded');
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLenis, destroyLenis } from '../scripts/lenis';
  import { initDebug } from '../scripts/debug-log';
  import { reveal } from '../scripts/page-transition';

  initDebug(); // only does anything when the page is opened with ?debug=1

  // The smooth scroll (the "weight" of the page) belongs to every page, so it lives here and is rebuilt after each page swap.
  mount(() => {
    initLenis();
    return destroyLenis;
  });

  // The smooth scroll must be gone before the page is swapped: a running scroll would otherwise be caught in the new page's layout.
  document.addEventListener('astro:before-swap', destroyLenis);

  // The new page is a fresh page and starts at its top (its pinned sections and the intro are built to start from there). The browser
  // must not restore an old position either.
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

  // The cover that hid the swap (see page-transition.ts) now opens onto the new page. The direction was decided when the cover was
  // painted (NavPill, before navigate()); ?pt:dir is read back here so the swing matches.
  document.addEventListener('astro:after-swap', () => {
    window.scrollTo(0, 0);
    const dir = document.documentElement.dataset.ptDir === '-1' ? 'backwards' : 'forwards';
    reveal(dir);
  });
</script>

<style is:global>
  :root {
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Montserrat', sans-serif;
    --font-logo: 'Cinzel Decorative', serif;

    /* the page's two colours */
    --paper: #faf8f3;
    --ink: #1a1a1a;

    /* accents and the colours that repeat across sections */
    --gold: #d4af37; /* buttons and hairlines on dark */
    --gold-deep: #b8922a; /* gold as text on the paper */
    --cream: #efe9dc; /* text on the dark closing sections */
    --ink-warm: #1a1410; /* text on gold */
    --placeholder: #e9e4d9; /* what a photo frame shows before its image loads */

    /* the dashed rule, in the three strengths the page uses */
    --dash-track: 1px dashed rgba(26, 26, 26, 0.28); /* the light track behind a progress line */
    --dash-divider: 1px dashed rgba(26, 26, 26, 0.3); /* dividers between blocks */
    --dash-strong: 1px dashed #1a1a1a; /* the line that fills in over a track */
  }
  /* The dashed rule: the page's one recurring line (hero rail, progress lines, dividers).
     Elements with data-dash draw themselves in from the left when they scroll into view. */
  .dash {
    display: block;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px dashed rgba(26, 26, 26, 0.4);
  }
  /* Lenis's recommended base styles: native smooth-scroll must not fight the JS one */
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-stopped {
    overflow: clip;
  }
  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
  }
</style>

<style is:global>
  /* The scrollbar is part of the page picture the transition moves, so it showed up as a grey strip at the right edge of the
     shrinking page. The page scrolls the same, there is just no bar (the smooth scroll and the nav make it unnecessary). */
  html {
    scrollbar-width: none;
  }
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }

    /* The intro of the home page is dark from the very first paint (the preloader's own dark veil takes over once it exists). */
  html.preloading {
    background: #000;
  }
  html.preloading body {
    background: #000;
  }

  /* ---- page transition (see scripts/page-transition.ts) ----
     The browser's own View Transition snapshot is not used: it is drawn at the height of the largest window, while a scrolled phone
     screen shows the smaller one, and that mismatch was the jump at the start of every transition. Instead the transition is this
     overlay — plain DOM in the page's own colour — so the phone's address bar has no part in it and cannot make it jump.

     The overlay is the screen; the card inside it is what moves, exactly as in the codegrid demo: the page folds away to the lower
     left, then a fresh card swings in from the lower right and opens to the full screen. */

  .pt-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999; /* above the nav pill (1000): the whole picture leaves, the pill included */
    display: none;
    pointer-events: none;
    perspective: 1400px;
  }
  .pt-card {
    position: absolute;
    inset: 0;
    background: var(--paper);
    will-change: transform, clip-path;
    backface-visibility: hidden;
  }

  /* the direction of the swing: 1 forward (leaves left), -1 back (leaves right). Set in page-transition.ts. */
  :root {
    --pt-dir: 1;
  }
  :root[data-pt-dir='-1'] {
    --pt-dir: -1;
  }

  /* Phase 1: the page folds away to the lower left. */
  .pt-overlay.is-out .pt-card {
    animation: pt-out 520ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  /* Phase 2: the new page swings in from the lower right and opens. */
  .pt-overlay.is-in .pt-card {
    animation: pt-in 780ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  @keyframes pt-out {
    0% {
      transform: translateX(0) translateY(0) rotate(0deg) scale(1);
      clip-path: inset(0% round 0px);
    }
    55% {
      transform: translateX(calc(var(--pt-dir) * -35%)) translateY(6%) rotate(calc(var(--pt-dir) * -10deg)) scale(0.72);
      clip-path: inset(0% round 40px);
    }
    100% {
      transform: translateX(calc(var(--pt-dir) * -115%)) translateY(34%) rotate(calc(var(--pt-dir) * -26deg)) scale(0.6);
      clip-path: inset(0% round 40px);
    }
  }
  @keyframes pt-in {
    0% {
      transform: translateX(calc(var(--pt-dir) * 115%)) translateY(34%) rotate(calc(var(--pt-dir) * 26deg)) scale(0.6);
      clip-path: inset(0% round 40px);
    }
    45% {
      transform: translateX(calc(var(--pt-dir) * 35%)) translateY(6%) rotate(calc(var(--pt-dir) * 10deg)) scale(0.72);
      clip-path: inset(0% round 40px);
    }
    60% {
      transform: translateX(0) translateY(0) rotate(0deg) scale(0.72);
      clip-path: inset(0% round 40px);
    }
    100% {
      transform: translateX(0) translateY(0) rotate(0deg) scale(1);
      clip-path: inset(0% round 0px);
    }
  }

  /* Phones and tablets: the same swing, but cheaper. Animating clip-path (the rounded corners) cannot run on the GPU: every frame the
     browser re-cuts a full-screen picture on the main thread, which is where the stutter came from. Transforms alone stay on the GPU,
     so here the corners are not rounded. */
  @media (pointer: coarse), (max-width: 1024px) {
    .pt-overlay.is-out .pt-card {
      animation-name: pt-out-lite;
    }
    .pt-overlay.is-in .pt-card {
      animation-name: pt-in-lite;
    }
    @keyframes pt-out-lite {
      0% {
        transform: translateX(0) translateY(0) rotate(0deg) scale(1);
      }
      55% {
        transform: translateX(calc(var(--pt-dir) * -35%)) translateY(6%) rotate(calc(var(--pt-dir) * -10deg)) scale(0.72);
      }
      100% {
        transform: translateX(calc(var(--pt-dir) * -115%)) translateY(34%) rotate(calc(var(--pt-dir) * -26deg)) scale(0.6);
      }
    }
    @keyframes pt-in-lite {
      0% {
        transform: translateX(calc(var(--pt-dir) * 115%)) translateY(34%) rotate(calc(var(--pt-dir) * 26deg)) scale(0.6);
      }
      45% {
        transform: translateX(calc(var(--pt-dir) * 35%)) translateY(6%) rotate(calc(var(--pt-dir) * 10deg)) scale(0.72);
      }
      60% {
        transform: translateX(0) translateY(0) rotate(0deg) scale(0.72);
      }
      100% {
        transform: translateX(0) translateY(0) rotate(0deg) scale(1);
      }
    }
  }
</style>
