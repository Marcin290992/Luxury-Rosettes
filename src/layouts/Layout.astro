---
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Luxury Rosettes',
  description = 'Luxury Rosettes — TICA registered Bengal cat breeder in the UK. Champion bloodlines, health-tested kittens raised with love.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Montserrat:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- A refresh starts the page over: no restored scroll position (the pinned sections and the intro are built to start from the top) -->
    <script is:inline>
      try {
        const nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') {
          history.scrollRestoration = 'manual';
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
          scrollTo(0, 0);
        }
      } catch (e) {}
    </script>
    <!-- The intro of the home page (Preloader.astro) is marked here, in the head, so that it is known before the first paint: until the
         preloader itself is built the screen is already dark and nothing of the page shows. (Not re-run on a click through: only on a real load.) -->
    <script is:inline>
      try {
        if (
          document.readyState === 'loading' &&
          location.pathname === '/' &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('preloading', 'preloaded');
        }
      } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div id="scroll-root"><slot /></div>
    <div class="rotate-note" role="alert">
      <svg viewBox="0 0 48 48" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="15" y="5" width="18" height="38" rx="3.5" /><path d="M22 38h4" /></svg>
      <p>Please rotate your phone</p>
      <span>The site is made to be seen upright.</span>
    </div>
  </body>
</html>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLenis, destroyLenis } from '../scripts/lenis';
  import { initDebug } from '../scripts/debug-log';
  import { setupScrollRestore } from '../scripts/scroll-restore';
  import { settleLayout } from '../scripts/scroller';
  import { prefetch } from 'astro:prefetch';

  // After a page transition the nav is already on screen: the home hero must not hide it and run its intro for it again (see Hero.astro).
  // The router rewrites <html>'s classes on a swap, so `intro-ready` is put back at once.
  document.addEventListener('astro:before-swap', () => {
    const curtain = document.querySelector('.hero-curtain') as HTMLElement;
    if (curtain) {
      curtain.style.opacity = '0';
      curtain.style.visibility = 'hidden';
      curtain.style.animation = 'none';
    }
  });

  document.addEventListener('astro:after-swap', () => {
    (window as unknown as { __lrSwapped?: boolean }).__lrSwapped = true;
    document.documentElement.classList.add('intro-ready');
  });

  // Every page this page links to is fetched once the browser is idle, so a tap on any link (not only in the menu) finds its page already
  // there and the transition does not wait for the network.
  const warm = () => {
    const seen = new Set<string>([location.pathname]);
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      const u = new URL(a.href, location.href);
      if (u.origin !== location.origin || a.target || seen.has(u.pathname)) return;
      seen.add(u.pathname);
      prefetch(u.pathname + u.search, { ignoreSlowConnection: true });
    });
  };
  const idle = (window as unknown as { requestIdleCallback?: (f: () => void) => void }).requestIdleCallback;
  const later = () => (idle ? idle(warm) : setTimeout(warm, 1500));
  document.addEventListener('astro:page-load', later);

  initDebug(); // only does anything when the page is opened with ?debug=1
  setupScrollRestore(); // every page opens at its top; the router's restored position is put right while the page settles

  // The new page's picture is taken right after the swap callback returns, but the page is not built yet then: its pins and spacers appear a
  // few hundred ms later. So the callback is not finished until the layout is measured, or the picture would differ from the page that
  // replaces it at the end of the transition (a blink).
  if (typeof document.startViewTransition === 'function') {
    const start = document.startViewTransition.bind(document);
    document.startViewTransition = ((callback?: () => void | Promise<void>) =>
      start(async () => {
        await callback?.();
        settleLayout();
      })) as typeof document.startViewTransition;
  }

  // The smooth scroll (the "weight" of the page) belongs to every page: it is built with the page and taken away before the browser takes
  // the picture of the old page (it changes <html>'s classes and the document's height).
  mount(() => {
    initLenis();
    return destroyLenis;
  });
  document.addEventListener('astro:after-preparation', destroyLenis);
</script>

<style is:global>
  /* the pale blue rectangle that a phone or a tablet draws over a tapped link or button: the site has its own states for those */
  * {
    -webkit-tap-highlight-color: transparent;
  }
  :root {
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Montserrat', sans-serif;
    --font-logo: 'Cinzel Decorative', serif;

    /* the page's two colours */
    --paper: #faf8f3;
    --ink: #1a1a1a;

    /* accents and the colours that repeat across sections */
    --gold: #d4af37; /* buttons and hairlines on dark */
    --gold-deep: #b8922a; /* gold as text on the paper */
    --cream: #efe9dc; /* text on the dark closing sections */
    --ink-warm: #1a1410; /* text on gold */
    --placeholder: #e9e4d9; /* what a photo frame shows before its image loads */

    /* the dark layer over every full-screen photo of the home page (the hero and the intro's photos): an even tint, heavier at the top (the
       nav) and at the bottom. It is there from the first frame: nothing darkens afterwards. */
    --photo-dim:
      linear-gradient(to bottom, rgba(8, 7, 6, 0.55) 0%, rgba(8, 7, 6, 0.2) 35%, rgba(8, 7, 6, 0.65) 100%),
      rgba(8, 7, 6, 0.06);

    /* the space between one section and the next (a section's padding, top and bottom): one value for the whole page, tighter on a phone and
       a tablet, where 12vh of a tall screen was a very wide gap */
    --space: clamp(4rem, 12vh, 9rem);

    /* hover: how fast every button and link answers the pointer; a word's letters slide one after another (menu, LetterButton) */
    --hover-time: 0.32s;
    --hover-stagger: 0.012s;

    /* the dashed rule, in the three strengths the page uses */
    --dash-track: 1px dashed rgba(26, 26, 26, 0.28); /* the light track behind a progress line */
    --dash-divider: 1px dashed rgba(26, 26, 26, 0.3); /* dividers between blocks */
    --dash-strong: 1px dashed #1a1a1a; /* the line that fills in over a track */
  }
  /* The dashed rule: the page's one recurring line (hero rail, progress lines, dividers).
     Elements with data-dash draw themselves in from the left when they scroll into view. */
  .dash {
    display: block;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px dashed rgba(26, 26, 26, 0.4);
  }
  @media (max-width: 1023px) {
    :root {
      --space: clamp(3rem, 8vh, 5rem);
    }
  }
  /* Lenis's recommended base styles: native smooth-scroll must not fight the JS one */
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-stopped {
    overflow: clip;
  }
  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
  }
  /* On a laptop or a desktop the box is invisible: the window scrolls. On a phone or a tablet the document stays still and the page
     scrolls inside the box (scripts/scroller.ts): no address-bar movement, so no height jumps in the page transition. */
  #scroll-root {
    display: contents;
  }
  @media (pointer: coarse) {
    html,
    body {
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
    }
    #scroll-root {
      display: block;
      position: fixed;
      inset: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: none;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    #scroll-root::-webkit-scrollbar {
      display: none;
    }
    html.preloading #scroll-root {
      overflow: hidden;
    }
  }
</style>

<style is:global>
  /* The menu is open: the page behind it does not scroll (any device, any way: wheel, finger, keys) */
  /* NOT on body: when html is overflow:hidden it is the one that locks the window (its overflow goes to the viewport). A body that is
     overflow:hidden too becomes a scroll container of its own, and every position:sticky stage inside it (the "Every kitten, a story"
     photo, the Bengals chapter) stops sticking: the page behind the menu went blank. On a phone body is hidden all the time anyway (see above). */
  html.menu-open,
  html.menu-open #scroll-root {
    overflow: hidden !important;
    overscroll-behavior: none;
  }
  /* A phone held sideways: the site is made for upright screens, so a note covers it until the phone is turned back */
  .rotate-note {
    display: none;
  }
  @media (pointer: coarse) and (orientation: landscape) and (max-height: 520px) {
    .rotate-note {
      position: fixed;
      inset: 0;
      z-index: 100000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 1.5rem;
      text-align: center;
      background: var(--paper);
      color: var(--ink);
    }
    .rotate-note svg {
      color: #ba8e47;
      animation: rotate-hint 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    .rotate-note p {
      margin: 0.4rem 0 0;
      font-family: var(--font-heading);
      font-size: 1.6rem;
    }
    .rotate-note span {
      font-family: var(--font-body);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.55;
    }
  }
  @keyframes rotate-hint {
    0%, 20% { transform: rotate(-90deg); }
    60%, 100% { transform: rotate(0deg); }
  }
  /* The scrollbar is part of the page picture the transition moves, so it showed up as a grey strip at the right edge of the
     shrinking page. The page scrolls the same, there is just no bar (the smooth scroll and the nav make it unnecessary). */
  html {
    scrollbar-width: none;
  }
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }

  /* ---- page transition (after codegrid's View Transition demo) ----
     The old page shrinks to 85% and slides up and out (1200ms); the new one waits below the screen, slides up at 85% and grows to the
     full screen (1800ms). Only transforms are animated, so it runs on the GPU. The nav pill has no layer of its own: it is part of
     the page and moves with it. The dark background is the frame seen around the shrunken pages. */
  ::view-transition {
    background: #0d0b09;
  }
  /* On a phone the snapshot of the page is the size of the LARGEST window (address bar hidden, lvh), while the screen shows the window as it is
     now. So the layer is lvh tall and the picture fills it from the top (cover): the top of the snapshot is the top of the page, and the
     part below the screen, which nobody sees, is cropped, not squeezed. (On a desktop all the heights are equal and nothing changes.) */
  ::view-transition-group(root) {
    animation: none;
    height: 100lvh;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    height: 100%;
    object-fit: cover;
    object-position: top;
    will-change: transform;
  }
  /* iOS Safari only (-webkit-touch-callout exists nowhere else): there the picture is not that tall, so `cover` would stretch it and the
     live page, a moment later, would be smaller than the picture (the page seemed to scale at the end). The picture keeps its own size. */
  @supports (-webkit-touch-callout: none) {
    ::view-transition-group(root) {
      height: 100%;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      height: auto;
      object-fit: initial;
    }
  }
  ::view-transition-old(root) {
    animation: 1200ms linear both vt-out;
  }
  ::view-transition-new(root) {
    animation: 1800ms linear both vt-in;
  }
  @keyframes vt-out {
    0% {
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.86, 0, 0.07, 1);
    }
    50% {
      transform: scale(0.85);
      animation-timing-function: cubic-bezier(0.86, 0, 0.07, 1);
    }
    100% {
      transform: translateY(-100%) scale(0.85);
    }
  }
  @keyframes vt-in {
    0%,
    33.333% {
      transform: translateY(100%) scale(0.85);
      animation-timing-function: cubic-bezier(0.86, 0, 0.07, 1);
    }
    66.667% {
      transform: translateY(0) scale(0.85);
      animation-timing-function: cubic-bezier(0.86, 0, 0.07, 1);
    }
    100% {
      transform: translateY(0) scale(1);
    }
  }
  /* On a phone the address bar moves the page a little while it slides in or out, and the strip that shows is whatever is behind the
     page: it used to be the page's cream and ended up as a pale gap. So the page is dark behind its content, always (the body keeps
     painting its own cream). */
  html {
    background: #0d0b09;
  }
  /* the intro of the home page: dark from the very first paint (the preloader's own dark veil takes over once it exists) */
  html.preloading,
  html.preloading body {
    background: #000;
  }
  /* ?vtlab=1 (see debug-log.ts): the transition is held at its first frame for 4s and its layers are outlined, to read the geometry off a screenshot */
  html.vt-lab::view-transition-group(root) {
    outline: 6px solid #0af;
    outline-offset: -6px;
  }
  html.vt-lab::view-transition-old(root) {
    animation: 4s linear both vt-lab-hold !important;
    outline: 4px solid #f33;
    outline-offset: -12px;
    opacity: 0.85;
  }
  html.vt-lab::view-transition-new(root) {
    animation: 4s linear both vt-lab-hold !important;
    outline: 4px dashed #3f3;
    outline-offset: -20px;
    opacity: 0;
  }
  @keyframes vt-lab-hold {
    from,
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
