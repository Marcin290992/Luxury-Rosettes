---
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Luxury Rosettes',
  description = 'Luxury Rosettes — TICA registered Bengal cat breeder in the UK. Champion bloodlines, health-tested kittens raised with love.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Montserrat:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- A refresh starts the page over: no restored scroll position (the pinned sections and the intro are built to start from the top) -->
    <script is:inline>
      try {
        const nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') {
          history.scrollRestoration = 'manual';
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
          scrollTo(0, 0);
        }
      } catch (e) {}
    </script>
    <!-- The intro of the home page (Preloader.astro) is marked here, in the head, so that it is known before the first paint: until the
         preloader itself is built the screen is already dark and nothing of the page shows. (Not re-run on a click through: only on a real load.) -->
    <script is:inline>
      try {
        if (
          document.readyState === 'loading' &&
          location.pathname === '/' &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('preloading', 'preloaded');
        }
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initLenis, destroyLenis } from '../scripts/lenis';
  import { initDebug } from '../scripts/debug-log';

  initDebug(); // only does anything when the page is opened with ?debug=1

  // The page transition is drawn in the browser's "snapshot" space, not in the window you see. On a phone that space also covers the
  // area behind the address bar, so its top edge sits ABOVE the top of the visible page by the height of the bar (measured on a Pixel:
  // 56.19px; the nav pill is at 20px in the window but at 76.19px in the snapshot space). The picture of the old page was put at the top
  // of that space, so the whole card sat one bar-height too high and the page seemed to jump up as the transition began.
  // The offset is read from a fixed element that is in the transition by itself, the nav pill (its own layer is placed correctly by the
  // browser): its place in the snapshot space minus its place in the window. The root layer is then moved down by exactly that.
  // (On a desktop the two spaces are the same, the offset is 0 and nothing moves.) ?vtcomp=0 switches this off, ?vtcomp=1 on again.
  const SCB = 'lr-scb';
  const applyScb = (px: number) => document.documentElement.style.setProperty('--vt-scb', `${px.toFixed(2)}px`);
  const compOn = () => {
    try {
      const q = new URLSearchParams(location.search).get('vtcomp');
      if (q === '0') sessionStorage.setItem('lr-vtcomp', '0');
      if (q === '1') sessionStorage.removeItem('lr-vtcomp');
      return sessionStorage.getItem('lr-vtcomp') !== '0';
    } catch {
      return true;
    }
  };
  const measureScb = () => {
    const nav = document.getElementById('main-nav');
    const m = getComputedStyle(document.documentElement, '::view-transition-group(navbar)').transform;
    if (!nav || !m || m === 'none') return null;
    const d = new DOMMatrix(m).f - nav.getBoundingClientRect().top;
    return Number.isFinite(d) ? d : null;
  };
  // scbMax = the offset with the address bar fully shown (what was measured). It is needed BEFORE the first frame of a transition, so it
  // is kept from the last measurement, and for a fresh visit it is measured once, early, by a transition that changes nothing (below).
  let scbMax = 0;
  try {
    scbMax = parseFloat(sessionStorage.getItem(SCB) || '0') || 0;
  } catch {
    /* ignore */
  }
  const unitL = document.createElement('div');
  unitL.style.cssText = 'position:fixed;left:0;top:0;width:0;height:100lvh;visibility:hidden;pointer-events:none;';
  const unitS = document.createElement('div');
  unitS.style.cssText = 'position:fixed;left:0;top:0;width:0;height:100svh;visibility:hidden;pointer-events:none;';
  // how much of the address bar is shown right now: 1 = fully (the window is its smallest), 0 = hidden (the largest)
  const barShown = () => {
    document.body.append(unitL, unitS);
    const l = unitL.offsetHeight;
    const sm = unitS.offsetHeight;
    unitL.remove();
    unitS.remove();
    return l - sm < 4 ? 1 : Math.min(1, Math.max(0, (l - innerHeight) / (l - sm)));
  };
  const remember = (d: number) => {
    // only a measurement taken with the bar fully shown is the full offset
    if (barShown() < 0.98 || d < 0) return;
    scbMax = d;
    try {
      sessionStorage.setItem(SCB, String(d));
    } catch {
      /* ignore */
    }
  };
  // the router rewrites <html>'s attributes on a swap, so the value is set after it, in time for the first frame: the offset that was
  // measured earlier, scaled by how much of the bar is shown now; the real one replaces it as soon as the transition's layers exist
  document.addEventListener('astro:after-swap', () => applyScb(compOn() ? scbMax * barShown() : 0));
  document.addEventListener('astro:before-swap', (e) => {
    const vt = (e as Event & { viewTransition?: ViewTransition }).viewTransition;
    vt?.ready
      .then(() => {
        const d = compOn() ? measureScb() : 0;
        if (d === null) return;
        remember(d);
        applyScb(d);
      })
      .catch(() => {});
  });
  // A fresh visit has no measurement yet, and the first transition would start with the card too high for a moment. So once the page has
  // settled, a transition that changes nothing is started and skipped on the spot, only to read the offset (the picture is the same
  // before and after, so nothing shows). Phones only, and only while the bar is fully shown (that is when the full offset can be read).
  if (!scbMax && matchMedia('(pointer: coarse)').matches && typeof document.startViewTransition === 'function') {
    const probeScb = () => {
      if (scbMax || !compOn()) return;
      if (barShown() < 0.98 || document.documentElement.classList.contains('preloading')) return setTimeout(probeScb, 2500);
      const vt = document.startViewTransition(() => {});
      vt.ready
        .then(() => {
          const d = measureScb();
          if (d !== null) remember(d);
          vt.skipTransition();
        })
        .catch(() => {});
    };
    window.addEventListener('load', () => setTimeout(probeScb, 3000), { once: true });
  }

  // Test switches for the jump at the start of a page transition on a phone (they stay for the visit; ?vtoff=0 / ?novtbg=0 clear them):
  //   ?vtoff=1   the card swing is off on this device: the page just changes (tells whether the jump is in the card animation at all)
  //   ?novtbg=1  the page has no dark colour of its own behind its content (the way it was before the "pale gap" fix)
  const TESTS: Record<string, string> = { vtoff: 'vt-test-off', novtbg: 'no-vt-bg' };
  const applyTests = () => {
    try {
      const params = new URLSearchParams(location.search);
      for (const [key, cls] of Object.entries(TESTS)) {
        const q = params.get(key);
        if (q === '1') sessionStorage.setItem('lr-' + key, '1');
        if (q === '0') sessionStorage.removeItem('lr-' + key);
        document.documentElement.classList.toggle(cls, sessionStorage.getItem('lr-' + key) === '1');
      }
    } catch {
      /* ignore */
    }
  };
  applyTests();
  document.addEventListener('astro:after-swap', () => {
    // the router rewrites <html>'s classes on a swap
    try {
      for (const [key, cls] of Object.entries(TESTS)) document.documentElement.classList.toggle(cls, sessionStorage.getItem('lr-' + key) === '1');
    } catch {
      /* ignore */
    }
  });

  // The smooth scroll (the "weight" of the page) belongs to every page, so it lives here and is rebuilt after each page swap
  mount(() => {
    initLenis();
    return destroyLenis;
  });

  // Astro captures the outgoing page after preparation, so remove Lenis before that snapshot.
  document.addEventListener('astro:after-preparation', destroyLenis);
</script>

<style is:global>
  :root {
    --font-heading: 'Cormorant Garamond', serif;
    --font-body: 'Montserrat', sans-serif;
    --font-logo: 'Cinzel Decorative', serif;

    /* the page's two colours */
    --paper: #faf8f3;
    --ink: #1a1a1a;

    /* accents and the colours that repeat across sections */
    --gold: #d4af37; /* buttons and hairlines on dark */
    --gold-deep: #b8922a; /* gold as text on the paper */
    --cream: #efe9dc; /* text on the dark closing sections */
    --ink-warm: #1a1410; /* text on gold */
    --placeholder: #e9e4d9; /* what a photo frame shows before its image loads */

    /* the dashed rule, in the three strengths the page uses */
    --dash-track: 1px dashed rgba(26, 26, 26, 0.28); /* the light track behind a progress line */
    --dash-divider: 1px dashed rgba(26, 26, 26, 0.3); /* dividers between blocks */
    --dash-strong: 1px dashed #1a1a1a; /* the line that fills in over a track */
  }
  /* The dashed rule: the page's one recurring line (hero rail, progress lines, dividers).
     Elements with data-dash draw themselves in from the left when they scroll into view. */
  .dash {
    display: block;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px dashed rgba(26, 26, 26, 0.4);
  }
  /* Lenis's recommended base styles: native smooth-scroll must not fight the JS one */
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-stopped {
    overflow: clip;
  }
  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
  }
</style>

<style is:global>
  /* The scrollbar is part of the page picture the transition moves, so it showed up as a grey strip at the right edge of the
     shrinking page. The page scrolls the same, there is just no bar (the smooth scroll and the nav make it unnecessary). */
  html {
    scrollbar-width: none;
  }
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }

  /* ---- page transition (after codegrid's View Transition demo) ----
     The old page shrinks, turns and slips away to the lower left; the new one opens from the lower right corner at the same
     reduced size and grows to the full screen.
     The nav pill keeps its own layer and does not move. */
  ::view-transition {
    background: #0d0b09;
  }
  /* On a phone the snapshot of the page is the size of the LARGEST window (address bar hidden, e.g. 863px), while what is on the screen
     is the window as it is now (bar shown, e.g. 783px). The card was taller than the screen and the page seemed to jump up when it started.
     So the card is cut to the visible window (dvh): the top of the snapshot is the top of the page, and the part below the screen,
     which nobody saw, is cropped, not squeezed. (On a desktop all the heights are equal and nothing changes.) */
  ::view-transition-group(root) {
    animation: none;
    height: 100vh;
    /* svh = the smallest window (address bar shown): a constant. dvh followed the bar live, so a page scrolled down (bar hidden) changed
       height at the start of the transition when the bar came back. Taller snapshots are only cropped (object-fit: cover, top). */
    height: 100svh;
    translate: 0 var(--vt-scb, 0px); /* the snapshot space starts above the visible page on a phone, see the script above */
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* On a phone the browser's address bar moves the page a little while it slides in or out, and the strip that shows is whatever is
     behind the page: it used to be the page's cream and ended up as a pale gap on the cards. So the page is dark behind its content, always
     (set once, never switched at the start of a transition: the body keeps painting its own cream, so nothing on the page changes). */
  html {
    background: #0d0b09;
  }
  /* the intro of the home page: dark from the very first paint (the preloader's own dark veil takes over once it exists) */
  html.preloading {
    background: #000;
  }
  html.preloading body {
    background: #000;
  }
  #main-nav {
    view-transition-name: navbar;
  }
  ::view-transition-group(navbar) {
    animation: none;
    z-index: 100;
  }
  ::view-transition-old(navbar),
  ::view-transition-new(navbar) {
    animation: none;
    mix-blend-mode: normal;
  }
  /* Astro marks the direction of the navigation on <html>: forward goes left, back is the same swing the other way round. */
  :root {
    --vt-dir: 1;
  }
  :root[data-astro-transition='back'] {
    --vt-dir: -1;
  }

  /* The two pages swap places like cards: the old one shrinks and swings out to the lower left (tilting, as in codegrid's demo), the new
     one swings in from the lower right, mirrored, into the same place at the same small size, rests there for a moment, and only then grows to the full screen. */
  ::view-transition-old(root) {
    animation: 1500ms linear both page-out;
  }
  ::view-transition-new(root) {
    animation: 1500ms linear both page-in;
  }
  @keyframes page-out {
    0% {
      transform: translateX(0%) translateY(0%) rotate(0deg) scale(1);
      clip-path: inset(0% round 0px);
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    25% {
      transform: translateX(0%) translateY(0%) rotate(0deg) scale(0.6);
      clip-path: inset(0% round 40px);
      animation-timing-function: cubic-bezier(0.65, 0, 1, 1);
    }
    40% {
      transform: translateX(calc(var(--vt-dir) * -45%)) translateY(8%) rotate(calc(var(--vt-dir) * -14deg)) scale(0.6);
      clip-path: inset(0% round 40px);
      animation-timing-function: linear;
    }
    55%,
    100% {
      transform: translateX(calc(var(--vt-dir) * -115%)) translateY(40%) rotate(calc(var(--vt-dir) * -30deg)) scale(0.6);
      clip-path: inset(0% round 40px);
    }
  }
  @keyframes page-in {
    0%,
    25% {
      transform: translateX(calc(var(--vt-dir) * 115%)) translateY(40%) rotate(calc(var(--vt-dir) * 30deg)) scale(0.6);
      clip-path: inset(0% round 40px);
      animation-timing-function: linear;
    }
    40% {
      transform: translateX(calc(var(--vt-dir) * 45%)) translateY(8%) rotate(calc(var(--vt-dir) * 14deg)) scale(0.6);
      clip-path: inset(0% round 40px);
      animation-timing-function: cubic-bezier(0, 0, 0.35, 1);
    }
    55% {
      transform: translateX(0%) translateY(0%) rotate(0deg) scale(0.6);
      clip-path: inset(0% round 40px);
    }
    66% {
      transform: translateX(0%) translateY(0%) rotate(0deg) scale(0.6);
      clip-path: inset(0% round 40px);
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    }
    100% {
      transform: translateX(0%) translateY(0%) rotate(0deg) scale(1);
      clip-path: inset(0% round 0px);
    }
  }
  /* Phones and tablets: the same swing, but cheaper. Animating clip-path (the rounded corners) cannot run on the GPU: every frame
     the browser re-cuts a full-screen picture on the main thread, which is where the stutter came from. Transforms alone stay on the
     GPU, so here the corners are not rounded; the animation is also a little shorter. */
  @media (pointer: coarse), (max-width: 1024px) {
    ::view-transition-old(root) {
      animation-name: page-out-lite;
      animation-duration: 1100ms;
    }
    ::view-transition-new(root) {
      animation-name: page-in-lite;
      animation-duration: 1100ms;
    }
    ::view-transition-old(root),
    ::view-transition-new(root) {
      will-change: transform;
    }
    @keyframes page-out-lite {
      0% {
        transform: translateX(0%) translateY(0%) rotate(0deg) scale(1);
        animation-timing-function: cubic-bezier(0.65, 0, 1, 1);
      }
      25% {
        transform: translateX(0%) translateY(0%) rotate(0deg) scale(0.6);
        animation-timing-function: cubic-bezier(0.65, 0, 1, 1);
      }
      40% {
        transform: translateX(calc(var(--vt-dir) * -45%)) translateY(8%) rotate(calc(var(--vt-dir) * -14deg)) scale(0.6);
        animation-timing-function: linear;
      }
      55%,
      100% {
        transform: translateX(calc(var(--vt-dir) * -115%)) translateY(40%) rotate(calc(var(--vt-dir) * -30deg)) scale(0.6);
      }
    }
    @keyframes page-in-lite {
      0%,
      25% {
        transform: translateX(calc(var(--vt-dir) * 115%)) translateY(40%) rotate(calc(var(--vt-dir) * 30deg)) scale(0.6);
        animation-timing-function: linear;
      }
      40% {
        transform: translateX(calc(var(--vt-dir) * 45%)) translateY(8%) rotate(calc(var(--vt-dir) * 14deg)) scale(0.6);
        animation-timing-function: cubic-bezier(0, 0, 0.35, 1);
      }
      55%,
      66% {
        transform: translateX(0%) translateY(0%) rotate(0deg) scale(0.6);
      }
      66% {
        animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
      }
      100% {
        transform: translateX(0%) translateY(0%) rotate(0deg) scale(1);
      }
    }
  }
  /* test switches (see the script): ?vtoff=1 and ?novtbg=1 */
  html.vt-test-off::view-transition-old(root),
  html.vt-test-off::view-transition-new(root) {
    animation: none;
  }
  html.no-vt-bg {
    background: none;
  }
  /* ?vtlab=1 (see debug-log.ts): the transition is held at its first frame for 4s and its layers are outlined, to read the geometry off a screenshot */
  html.vt-lab::view-transition-group(root) {
    outline: 6px solid #0af;
    outline-offset: -6px;
  }
  html.vt-lab::view-transition-old(root) {
    animation: 4s linear both vt-lab-hold !important;
    outline: 4px solid #f33;
    outline-offset: -12px;
    opacity: 0.85;
  }
  html.vt-lab::view-transition-new(root) {
    animation: 4s linear both vt-lab-hold !important;
    outline: 4px dashed #3f3;
    outline-offset: -20px;
    opacity: 0;
  }
  @keyframes vt-lab-hold {
    from,
    to {
      transform: none;
      clip-path: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
