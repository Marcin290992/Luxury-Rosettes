---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import AwardsSpiral from '../components/AwardsSpiral.astro';
import AwardsList from '../components/AwardsList.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import closingPhoto from '../assets/img/story/award3.webp'; // placeholder: swap for the real closing photo

// Sample page. The photos, titles, shows, years and words of the awards are placeholders, to be replaced with the real ones.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/img/{cats,story}/*.webp', { eager: true });
const pool = Object.values(found).map((m) => m.default);
const words =
  'Placeholder text. A few calm sentences about this award: the show it was won at, the cat that won it and what it meant for the line.';
const awards = [
  ['Best in Show', 'Placeholder International Show · 2024'],
  ['Grand Champion', 'Placeholder Cat Club · 2024'],
  ['Best of Breed', 'Placeholder National Show · 2023'],
  ['Best Female', 'Placeholder Autumn Show · 2023'],
  ['Best Male', 'Placeholder Spring Show · 2023'],
  ['Best Kitten', 'Placeholder Winter Show · 2022'],
  ['Premier Champion', 'Placeholder National Show · 2022'],
  ['Supreme Adult', 'Placeholder Cat Club · 2022'],
  ['Best Opposite Sex', 'Placeholder Spring Show · 2021'],
  ["Judge's Choice", 'Placeholder Show Record · 2021'],
].map(([title, meta], i) => ({ img: pool[(i * 3 + 1) % pool.length], alt: title, title, meta, text: words }));
---

<Layout title="Awards — Luxury Rosettes">
  <NavPill />
  <AwardsSpiral
    top="Champions"
    bottom="by right"
    line="Every title earned in the show ring, kept as a quiet record of the line."
    photos={Array.from({ length: 9 }, (_, i) => pool[(i * 4) % pool.length])}
  />
  <AwardsList items={awards} />
  <!-- the last screen, as on the home page: the photo shrinks as the footer rises -->
  <div class="ending">
    <Closing photo={closingPhoto} eyebrow="The line continues" heading={['Meet the next', 'champion']} cta={{ label: 'Available kittens', href: '/available-kittens' }} />
    <Footer />
  </div>
</Layout>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initFooterZoom } from '../scripts/footer-zoom';

  mount(initFooterZoom, '.ending');
</script>

<style>
  .ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge (the footer is clear there) */
  .ending[data-fx] > :global(footer) {
    margin-top: -30svh;
  }
</style>
