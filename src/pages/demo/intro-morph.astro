---
import Layout from '../../layouts/Layout.astro';
import NavPill from '../../components/NavPill.astro';
import IntroMorph from '../../components/IntroMorph.astro';
import candy from '../../assets/img/cats/candy.webp';
import draco from '../../assets/img/cats/draco.webp';
import kita from '../../assets/img/cats/kita.webp';
import cosmo from '../../assets/img/cats/cosmo.webp';
import charlie from '../../assets/img/cats/charlie.webp';
import chester from '../../assets/img/cats/chester.webp';

// A demo page for IntroMorph (not linked from the site): a screen before and after it, so the pin can be seen starting and ending.
// The pattern (the background coat) is left out; pass `pattern={...}` with a photo of a rosetted coat to try it.
---

<Layout title="Demo: IntroMorph — Luxury Rosettes">
  <NavPill />
  <section class="before"><p>Scroll down ↓</p></section>
  <IntroMorph images={[kita, draco, candy, cosmo, charlie, chester]} />
  <section class="after"><p>The end of the demo</p></section>
</Layout>

<style>
  .before,
  .after {
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 1.6rem;
  }
</style>
