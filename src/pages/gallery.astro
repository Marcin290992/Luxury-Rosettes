---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import GalleryHero from '../components/GalleryHero.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/img/hero_img.webp';
import candy from '../assets/img/cats/candy.webp';
import kita from '../assets/img/cats/kita.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import chester from '../assets/img/cats/chester.webp';

// Sample page: the photos are placeholders, to be replaced with the real gallery. Landscape ones, as the layout is made for (a column of
// photos in their own proportions). `from` / `to` are the original's numbers.
const photos = [
  { src: candy, alt: 'Candy, a Bengal kitten', from: -200, to: 200, place: 'left' as const },
  { src: kita, alt: 'Kita, a Bengal queen', from: 200, to: -250, place: 'centre' as const },
  { src: cosmo, alt: 'Cosmo, a Bengal kitten', from: -200, to: 200, place: 'right' as const },
  { src: chester, alt: 'Chester, a Bengal kitten', from: 0, to: -500, place: 'inset' as const },
];
---

<Layout title="Gallery — Luxury Rosettes">
  <NavPill />
  <main>
    <GalleryHero title="Gallery" image={heroPhoto} alt="A Bengal cat" photos={photos} />
  </main>
  <!-- the last screen, as on the home page: the photo shrinks as the footer rises -->
  <div class="ending">
    <Closing />
    <Footer />
  </div>
</Layout>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initFooterZoom } from '../scripts/footer-zoom';

  mount(initFooterZoom, '.ending');
</script>

<style>
  .ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge (the footer is clear there) */
  .ending[data-fx] > :global(footer) {
    margin-top: -30svh;
  }
</style>
