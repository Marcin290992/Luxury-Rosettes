---
import Layout from '../../layouts/Layout.astro';
import NavPill from '../../components/NavPill.astro';
import LuxuryBengalGallery from '../../components/LuxuryBengalGallery.astro';
import closingPhoto from '../../assets/img/story/premium-care.webp'; // placeholder: swap for the real closing photo
import { getLuxuryBengalGalleries } from '../../data/luxurybengal';

// The gallery page: on white, a spiral of paper photos flies, and when it lands the photo grid is there (no hero, no chooser).
// Placeholder photos (see data/luxurybengal.ts). The earlier version of this page (opening + stripes + photo wall) is in git history (070d923).
const { galleries, spiral } = await getLuxuryBengalGalleries();
const gallery = { ...galleries[0], background: '#ffffff' };
import { breadcrumb } from '../../data/seo';
---

<Layout
  title="Bengal Cat & Kitten Photo Gallery — Luxury Rosettes"
  description="Photos of Bengal cats and kittens from Luxury Rosettes in High Wycombe, UK: rosettes, marbles, silvers and browns."
  schema={[breadcrumb(['Gallery', '/gallery'])]}
>
  <NavPill />
  <LuxuryBengalGallery gallery={gallery} start="grid" intro={spiral} closing={closingPhoto} />
</Layout>
