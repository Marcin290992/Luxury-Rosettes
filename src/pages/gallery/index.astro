---
import Layout from '../../layouts/Layout.astro';
import NavPill from '../../components/NavPill.astro';
import LumenGallery from '../../components/LumenGallery.astro';
import closingPhoto from '../../assets/img/story/premium-care.webp'; // placeholder: swap for the real closing photo
import { getLumenGalleries } from '../../data/lumen';

// The gallery page: on white, a spiral of paper photos flies, and when it lands the photo grid is there (no hero, no chooser).
// Placeholder photos (see data/lumen.ts). Earlier versions are in git history: the opening + stripes + photo wall (070d923), the intro
// with the chooser of two galleries (f8ae37f ... in this working tree: components/LumenIntro.astro, pages /gallery/one and /gallery/two).
const { galleries, spiral } = await getLumenGalleries();
const gallery = { ...galleries[0], background: '#ffffff' };
---

<Layout title="Gallery — Luxury Rosettes">
  <NavPill />
  <LumenGallery gallery={gallery} galleries={galleries} start="grid" intro={spiral} closing={closingPhoto} />
</Layout>
