---
import Layout from '../../layouts/Layout.astro';
import NavPill from '../../components/NavPill.astro';
import LuxuryBengalGallery from '../../components/LuxuryBengalGallery.astro';
import { getLuxuryBengalGalleries } from '../../data/luxurybengal';

// A gallery page (chosen on /gallery): a hero with the gallery's wordmark, a photo grid that comes up over it, zoom levels.
const { galleries } = await getLuxuryBengalGalleries();
const gallery = galleries.find((g) => g.id === 'one')!;
import { breadcrumb } from '../../data/seo';
---

<Layout
  title={`${gallery.name} — Bengal Gallery — Luxury Rosettes`}
  description={`${gallery.name}: a gallery of Bengal cats and kittens from Luxury Rosettes, High Wycombe, UK.`}
  schema={[breadcrumb(['Gallery', '/gallery'], [gallery.name, '/gallery/one'])]}
>
  <NavPill />
  <LuxuryBengalGallery gallery={gallery} />
</Layout>
