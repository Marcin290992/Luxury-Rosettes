---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import Preloader from '../components/Preloader.astro';
import LetterButton from '../components/LetterButton.astro';
import Stage from '../components/Stage.astro';
import ScrollExpand from '../components/ScrollExpand.astro';
import CatsRow from '../components/CatsRow.astro';
import Corridor from '../components/Corridor.astro';
import WhyBengals from '../components/WhyBengals.astro';
import Process from '../components/Process.astro';
import TileReveal from '../components/TileReveal.astro';
import RootsReveal from '../components/RootsReveal.astro';
import StripeCover from '../components/StripeCover.astro';
import kita from '../assets/img/cats/kita.webp';
import draco from '../assets/img/cats/draco.webp';
import candy from '../assets/img/cats/candy.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';
import Testimonials from '../components/Testimonials.astro';
import QuoteBand from '../components/QuoteBand.astro';
import FAQ from '../components/FAQ.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import expandImg from '../assets/img/expand.webp';
---

<Layout>
  <Preloader />
  <NavPill />
  <Stage />
  <ScrollExpand image={expandImg} alt="Bengal kittens" title="Meet our kittens" scrollHint="Scroll" scrollDistance={1} holdDistance={1.3}>
    <h2 class="expand-title">Every kitten, a story</h2>
    <p class="expand-text">Placeholder text. A calm sentence or two that appears once the photo has filled the screen.</p>
  </ScrollExpand>
  <CatsRow />
  <Corridor />
  <main class="content">
    <WhyBengals />
    <Process />
    <StripeCover pin={3.4} from={0.8}>
      <RootsReveal images={[kita, draco, candy]} />
    </StripeCover>
    <TileReveal
      id="kittens"
      images={[
        { src: kita, alt: 'Kita, a Bengal queen' },
        { src: candy, alt: 'Candy, a Bengal kitten' },
        { src: draco, alt: 'Draco, a Bengal stud' },
        { src: cosmo, alt: 'Cosmo, a Bengal kitten' },
        { src: charlie, alt: 'Charlie, a Bengal kitten' },
        { src: chester, alt: 'Chester, a Bengal kitten' },
      ]}
    >
      <Fragment slot="headline">
        <p class="kit-eyebrow">The cattery</p>
        <h2 class="kit-title">Born at home, raised with love</h2>
      </Fragment>
      <p class="kit-text">Every kitten grows up in our home among people, health-tested and TICA registered, until it is ready to meet you.</p>
      <p class="kit-actions">
        <LetterButton label="View available kittens" href="/available-kittens" solid />
        <LetterButton label="Meet the parents" href="#cats" />
      </p>
    </TileReveal>
    <QuoteBand
      image={cosmo}
      alt="Cosmo, a Bengal kitten"
      by="Julius C."
      quote="We brought our boy home last week, and he has been an absolute joy! He is incredibly friendly and handsome, and he bonded with our first cat in no time. It took them less than a week to share a bed and groom each other. Sylwia is a responsible and caring breeder. You can tell how much she loves her cats by how well they are raised. She was very helpful and informative throughout the process. Highly recommend!"
    />
    <Testimonials />
    <FAQ />
  </main>
  <!-- the last screen: the closing line fills what the footer leaves, so the end of the page is always one whole screen -->
  <div class="ending">
    <Closing />
    <Footer />
  </div>
</Layout>

<style is:global>
  /* same type as the "Meet your Bengal" finale: eyebrow, heading, text and the two pill buttons */
  #kittens .tr-content {
    justify-content: center;
  }
  /* the kittens start the moment the stripes have covered the section: this section is pulled up over the second screen of the stripe
     transition, so that its pin begins exactly when the stripes end. Its background is clear over that overlap (the stripes show
     through) and cream from there on. */
  [data-stripe-cover][data-live] ~ #kittens[data-live] {
    position: relative;
    z-index: 7;
    margin-top: -100svh;
    background: linear-gradient(to bottom, transparent 100svh, var(--cream) 100svh);
  }
  #kittens .kit-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  #kittens .kit-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 3.5rem);
    line-height: 1.02;
  }
  #kittens .tr-reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #kittens .kit-text {
    max-width: 34rem;
    margin: 0 0 2rem;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  #kittens .kit-actions {
    --fg: var(--ink-warm);
    --inv: var(--cream);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mount } from '../scripts/lifecycle';
  import { initFooterZoom } from '../scripts/footer-zoom';

  gsap.registerPlugin(ScrollTrigger);

  mount(initFooterZoom, '.ending');

  // Content slides up and fades in as it scrolls into view
  mount(() => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.from(el, {
          y: 48,
          opacity: 0,
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none reverse' },
        });
      });
      // dashed rules draw themselves in from the left
      gsap.utils.toArray<HTMLElement>('[data-dash]').forEach((el) => {
        gsap.fromTo(
          el,
          { clipPath: 'inset(0% 100% 0% 0%)' },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            duration: 1.4,
            ease: 'power3.inOut',
            scrollTrigger: { trigger: el, start: 'top 92%', toggleActions: 'play none none reverse' },
          },
        );
      });
    });
    return () => mm.revert();
  });
</script>

<style>
  .expand-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }
  .expand-text {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    margin: 0;
  }
  .ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge (the footer is clear there) */
  .ending[data-fx] > :global(footer) {
    margin-top: -30svh;
  }
  /* The rest of the page is a sheet of paper that slides up over the corridor's finale (which stays put, see Corridor). */
  .content {
    position: relative;
    z-index: 5; /* above the corridor (4) */
    background: var(--paper);
    font-family: var(--font-heading);
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.25);
  }
</style>
