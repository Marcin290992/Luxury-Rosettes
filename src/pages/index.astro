---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import Preloader from '../components/Preloader.astro';
import LetterButton from '../components/LetterButton.astro';
import Stage from '../components/Stage.astro';
import ScrollExpand from '../components/ScrollExpand.astro';
import CatsRow from '../components/CatsRow.astro';
import Corridor from '../components/Corridor.astro';
import WhyBengals from '../components/WhyBengals.astro';
import Process from '../components/Process.astro';
import TileReveal from '../components/TileReveal.astro';
import RootsReveal from '../components/RootsReveal.astro';
import StripeCover from '../components/StripeCover.astro';
import kita from '../assets/img/cats/kita.webp';
import draco from '../assets/img/cats/draco.webp';
import candy from '../assets/img/cats/candy.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';
import Testimonials from '../components/Testimonials.astro';
import QuoteBand from '../components/QuoteBand.astro';
import FAQ from '../components/FAQ.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import expandImg from '../assets/img/New kittens.jpg';
import { faqSchema } from '../data/seo';
---

<Layout
  title="Luxury Rosettes — TICA Registered Bengal Kittens in High Wycombe, UK"
  description="TICA registered Bengal cattery in High Wycombe, UK. Champion bloodline, health-tested Bengal kittens born at home and raised with love. Enquire about available kittens."
  schema={[faqSchema]}
>
  <Preloader />
  <NavPill />
  <Stage />
  <ScrollExpand image={expandImg} alt="Two Bengal kittens on a windowsill" focal="50% 19%" focalMobile="38% 50%" mediaZoom={1.2} overlayScrim={0.1} scrollDistance={1} holdDistance={1.3}>
    <div class="expand-copy">
      <h2 class="se-headline">Meet our <em>cats</em></h2>
      <p class="expand-fact"><span class="expand-fact-label">Did you know?</span>The Bengal is named after its wild ancestor, the Asian leopard cat<span class="expand-latin">, whose Latin name is <i>Prionailurus bengalensis</i></span>.</p>
    </div>
  </ScrollExpand>
  <CatsRow />
  <Corridor />
  <main class="content">
    <WhyBengals />
    <Process />
    <StripeCover pin={3.4} from={0.8}>
      <RootsReveal images={[kita, draco, candy]} />
    </StripeCover>
    <TileReveal
      id="kittens"
      images={[
        { src: kita, alt: 'Kita, a Bengal queen' },
        { src: candy, alt: 'Candy, a Bengal kitten' },
        { src: draco, alt: 'Draco, a Bengal stud' },
        { src: cosmo, alt: 'Cosmo, a Bengal kitten' },
        { src: charlie, alt: 'Charlie, a Bengal kitten' },
        { src: chester, alt: 'Chester, a Bengal kitten' },
      ]}
    >
      <Fragment slot="headline">
        <p class="kit-eyebrow">The cattery</p>
        <h2 class="kit-title">Born at home, raised with love</h2>
      </Fragment>
      <p class="kit-text">Each kitten stays with us until it is ready, already used to people, to voices and to the rhythm of family life.</p>
      <p class="kit-actions">
        <LetterButton label="Available kittens" href="/available-kittens" solid />
      </p>
    </TileReveal>
    <QuoteBand
      image={cosmo}
      alt="Cosmo, a Bengal kitten"
      by="Julius C."
      quote="We brought our boy home last week, and he has been an absolute joy! He is incredibly friendly and handsome, and he bonded with our first cat in no time. It took them less than a week to share a bed and groom each other. Sylwia is a responsible and caring breeder. You can tell how much she loves her cats by how well they are raised. She was very helpful and informative throughout the process. Highly recommend!"
    />
    <Testimonials />
    <FAQ />
  </main>
  <!-- the last screen: the closing line fills what the footer leaves, so the end of the page is always one whole screen -->
  <div class="ending">
    <Closing />
    <Footer />
  </div>
</Layout>

<style is:global>
  /* same type as the "Meet your Bengal" finale: eyebrow, heading, text and the two pill buttons */
  #kittens .tr-content {
    justify-content: center;
  }
  /* the kittens start the moment the stripes have covered the section: this section is pulled up over the second screen of the stripe
     transition, so that its pin begins exactly when the stripes end. Its background is clear over that overlap (the stripes show
     through) and cream from there on. */
  [data-stripe-cover][data-live] ~ #kittens[data-live] {
    position: relative;
    z-index: 7;
    margin-top: -100svh;
    background: linear-gradient(to bottom, transparent 100svh, var(--cream) 100svh);
  }
  #kittens .kit-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  #kittens .kit-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 3.5rem);
    line-height: 1.02;
  }
  #kittens .tr-reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #kittens .kit-text {
    max-width: 34rem;
    margin: 0 0 2rem;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  #kittens .kit-actions {
    --fg: var(--ink-warm);
    --inv: var(--cream);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mount } from '../scripts/lifecycle';
  import { initFooterZoom } from '../scripts/footer-zoom';

  gsap.registerPlugin(ScrollTrigger);

  mount(initFooterZoom, '.ending');

  // Content slides up and fades in as it scrolls into view
  mount(() => {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.from(el, {
          y: 48,
          opacity: 0,
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none reverse' },
        });
      });
      // dashed rules draw themselves in from the left
      gsap.utils.toArray<HTMLElement>('[data-dash]').forEach((el) => {
        gsap.fromTo(
          el,
          { clipPath: 'inset(0% 100% 0% 0%)' },
          {
            clipPath: 'inset(0% 0% 0% 0%)',
            duration: 1.4,
            ease: 'power3.inOut',
            scrollTrigger: { trigger: el, start: 'top 92%', toggleActions: 'play none none reverse' },
          },
        );
      });
    });
    return () => mm.revert();
  });
</script>

<style>
  /* a low, wide glass card at the bottom edge with the heading and the curiosity: the cats above it stay clear.
     The overlay is taller than the screen (its padding is added to the 100svh), so the card is anchored from the overlay's top, to the height of the screen. */
  .expand-copy {
    position: absolute;
    left: 50%;
    top: calc(100vh - clamp(1rem, 3.5vh, 2rem));
    top: calc(100svh - clamp(1rem, 3.5vh, 2rem));
    transform: translate(-50%, -100%);
    width: min(62rem, calc(100% - 3rem));
    padding: 1rem 1.75rem;
    box-sizing: border-box;
    /* a low bar: the heading on the left, the curiosity on the right */
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.75rem;
    text-align: left;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 18px;
    background: rgba(13, 11, 9, 0.5);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  h2.se-headline {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    margin: 0;
    white-space: nowrap;
    text-shadow: none;
  }
  .expand-fact {
    margin: 0;
    padding-left: 1.75rem;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    font-family: var(--font-body);
    font-size: clamp(0.82rem, 0.95vw, 0.92rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }
  .expand-fact-label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  /* phones and narrow windows: the heading above the curiosity */
  @media (max-width: 760px) {
    .expand-copy {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 0.9rem 1.25rem 1.05rem;
      text-align: center;
      background: rgba(13, 11, 9, 0.66); /* a little denser, so the cat's tail behind the heading is only a shadow */
    }
    h2.se-headline {
      font-size: clamp(1.7rem, 7vw, 2.1rem);
    }
    .expand-fact {
      padding: 0.6rem 0 0;
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
      font-size: 0.78rem;
      line-height: 1.45;
    }
    /* the Latin name is left out on a phone: two lines of text, not three, so the card stays low */
    .expand-latin {
      display: none;
    }
    .expand-fact-label {
      margin-bottom: 0.15rem;
    }
  }
  h2.se-headline em {
    font-style: italic;
    color: #f0d9a0;
  }
  .ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge (the footer is clear there) */
  .ending[data-fx] > :global(footer) {
    margin-top: -30svh;
  }
  /* The rest of the page is a sheet of paper that slides up over the corridor's finale (which stays put, see Corridor). */
  .content {
    position: relative;
    z-index: 5; /* above the corridor (4) */
    background: var(--paper);
    font-family: var(--font-heading);
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.25);
  }
</style>
