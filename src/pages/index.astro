---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import CursorTrail from '../components/CursorTrail.astro';
import Stage from '../components/Stage.astro';
import ScrollExpand from '../components/ScrollExpand.astro';
import CatsRow from '../components/CatsRow.astro';
import Corridor from '../components/Corridor.astro';
import WhyBengals from '../components/WhyBengals.astro';
import Process from '../components/Process.astro';
import TileReveal from '../components/TileReveal.astro';
import kita from '../assets/img/cats/kita.webp';
import draco from '../assets/img/cats/draco.webp';
import candy from '../assets/img/cats/candy.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import charlie from '../assets/img/cats/charlie.webp';
import chester from '../assets/img/cats/chester.webp';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import expandImg from '../assets/img/expand.webp';
---

<Layout>
  <NavPill />
  <CursorTrail />
  <Stage />
  <ScrollExpand image={expandImg} alt="Bengal kittens" title="Meet our kittens" scrollHint="Scroll" scrollDistance={1} holdDistance={1.3}>
    <h2 class="expand-title">Every kitten, a story</h2>
    <p class="expand-text">Placeholder text. A calm sentence or two that appears once the photo has filled the screen.</p>
  </ScrollExpand>
  <CatsRow />
  <Corridor />
  <main class="content">
    <WhyBengals />
    <Process />
    <TileReveal
      id="kittens"
      images={[
        { src: kita, alt: 'Kita, a Bengal queen' },
        { src: candy, alt: 'Candy, a Bengal kitten' },
        { src: draco, alt: 'Draco, a Bengal stud' },
        { src: cosmo, alt: 'Cosmo, a Bengal kitten' },
        { src: charlie, alt: 'Charlie, a Bengal kitten' },
        { src: chester, alt: 'Chester, a Bengal kitten' },
      ]}
    >
      <Fragment slot="headline">
        <p class="kit-eyebrow">The cattery</p>
        <h2 class="kit-title">Born at home, <em>raised</em> with love</h2>
      </Fragment>
      <p class="kit-text">Every kitten grows up in our home among people, health-tested and TICA registered, until it is ready to meet you.</p>
      <p class="kit-actions">
        <a class="kit-pill" href="/available-kittens">View available kittens</a>
        <a class="kit-link" href="#cats">Meet the parents</a>
      </p>
    </TileReveal>
    <Testimonials />
    <FAQ />
  </main>
  <!-- the last screen: the closing line fills what the footer leaves, so the end of the page is always one whole screen -->
  <div class="ending">
    <Closing />
    <Footer />
  </div>
</Layout>

<style is:global>
  /* the headline and text sit at the bottom of the stage, below where the photos fly in */
  #kittens .tr-content {
    justify-content: flex-end;
    padding-bottom: clamp(3rem, 10vh, 6rem);
  }
  #kittens .kit-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }
  #kittens .kit-eyebrow::before,
  #kittens .kit-eyebrow::after {
    content: '';
    width: 2.5rem;
    border-top: 1px solid var(--gold);
  }
  #kittens .kit-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  #kittens .kit-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }
  #kittens .tr-reveal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }
  #kittens .kit-text {
    max-width: 30rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    opacity: 0.75;
  }
  #kittens .kit-actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }
  #kittens .kit-pill {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-warm);
    background: var(--gold);
    text-decoration: none;
    border: 1px solid var(--gold);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    transition: background 0.4s, color 0.4s;
  }
  #kittens .kit-pill:hover {
    background: transparent;
    color: var(--gold);
  }
  #kittens .kit-link {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(239, 233, 220, 0.4);
    padding-bottom: 0.4rem;
    transition: color 0.4s, border-color 0.4s;
  }
  #kittens .kit-link:hover {
    color: var(--gold);
    border-color: var(--gold);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Content slides up and fades in as it scrolls into view
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.from(el, {
        y: 48,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none reverse' },
      });
    });
    // dashed rules draw themselves in from the left
    gsap.utils.toArray<HTMLElement>('[data-dash]').forEach((el) => {
      gsap.fromTo(
        el,
        { clipPath: 'inset(0% 100% 0% 0%)' },
        {
          clipPath: 'inset(0% 0% 0% 0%)',
          duration: 1.4,
          ease: 'power3.inOut',
          scrollTrigger: { trigger: el, start: 'top 92%', toggleActions: 'play none none reverse' },
        },
      );
    });
  });
</script>

<style>
  .expand-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }
  .expand-text {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    margin: 0;
  }
  .ending {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }
  .ending > :global(.end) {
    flex: 1;
  }
  /* The rest of the page is a sheet of paper that slides up over the corridor's finale (which stays put, see Corridor). */
  .content {
    position: relative;
    z-index: 5; /* above the corridor (4) */
    background: var(--paper);
    font-family: var(--font-heading);
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.25);
  }
</style>
