---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import ShrinkIntro from '../components/ShrinkIntro.astro';
import CatStack from '../components/CatStack.astro';
import WeekByWeek from '../components/WeekByWeek.astro';
import PhotoGrow from '../components/PhotoGrow.astro';
import kittens from '../assets/img/kittens.webp';
import candy from '../assets/img/cats/candy.webp';
import chester from '../assets/img/cats/chester.webp';
import charlie from '../assets/img/cats/charlie.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import draco from '../assets/img/cats/draco.webp';
import kita from '../assets/img/cats/kita.webp';

// The two main cats of the cattery. PLACEHOLDERS: the photo of Hera is not here yet (Kita's stands in), and the texts are sample ones.
const cards = [
  { name: 'Draco', role: 'Stud', line: 'Placeholder text. A few calm words about Draco: his temperament, his line and what he gives his kittens.', image: draco },
  { name: 'Hera', role: 'Queen', line: 'Placeholder text. A few calm words about Hera: her coat, her character and her place in the line.', image: kita },
];

// A kitten's first weeks, up to the day it goes home. PLACEHOLDERS: the texts are sample ones (only "12 to 14 weeks, fully vaccinated" is from the
// site's own FAQ) and the photos are others already on the site: the breeder fills in the real stages and photos.
const weeks = [
  { title: 'Born at home', text: 'Placeholder text. The kittens are born in our home and stay close to their mother, handled gently from the first days.', image: kittens },
  { title: 'First steps', text: 'Placeholder text. Eyes and ears open, the first wobbly steps and the first games with the litter.', image: candy },
  { title: 'Growing up with people', text: 'Placeholder text. Everyday life of the house: voices, visitors, soft toys, the first solid food.', image: chester },
  { title: 'Health checks', text: 'Placeholder text. A visit to the vet, vaccinations and a microchip, all written down.', image: charlie },
  { title: 'Ready to meet you', text: 'Ready at 12 to 14 weeks, fully vaccinated, with a written health guarantee.', image: cosmo },
];
---

<Layout title="Our Cats — Luxury Rosettes">
  <NavPill />
  <ShrinkIntro
    headline="The family behind the line"
    collection="Queens, studs and kittens, gathered into one calm family."
  />
  <CatStack cards={cards} pull="-160svh" lead="60svh" />
  <WeekByWeek head={['Week by week,', 'to your home']} noteTitle="A Note About Growing Up" note="Placeholder text. Every kitten grows at its own pace, so the weeks here are a guide, not a promise." items={weeks} />
  <PhotoGrow images={[draco, kittens, kita]} alts={['Draco', 'Bengal kittens', 'Hera']} headline="Meet the kittens" cta={{ label: 'Available kittens', href: '/available-kittens' }} />
</Layout>
