---
import Layout from '../layouts/Layout.astro';
import NavPill from '../components/NavPill.astro';
import ShrinkIntro from '../components/ShrinkIntro.astro';
import CatStack from '../components/CatStack.astro';
import SplitStory from '../components/SplitStory.astro';
import WeekByWeek from '../components/WeekByWeek.astro';
import Footer from '../components/Footer.astro';
import PhotoGrow from '../components/PhotoGrow.astro';
import kittens from '../assets/img/kittens.webp';
import candy from '../assets/img/cats/candy.webp';
import chester from '../assets/img/cats/chester.webp';
import charlie from '../assets/img/cats/charlie.webp';
import cosmo from '../assets/img/cats/cosmo.webp';
import draco from '../assets/img/cats/draco.webp';
import kita from '../assets/img/cats/kita.webp';

// The texts of the cats are the breeder's own, from the old site (Our Cats). The second photo of each cat is not here yet: the first one is used twice.
const cards = [
  { name: 'Kita', role: 'Queen', line: 'Our stunning golden queen, radiating elegance, intelligence and gentle charm.', image: kita },
  { name: 'Kita', role: 'Queen', line: 'A true queen in every sense: graceful, kind and absolutely captivating.', image: kita },
];

const dracoCards = [
  { name: 'Draco', role: 'King', line: 'An outstanding silver Bengal with a breathtaking, high-contrast pattern and a strong wild expression.', image: draco },
  { name: 'Draco', role: 'King', line: 'A true example of the Bengal breed: elegant, athletic, intelligent and affectionate.', image: draco },
];

// The closing stack: Kita and Draco, four cards.
const familyCards = [
  { name: 'Kita', role: 'Queen', line: 'Calm, loving and deeply bonded with her humans, she brings harmony and warmth to our home.', image: kita },
  { name: 'Draco', role: 'King', line: 'Confident and affectionate, he loves attention and shows off his elegance with gentle power.', image: draco },
  { name: 'Kita', role: 'Queen', line: 'An exceptional mother: nurturing, patient and attentive, teaching her kittens confidence and gentle manners.', image: kita },
  { name: 'Draco', role: 'King', line: 'From excellent Champion bloodlines, proven in the show ring, with all health tests clear.', image: draco },
];

// A kitten's first weeks, up to the day it goes home. PLACEHOLDERS: the texts are sample ones (only "12 to 14 weeks, fully vaccinated" is from the
// site's own FAQ) and the photos are others already on the site: the breeder fills in the real stages and photos.
const weeks = [
  { title: 'Born at home', text: 'Placeholder text. The kittens are born in our home and stay close to their mother, handled gently from the first days.', image: kittens },
  { title: 'First steps', text: 'Placeholder text. Eyes and ears open, the first wobbly steps and the first games with the litter.', image: candy },
  { title: 'Growing up with people', text: 'Placeholder text. Everyday life of the house: voices, visitors, soft toys, the first solid food.', image: chester },
  { title: 'Health checks', text: 'Placeholder text. A visit to the vet, vaccinations and a microchip, all written down.', image: charlie },
  { title: 'Ready to meet you', text: 'Ready at 12 to 14 weeks, fully vaccinated, with a written health guarantee.', image: cosmo },
];
import { breadcrumb } from '../data/seo';
---

<Layout
  title="Our Bengal Cats — Luxury Rosettes"
  description="Meet the queens and stud cats of Luxury Rosettes: TICA registered Bengals with champion pedigrees, health-tested and part of our family."
  schema={[breadcrumb(['Our cats', '/our-cats'])]}
>
  <NavPill />
  <ShrinkIntro
    headline="The family behind<br>the line"
    collection="Queens, studs and kittens, gathered into one calm family."
  />
  <CatStack cards={cards} pull="-160svh" lead="60svh" />
  <SplitStory
    heading="Meet Kita"
    paragraphs={[
      'Kita is our stunning golden queen. Her warm, golden coat with rich, beautifully contrasted rosettes and a silky, glittered texture makes her truly eye-catching. She has a refined wild expression balanced with a soft, affectionate nature, giving her both beauty and soul.',
      'Kita comes from carefully selected lines known for health, temperament and excellent type. Her kittens inherit her stunning looks, sweet disposition and balanced temperament, making them wonderful companions and show quality prospects.',
    ]}
    images={[kita, kita, kittens]}
    alts={['Kita', 'Kita', 'Kita’s kittens']}
  />
  <CatStack cards={dracoCards} />
  <SplitStory
    heading="Meet Draco"
    paragraphs={[
      'Draco is an outstanding silver Bengal male with a breathtaking, high-contrast pattern and strong wild expression. His muscular body, sleek coat and intense eyes give him a majestic presence: he looks like a miniature leopard in the home. His rosettes are bold and perfectly defined, showcasing exceptional breed quality.',
      'Draco comes from excellent Champion bloodlines and has proven himself in the show ring. He consistently passes on his striking features, structure and confident, social temperament to his kittens. All health tests are clear, ensuring that he produces healthy, strong and stunning offspring.',
    ]}
    images={[draco, draco, charlie]}
    alts={['Draco', 'Draco', 'Draco']}
  />
  <WeekByWeek head={['Week by week,', 'to your home']} noteTitle="A Note About Growing Up" note="Placeholder text. Every kitten grows at its own pace, so the weeks here are a guide, not a promise." items={weeks} />
  <CatStack cards={familyCards} />
  <!-- the last screen: the grown photo shrinks as the footer rises, then the footer (the effect of the home page's closing photo) -->
  <div class="ending">
  <PhotoGrow ending images={[draco, kittens, kita]} alts={['Draco', 'Bengal kittens', 'Kita']} headline="Meet the kittens" cta={{ label: 'Available kittens', href: '/available-kittens' }} />
    <Footer />
  </div>
</Layout>

<style>
  .ending {
    position: relative;
    z-index: 5;
    background: #0d0b09;
  }
  /* with the effect on, the footer's top part overlaps the photo's lower edge (the footer is clear there) */
  .ending[data-fx] > :global(footer) {
    margin-top: -30svh;
  }
</style>

<script>
  import { mount } from '../scripts/lifecycle';
  import { initFooterZoom } from '../scripts/footer-zoom';

  mount(initFooterZoom, '.ending');
</script>
